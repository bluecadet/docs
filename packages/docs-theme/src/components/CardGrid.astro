---
/**
 * A responsive grid for laying out cards (e.g. `PackageCard`) on a splash page.
 *
 * @example
 * ```mdx
 * import CardGrid from "@bluecadet/docs-theme/components/CardGrid.astro";
 * import PackageCard from "@bluecadet/docs-theme/components/PackageCard.astro";
 *
 * <CardGrid minColumnWidth="16rem">
 *   <PackageCard title="..." href="..." version="1.2.0" />
 * </CardGrid>
 * ```
 */
interface Props {
	/** Minimum width of a column before wrapping to a new row. Defaults to `"16rem"`. */
	minColumnWidth?: string;
}

const { minColumnWidth = "16rem" } = Astro.props;
---

<div class="docs-theme-card-grid" style={`--docs-theme-card-min-width: ${minColumnWidth}`}>
	<slot />
</div>

<style>
	.docs-theme-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--docs-theme-card-min-width)), 1fr));
		gap: 1rem;
		margin: 1.5rem 0;
	}
</style>
