{
  "name": "@bluecadet/docs-theme",
  "version": "0.0.1",
  "description": "Starlight plugin bundling bluecadet's \"Paper\" design tokens, fonts, component overrides, and landing-page components",
  "type": "module",
  "engines": {
    "node": ">=23"
  },
  "files": [
    "src/**/*.astro",
    "src/**/*.css",
    "src/**/*.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./styles/*": "./src/styles/*",
    "./overrides/*": "./src/overrides/*",
    "./components/*": "./src/components/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluecadet/docs.git",
    "directory": "packages/docs-theme"
  },
  "author": {
    "name": "Bluecadet",
    "url": "https://bluecadet.com"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bluecadet/docs/issues"
  },
  "homepage": "https://github.com/bluecadet/docs#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.41.7"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.1.6",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
