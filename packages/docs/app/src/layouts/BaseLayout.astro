---
// Doc-page chrome: header / sidebar / main / TOC / footer grid. Prose styling inside
// <slot /> (the rendered article) belongs to another pass — this layout only places the grid.
import "../styles/index.css";
import Header from "../components/Header.astro";
import SearchModal from "../components/SearchModal.astro";
import SidebarNav from "../components/SidebarNav.astro";
import Toc from "../components/Toc.astro";
import Footer from "../components/Footer.astro";

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	description?: string;
	headings?: Heading[];
	currentId?: string;
}

const { title, description, headings = [], currentId } = Astro.props;
const siteTitle = process.env.DOCS_TITLE ?? "docs";
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const base = import.meta.env.BASE_URL;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
	</head>
	<body>
		<div class="page">
			<Header />
			<div class="page-body">
				<SidebarNav currentId={currentId} headings={headings} />
				<main class="page-main">
					<div class="page-main-content">
						<slot />
					</div>
					<Toc headings={headings} />
				</main>
			</div>
			<Footer />
		</div>
		<SearchModal />
	</body>
</html>

<style>
	.page {
		/* Left rail width, shared by header/sidebar/footer so their columns stay aligned.
		   250px desktop, 300px at 1920 (see breakpoint below). */
		--rail-width: 250px;
		display: grid;
		grid-template-rows: auto 1fr auto;
		min-height: 100vh;
	}

	.page-body {
		display: grid;
		grid-template-columns: var(--rail-width) 1fr;
		min-width: 0;
	}

	.page-main {
		display: grid;
		grid-template-columns: 1fr 220px;
		min-width: 0;
	}

	.page-main-content {
		min-width: 0;
		padding: 32px 52px 52px;
	}

	/* Mobile/tablet: below ~1024px, drop the sidebar/TOC columns entirely. A later pass owns
	   real mobile nav (hamburger sheet, breadcrumb-pill trigger, <details> TOC); this is a
	   placeholder so content doesn't visually break in the meantime. */
	@media (max-width: 1023px) {
		.page-body {
			grid-template-columns: 1fr;
		}

		.page-main {
			grid-template-columns: 1fr;
		}

		.page-main-content {
			padding: 24px 20px 40px;
		}

		.page-body :global(.sidebar-nav),
		.page-main :global(.toc-aside) {
			display: none;
		}
	}

	@media (min-width: 1920px) {
		.page {
			--rail-width: 300px;
		}

		.page-main {
			grid-template-columns: minmax(0, 760px) 300px;
			gap: 64px;
			justify-content: center;
			padding: 40px 0 64px;
		}

		.page-main-content {
			padding: 0;
		}
	}
</style>
