---
// The one page shell — used by every route (doc pages, landing, 404) so the header/rail/footer
// columns are derived from the same custom properties everywhere and can't drift.
//
// Structure: a `min-height: 100dvh` grid of `auto 1fr auto` rows, so the body row always grows to
// fill a short page (no dead space under the footer) and the sidebar's hairline runs to the bottom.
// `--rail-width` is declared here, once, and consumed by Header/Footer/SidebarNav/Toc and by the
// landing's own header/footer variants. `--header-height` and `--content-pad-x` live at :root
// (global.css) instead, since NavSheet.astro and SearchModal.astro need them too but mount outside
// `.page`.
//
// Pages that need a different header/footer (landing, 404) pass them through the named slots;
// doc pages get the defaults.
import "../styles/index.css";
import Header from "../components/Header.astro";
import NavSheet from "../components/NavSheet.astro";
import SearchModal from "../components/SearchModal.astro";
import SidebarNav from "../components/SidebarNav.astro";
import Toc from "../components/Toc.astro";
import Footer from "../components/Footer.astro";
import { faviconType, getDocsConfig } from "../lib/config";

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	description?: string;
	/** Article headings — renders the right-hand TOC column when there are any H2s. */
	headings?: Heading[];
	/** Active nav entry id. */
	currentId?: string;
	/**
	 * `article` = doc-page main (padded content column + TOC rail).
	 * `full` = full-bleed main, for pages that own their own section padding (landing, 404).
	 */
	main?: "article" | "full";
	/** Append " — <site title>" to the document title. */
	appendSiteTitle?: boolean;
	robots?: string;
	/** Set false to omit the left nav rail entirely — the landing page's single-column layout. */
	sidebar?: boolean;
	/** Resolved `toc.editLink` URL for this page, passed through to the aside TOC's meta block. */
	editHref?: string;
	/** `og:type` — "website" for the landing page, "article" (the default) for everything else. */
	ogType?: "website" | "article";
	/** Root-relative URL of this page's Markdown copy (see ../lib/llms.ts) — doc pages only. */
	markdownHref?: string;
}

const {
	title,
	description,
	headings = [],
	currentId,
	main = "article",
	appendSiteTitle = true,
	robots,
	sidebar = true,
	editHref,
	ogType = "article",
	markdownHref,
} = Astro.props;

const docsConfig = getDocsConfig();
const siteTitle = docsConfig.title;
const pageTitle = appendSiteTitle && title ? `${title} — ${siteTitle}` : title || siteTitle;
const base = import.meta.env.BASE_URL;

// Per-site override of the two source accent tokens (see app/src/styles/tokens.css) — every other
// color in the design system is color-mix()-derived from these two, so setting just these here
// re-skins the whole site. `:root:root` (doubled pseudo-class) outranks tokens.css's plain `:root`
// on specificity alone, so this wins regardless of stylesheet load order instead of depending on
// appearing later in the document.
const accentOverrides = [
	docsConfig.accent && `--accent:${docsConfig.accent};`,
	docsConfig.accent2 && `--accent-2:${docsConfig.accent2};`,
]
	.filter(Boolean)
	.join("");
const accentOverrideCss = accentOverrides ? `:root:root{${accentOverrides}}` : "";

// Canonical/OG tags need an absolute origin (`site`) to build a full URL from, and are skipped for
// noindex pages (404, the no-landing redirect) — there is nothing worth a search engine or social
// scraper following those. `Astro.url.pathname` already includes `base` in a static build (verified
// empirically), so resolving it against `Astro.site` — rather than string-concatenating the two —
// is what avoids a double slash when `site` itself carries a trailing slash.
const isNoindex = robots?.includes("noindex") ?? false;
const canonicalUrl =
	Astro.site && !isNoindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// Same URL scheme as llms.txt: absolute when `site` is set, root-relative otherwise.
const markdownUrl = markdownHref && Astro.site ? new URL(markdownHref, Astro.site).href : markdownHref;

// Only reserve the TOC column when there is actually something to put in it.
const hasToc = main === "article" && headings.some((heading) => heading.depth === 2);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		{robots && <meta name="robots" content={robots} />}
		{docsConfig.favicon && (
			<link
				rel="icon"
				href={`${base}${docsConfig.favicon}`}
				type={faviconType(docsConfig.favicon)}
			/>
		)}
		{markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
		{accentOverrideCss && <style set:html={accentOverrideCss} />}
		{canonicalUrl && (
			<>
				<link rel="canonical" href={canonicalUrl} />
				<meta property="og:title" content={title} />
				{description && <meta property="og:description" content={description} />}
				<meta property="og:url" content={canonicalUrl} />
				<meta property="og:site_name" content={siteTitle} />
				<meta property="og:type" content={ogType} />
				<meta name="twitter:card" content="summary" />
			</>
		)}
	</head>
	<body>
		<div class="page" class:list={{ "page--no-sidebar": !sidebar }}>
			<slot name="header"><Header /></slot>
			<div class="page-body">
				{sidebar && <SidebarNav currentId={currentId} />}
				<main
					class="page-main"
					class:list={{ "page-main--full": main === "full", "page-main--toc": hasToc }}
				>
					<div class="page-main-content">
						<slot />
					</div>
					{hasToc && <Toc variant="aside" headings={headings} editHref={editHref} />}
				</main>
			</div>
			<slot name="footer"><Footer /></slot>
		</div>
		<NavSheet currentId={currentId} />
		<SearchModal />
	</body>
</html>

<style>
	.page {
		/* Left rail width, shared by header/sidebar/footer so their columns stay aligned on every
		   route. (--header-height lives at :root — see global.css.) */
		--rail-width: 18.75rem; /* 300px */
		--toc-width: 17rem; /* 272px */
		/* Shared cap: header, body and footer each center an inner row to this width with matching
		   border-inline hairlines, so the two rules read as one continuous edge running from the top
		   of the header to the bottom of the footer. */
		--shell-width: 95rem; /* 1520px */
		/* Shared top gutter — every band that abuts the shell's outer edge pads from this so its
		   top-aligned labels line up without each component re-declaring the number. (The matching
		   horizontal gutter, --content-pad-x, lives at :root — see global.css — for the same reason
		   as --header-height above.) */
		--content-pad-top: 2.75rem; /* 44px */
		/* Header/footer read these instead of a hard-coded `grid`/border so both variants can drop
		   the rail column and its divider in `.page--no-sidebar` below without duplicating the swap
		   in HeaderShell/Wordmark/Footer directly. */
		--rail-display: grid;
		--rail-divider: 1px solid var(--hairline-08);
		--brand-pad-start: 2.25rem; /* 36px */
		--brand-pad-end: 2.25rem; /* 36px */
		--nav-pad-start: var(--content-pad-x);
		display: grid;
		grid-template-rows: auto 1fr auto;
		/* dvh keeps mobile browsers' collapsing toolbars from over-sizing the shell; the vh line
		   above it is the fallback for engines without dvh. */
		min-block-size: 100vh;
		min-block-size: 100dvh;
	}

	/* Sidebar-less pages (`sidebar={false}` — currently just the landing page): header and footer
	   have no rail below them to align with, so the two-column grid (and its rail-width track and
	   divider) gives way to a plain flex row — wordmark, then the nav/link cell flexed to fill the
	   rest — with the wordmark aligned to the content gutter instead of the rail's fixed padding.
	   Doc pages never carry this class, so they're untouched. */
	.page--no-sidebar {
		--rail-display: flex;
		--rail-divider: none;
		--brand-pad-start: var(--content-pad-x);
		--brand-pad-end: 2.5rem; /* 40px */
		--nav-pad-start: 0px;
		/* Desktop-only (consumers gate this behind their own `min-width: 1024px` query): with no
		   rail column, the search/nav cell needs `flex: 1` to fill the row instead of the tablet
		   breakpoint's `margin-inline-start: auto` trick, which only pushes a content-sized box right. */
		--nav-flex: 1;
	}

	.page-body {
		display: grid;
		grid-template-columns: var(--rail-width) 1fr;
		inline-size: min(100%, var(--shell-width));
		min-inline-size: 0;
		margin-inline: auto;
		border-inline: 1px solid var(--hairline-08);
	}

	/* SidebarNav renders nothing — either because `sidebar={false}` (currently just the landing
	   page) or because SidebarNav.astro found no nav-worthy pages at all (an edge case for a
	   consumer with too few docs, not specific to any one page) — so collapse the now-empty rail
	   column instead of reserving width for it. One rule covers both cases. */
	.page-body:not(:has(.sidebar-rail)) { grid-template-columns: 1fr; }

	.page-main {
		display: grid;
		grid-template-columns: 1fr;
		min-inline-size: 0;
	}

	/* Two-column grid only at the widths that can actually afford the rail — below that the TOC
	   aside is display:none (Toc.astro) in favor of the inline disclosure, so the empty column
	   must not reserve width or the content squeezes for nothing. */
	@media (min-width: 1280px) {
		.page-main--toc {
			grid-template-columns: 1fr var(--toc-width);
		}
	}

	.page-main--full {
		display: block;
	}

	.page-main-content {
		min-inline-size: 0;
		padding: var(--content-pad-top) var(--content-pad-x) 6rem; /* 96px */
	}

	.page-main--full .page-main-content {
		max-inline-size: none;
		padding: 0;
	}

	/* Tablet: rail narrows to 212px (SidebarNav stays visible); the TOC column drops in favor of
	   the inline <details> disclosure the doc page renders inside its own content column. */
	@media (max-width: 1023px) {
		.page {
			--rail-width: 13.25rem; /* 212px */
			--content-pad-top: 1.75rem; /* 28px */
		}

		.page-main-content {
			padding: var(--content-pad-top) var(--content-pad-x) 2.75rem; /* 44px */
		}
	}

	/* Mobile: no persistent sidebar at all — SidebarNav hides itself; the hamburger's NavSheet and
	   the breadcrumb pill (Breadcrumb.astro) take over wayfinding. */
	@media (max-width: 767px) {
		.page {
			--content-pad-top: 1.625rem; /* 26px */
		}

		.page-body {
			grid-template-columns: 1fr;
		}

		.page-main-content {
			padding: var(--content-pad-top) var(--content-pad-x) 2.5rem; /* 40px */
		}
	}
</style>
