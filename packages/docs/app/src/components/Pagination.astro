---
// Prev/next pagination, ordered by the nav tree's depth-first pre-order page list (see
// ../lib/nav.ts) — i.e. exactly the order the sidebar reads top to bottom, child pages included.
import { getNavTree } from "../lib/nav";

interface Props {
	currentId: string;
}

const { currentId } = Astro.props;
const { flat } = await getNavTree();
const index = flat.findIndex((item) => item.id === currentId);
const prev = index > 0 ? flat[index - 1] : null;
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : null;
---

{
	(prev || next) && (
		<nav class="pagination type-md" aria-label="Pagination">
			{prev ? (
				<a class="pagination__link pagination__link--prev link-muted" href={prev.href}>
					← {prev.label}
				</a>
			) : (
				<span />
			)}
			{next && (
				<a class="pagination__link pagination__link--next link-muted" href={next.href}>
					{next.label} →
				</a>
			)}
		</nav>
	)
}

<style>
	.pagination {
		display: flex;
		justify-content: space-between;
		gap: 1.25rem;
		margin-block-start: 4.5rem;
		padding-block-start: 1.5rem;
		border-block-start: 1px solid var(--hairline-08);
	}

	.pagination__link--next {
		margin-inline-start: auto;
	}

	/* Mobile: prev/next become full-width bordered buttons stacked in a column instead of a
	   plain inline row — bigger, unambiguous tap targets. */
	@media (max-width: 767px) {
		.pagination {
			flex-direction: column;
			gap: 0.625rem;
		}

		.pagination__link {
			display: flex;
			align-items: center;
			/* WCAG tap-target minimum — stays fixed CSS px, doesn't track text zoom. */
			min-block-size: 48px;
			padding: 0 0.875rem;
			border: 1px solid var(--hairline-10);
			border-radius: var(--radius-md);
		}

		.pagination__link--next {
			margin-inline-start: 0;
			justify-content: flex-end;
		}
	}
</style>
