---
// Prev/next pagination, ordered by the nav tree's depth-first pre-order page list (see
// ../lib/nav.ts) — i.e. exactly the order the sidebar reads top to bottom, child pages included.
import { getNavTree } from "../lib/nav";

interface Props {
	currentId: string;
}

const { currentId } = Astro.props;
const { flat } = await getNavTree();
const index = flat.findIndex((item) => item.id === currentId);
const prev = index > 0 ? flat[index - 1] : null;
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : null;
---

{
	(prev || next) && (
		<nav class="pagination" aria-label="Pagination">
			{prev ? (
				<a class="pagination__link pagination__link--prev" href={prev.href}>
					← {prev.label}
				</a>
			) : (
				<span />
			)}
			{next && (
				<a class="pagination__link pagination__link--next" href={next.href}>
					{next.label} →
				</a>
			)}
		</nav>
	)
}

<style>
	.pagination {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		margin-top: 72px;
		padding-top: 24px;
		border-top: 1px solid var(--hairline-08);
		font: 400 13px var(--font-mono);
	}

	.pagination__link {
		color: var(--text-muted);
		transition: color 0.15s ease;
	}

	.pagination__link:hover {
		color: var(--accent);
	}

	.pagination__link--next {
		margin-left: auto;
	}

	/* Mobile: prev/next become full-width bordered buttons stacked in a column instead of a
	   plain inline row — bigger, unambiguous tap targets. */
	@media (max-width: 767px) {
		.pagination {
			flex-direction: column;
			gap: 10px;
		}

		.pagination__link {
			display: flex;
			align-items: center;
			min-height: 48px;
			padding: 0 14px;
			border: 1px solid var(--hairline-10);
			border-radius: var(--radius-md);
		}

		.pagination__link--next {
			margin-left: 0;
			justify-content: flex-end;
		}
	}
</style>
