---
// Above-H1 breadcrumb: `docs / <segment> / … / <page>`, one segment per directory level. An
// intermediate segment links when that directory has its own index page (the CLI collapses
// `docs/guides/index.md` onto `/guides/`) and stays inert text when it doesn't.
//
// Mobile (<=767px) swaps this for a full-bleed pill button showing `<parent> / <page>` plus an
// "all pages" trigger that opens NavSheet.astro — the design's mobile doc-page header treatment.
// It's rendered here (not BaseLayout) because it needs the same trail data; CSS alone toggles
// which variant is visible per breakpoint.
import { getNavTree, trailFor } from "../lib/nav";

interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
const base = import.meta.env.BASE_URL;
const { nodes } = await getNavTree();

// Everything above the current page, outermost first.
const ancestors = trailFor(nodes, id).slice(0, -1);
const parent = ancestors.at(-1);
---

<nav class="breadcrumb" aria-label="Breadcrumb">
	<a class="breadcrumb__segment" href={base}>docs</a>
	{
		ancestors.map((node) => (
			<>
				<span class="breadcrumb__sep">/</span>
				{node.href ? (
					<a class="breadcrumb__segment" href={node.href}>
						{node.segment}
					</a>
				) : (
					<span class="breadcrumb__segment">{node.label}</span>
				)}
			</>
		))
	}
	<span class="breadcrumb__sep">/</span>
	<span class="breadcrumb__current">{title}</span>
</nav>

<button type="button" class="breadcrumb-pill" data-nav-sheet-trigger aria-haspopup="dialog">
	{parent && <span class="breadcrumb-pill__section">{parent.segment} /</span>}
	<span class="breadcrumb-pill__current">{title}</span>
	<span class="breadcrumb-pill__trigger">▾ all pages</span>
</button>

<style>
	.breadcrumb {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		font: 400 12px var(--font-mono);
		color: var(--text-dim);
		margin-bottom: 30px;
	}

	.breadcrumb__segment {
		color: var(--text-muted);
	}

	a.breadcrumb__segment {
		transition: color 0.15s ease;
	}

	a.breadcrumb__segment:hover {
		color: var(--accent);
	}

	.breadcrumb__current {
		color: var(--accent);
	}

	.breadcrumb-pill {
		display: none;
	}

	@media (max-width: 767px) {
		.breadcrumb {
			display: none;
		}

		.breadcrumb-pill {
			/* Bleeds full-bleed by canceling BaseLayout's `.page-main-content` mobile padding —
			   named here so the two numbers this depends on are declared once, not scattered
			   across the width/margin/padding below. */
			--page-pad-x: var(--content-pad-x);
			--page-pad-top: var(--content-pad-top);
			display: flex;
			align-items: center;
			gap: 10px;
			width: calc(100% + var(--page-pad-x) * 2);
			min-height: 46px;
			margin: calc(var(--page-pad-top) * -1) calc(var(--page-pad-x) * -1) 26px;
			padding: 0 var(--page-pad-x);
			background: var(--white-02);
			border: none;
			border-bottom: 1px solid var(--hairline-08);
			font: 400 12px var(--font-mono);
			color: var(--text-muted);
			cursor: pointer;
			text-align: left;
		}

		.breadcrumb-pill__section,
		.breadcrumb-pill__current {
			overflow: hidden;
			min-width: 0;
			white-space: nowrap;
			text-overflow: ellipsis;
		}

		.breadcrumb-pill__section {
			/* Shrinks (and truncates) well before the current title does, so ancestor path
			   segments give up space first when the pill is too narrow to fit everything. */
			flex-shrink: 999;
			color: var(--text-dim);
		}

		.breadcrumb-pill__current {
			flex-shrink: 1;
			color: var(--accent);
		}

		.breadcrumb-pill__trigger {
			flex-shrink: 0;
			white-space: nowrap;
			margin-left: auto;
			font-size: 10px;
			color: var(--text-dim);
		}
	}
</style>
