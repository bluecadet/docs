---
// Shared brand cell — logo glyph + site title, linked to `href` — reused by Header.astro and
// LandingHeader.astro so the two never drift on color/clickability again (the landing wordmark
// used to render as inert, dimmed text).
interface Props {
	title: string;
	href: string;
}

const { title, href } = Astro.props;
---

<div class="wordmark">
	<a href={href}>
		<span class="prefix">bluecadet</span>
		<span class="slash">/</span>
		<span class="title">{title}</span>
	</a>
</div>

<style>
	.wordmark {
		display: flex;
		align-items: center;
		padding-block: 0;
		padding-inline: var(--brand-pad-start) var(--brand-pad-end);
		border-inline-end: var(--rail-divider);
		min-inline-size: 0;
	}

	.wordmark a {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
		font: var(--weight-medium) 0.96875rem var(--font-mono); /* 15.5px */
		text-transform: lowercase;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--text-dim);
	}

	.title {
		color: var(--ink);
	}

	@media (max-width: 1023px) {
		.wordmark {
			padding: 0;
			border-inline-end: none;
		}
	}
</style>
