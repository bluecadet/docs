---
// External-link affordance ("<label> ↗") for the header nav, used by NavLinks.astro for the
// default repoUrl link and for any `header.links` entry that points off-site — so they all get
// the same color and hover treatment.
import { externalLinkAttrs } from "../../lib/config";

interface Props {
	href: string;
	/** Link text before the "↗". Defaults to "github" for the repoUrl fallback use. */
	label?: string;
}

const { href, label = "github" } = Astro.props;
---

<a class="repo-link" href={href} {...externalLinkAttrs(href)}> {label} ↗ </a>

<style>
	.repo-link {
		color: var(--accent-2);
		transition: color var(--transition-fast);
	}

	.repo-link:hover {
		color: color-mix(in srgb, var(--accent-2) 80%, white);
	}
</style>
