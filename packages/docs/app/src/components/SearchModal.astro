---
// Search modal: a native <dialog> overlay driven by pagefind (index written by the
// astro:build:done hook in astro.config.mjs, see app/src/scripts/search.ts for the client
// behavior). Markup here covers all four designed states — empty/recent+start-here, results,
// no-results, loading — the client script swaps state by rewriting .search-modal__body.
//
// Opened by any [data-search-trigger] button (see Header.astro / LandingHeader.astro) or the
// `/` key. Included once per page from BaseLayout.astro and index.astro.
import { firstPageOf, getNavTree } from "../lib/nav";
import { getDocsConfig } from "../lib/config";

const repoUrl = getDocsConfig().repoUrl;

// "START HERE" = the entry point of each top-level section, in sidebar order, topped up from the
// full page list when there are fewer than 8 sections.
const { nodes, flat } = await getNavTree();
const entryPoints = nodes.map((node) => firstPageOf(node)).filter((page) => page !== undefined);
const startHere = [...new Map([...entryPoints, ...flat].map((page) => [page.id, page])).values()]
	.slice(0, 8)
	.map((page) => ({ label: page.label, href: page.href, description: page.description }));
---

<dialog id="search-modal" class="search-modal" aria-label="Search documentation">
	<div class="search-modal__header">
		<span class="search-modal__icon" data-search-icon aria-hidden="true">⌕</span>
		<input
			type="text"
			class="search-modal__input"
			data-search-input
			placeholder="search docs"
			aria-label="Search documentation"
			role="combobox"
			aria-expanded="true"
			aria-controls="search-results"
			aria-autocomplete="list"
			autocomplete="off"
			spellcheck="false"
		/>
		<span class="search-modal__status type-sm" data-search-status></span>
		<button type="button" class="search-modal__cancel type-sm" data-search-cancel>cancel</button>
	</div>
	<div class="search-modal__body dialog-body" data-search-body>
	</div>
	<div class="search-modal__footer">
		<!-- scripts/search.ts's setHintsIndexing() rewrites this container's innerHTML at runtime
		     (see the :global() comment in the <style> block below) with its own hardcoded
		     `<span class="kbd-hint">...` template. That JS-side class list duplicates the one below
		     and MUST be kept in sync by hand — including any `.type-*` utility class — or the
		     utility silently stops applying after the first indexing-state toggle even though this
		     static markup still looks correct in source. -->
		<div class="search-modal__hints" data-search-hints>
			<span class="kbd-hint type-2xs"><kbd>↑↓</kbd> navigate</span>
			<span class="kbd-hint type-2xs"><kbd>↵</kbd> open</span>
			<span class="kbd-hint type-2xs"><kbd>esc</kbd> close</span>
		</div>
	</div>
</dialog>

<script type="application/json" id="search-start-here-data" set:html={JSON.stringify(startHere)} />
<script type="application/json" id="search-repo-url-data" set:html={JSON.stringify(repoUrl ?? null)} />

<script>
	import { initSearchModal } from "../scripts/search";
	initSearchModal();
</script>

<style>
	.search-modal {
		inline-size: 680px;
		max-inline-size: calc(100vw - 40px);
		/* Anchored near the top of the viewport instead of vertically centered: with `margin: auto`
		   centering, every keystroke that changed the result count also changed the dialog's
		   height, so the whole box jumped up and down around the viewport's vertical center.
		   Pinning `inset-block-start` keeps the input row stationary and lets only the bottom edge
		   move. `inset-block-end: auto` keeps the height content-driven (rather than stretching to
		   fill the gap down to the viewport edge); max-height below still caps a long results list
		   so it grows downward and scrolls internally instead of overflowing the viewport. */
		inset-block-start: 80px;
		inset-block-end: auto;
		max-block-size: calc(100vh - 80px - 40px);
		padding: 0;
		margin: 0 auto;
		border: 1px solid var(--hairline-14);
		border-radius: var(--radius-lg);
		background: var(--surface-code);
		color: var(--ink);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.6);
		display: flex;
		flex-direction: column;
	}

	.search-modal::backdrop {
		background: var(--overlay-scrim);
		backdrop-filter: blur(1.5px);
	}

	.search-modal:not([open]) {
		display: none;
	}

	.search-modal__header {
		display: grid;
		grid-template-columns: 20px 1fr auto;
		align-items: center;
		gap: 12px;
		block-size: 60px;
		padding: 0 18px;
		border-block-end: 1px solid var(--hairline-10);
		flex-shrink: 0;
	}

	.search-modal__icon {
		font-size: 16px;
		color: var(--accent);
		transition: color var(--transition-fast);
	}

	.search-modal__icon.is-attention {
		color: var(--accent-2);
	}

	.search-modal__input {
		inline-size: 100%;
		border: none;
		outline: none;
		background: transparent;
		font: 400 16px var(--font-mono);
		color: var(--ink);
		caret-color: var(--accent);
	}

	.search-modal__input::placeholder {
		color: var(--text-dim);
	}

	.search-modal__status {
		color: var(--text-dim);
		white-space: nowrap;
	}

	.search-modal__status.is-attention {
		color: var(--accent-2);
	}

	.search-modal__cancel {
		display: none;
		background: none;
		border: none;
		color: var(--text-muted);
		cursor: pointer;
	}

	.search-modal__body {
		overflow-y: auto;
		padding: 6px 0;
		flex: 1 1 auto;
		min-block-size: 80px;
	}

	.search-modal__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		block-size: 44px;
		padding: 0 18px;
		border-block-start: 1px solid var(--hairline-10);
		flex-shrink: 0;
	}

	/* :global() because scripts/search.ts's setHintsIndexing() rewrites this container's innerHTML
	   at runtime — that injected markup never carries Astro's scoped-CSS data attribute, so these
	   three selectors have to match on class name alone (same pattern as the .search-row/
	   .search-group globals below). NOTE: as of this comment, that JS template's `.kbd-hint` spans
	   are missing the `.type-2xs` class the static markup above carries (see the comment on
	   [data-search-hints] above) — a known regression that needs a fix in scripts/search.ts. */
	.search-modal__footer :global(.search-modal__hints) {
		display: flex;
		gap: 16px;
	}

	.search-modal__footer :global(.search-modal__hints.is-indexing) {
		color: var(--accent);
		font: 400 11.5px var(--font-mono);
	}

	.search-modal__footer :global(.kbd-hint) {
		display: flex;
		align-items: center;
		gap: 6px;
		color: var(--text-dim);
	}

	.search-modal__footer :global(.kbd-hint kbd) {
		padding: 1px 5px;
	}

	/* -- Groups / rows (shared by recent, start-here, and result states) -- */
	:global(.search-group) {
		border-block-start: 1px solid var(--hairline-06);
		padding-block-start: 4px;
		margin-block-start: 4px;
	}

	:global(.search-group:first-child) {
		border-block-start: none;
		margin-block-start: 0;
		padding-block-start: 0;
	}

	:global(.search-group__label) {
		padding: 10px 18px 6px;
		font: 400 11px var(--font-mono);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--text-dim);
	}

	:global(.search-row) {
		display: grid;
		grid-template-columns: 22px 1fr auto;
		align-items: start;
		gap: 4px;
		padding: 11px 18px;
		color: inherit;
		text-decoration: none;
		cursor: pointer;
	}

	:global(.search-row__bullet) {
		color: var(--text-faint);
		font-size: 13px;
		line-height: 1.6;
	}

	:global(.search-row__text) {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-inline-size: 0;
	}

	:global(.search-row__title) {
		font-size: 14.5px;
		color: var(--ink);
	}

	:global(.search-row__desc) {
		font-size: 12.5px;
		color: var(--text-muted);
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}

	:global(.search-row__desc mark),
	:global(.search-row__title mark) {
		color: var(--accent-2);
		background: var(--accent-2-tint-14);
		border-radius: 2px;
		padding: 0 3px;
	}

	:global(.search-row__enter) {
		visibility: hidden;
		color: var(--accent);
		font-size: 12px;
		line-height: 1.6;
	}

	:global(.search-row.is-active) {
		background: var(--accent-tint-09);
		box-shadow: inset 2px 0 var(--accent);
	}

	:global(.search-row.is-active .search-row__bullet) {
		color: var(--accent);
	}

	:global(.search-row.is-active .search-row__enter) {
		visibility: visible;
	}

	/* -- No-results / dev-notice callout -- */
	:global(.search-callout) {
		margin: 10px 18px;
		padding: 14px 16px;
		border: 1px solid var(--accent-2-border-22);
		border-inline-start: 2px solid var(--accent-2);
		border-radius: var(--radius-md);
		background: var(--accent-2-tint-06);
		color: var(--accent-2-callout-body);
		font-size: 13.5px;
		line-height: 1.6;
	}

	:global(.search-callout__label) {
		display: block;
		margin-block-end: 6px;
		font: 500 11px var(--font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-2);
	}

	:global(.search-pills) {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		padding: 4px 18px 16px;
	}

	:global(.search-pill) {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 7px 12px;
		border-radius: var(--radius-md);
		font: 400 12px var(--font-mono);
		text-decoration: none;
	}

	:global(.search-pill--neutral) {
		border: 1px solid var(--hairline-14);
		color: var(--text-muted);
	}

	:global(.search-pill--attention) {
		border: 1px solid var(--accent-2-border-40);
		color: var(--accent-2);
	}

	/* -- Loading skeleton -- */
	:global(.search-skeleton-row) {
		display: grid;
		grid-template-columns: 22px 1fr;
		padding: 11px 18px;
	}

	:global(.search-skeleton-bar) {
		display: block;
		inline-size: 75%;
		height: 10px;
		border-radius: 2px;
		background: var(--white-07);
		animation: search-skeleton-pulse 1.4s ease-in-out infinite;
	}

	:global(.search-skeleton-bar + .search-skeleton-bar) {
		margin-block-start: 8px;
		inline-size: 60%;
	}

	@keyframes search-skeleton-pulse {
		0%,
		100% {
			opacity: 0.5;
		}
		50% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.search-skeleton-bar) {
			animation: none;
		}
	}

	:global(.search-empty-note) {
		padding: 24px 18px;
		font-size: 13px;
		color: var(--text-dim);
	}

	/* -- Mobile: full-screen view instead of a centered modal ------------------------------- */
	@media (max-width: 767px) {
		.search-modal {
			/* Reset the desktop top-anchoring offset — full-screen here, so the dialog should sit
			   flush with the viewport top rather than 80px down. */
			inset-block-start: 0;
			inline-size: 100vw;
			max-inline-size: 100vw;
			block-size: 100vh;
			max-block-size: 100vh;
			border: none;
			border-radius: 0;
			box-shadow: none;
		}

		.search-modal::backdrop {
			backdrop-filter: none;
		}

		.search-modal__header {
			display: flex;
			flex-wrap: wrap;
			block-size: auto;
			min-block-size: 56px;
			padding-block: 0 0;
			padding-inline: 18px 14px;
			row-gap: 0;
			column-gap: 10px;
		}

		.search-modal__icon {
			order: 1;
			align-self: center;
		}

		.search-modal__input {
			order: 2;
			inline-size: auto;
			block-size: var(--header-height);
			flex: 1 1 auto;
			min-inline-size: 0;
		}

		.search-modal__cancel {
			order: 3;
			display: block;
			align-self: center;
			min-block-size: 44px;
			padding: 0 4px;
		}

		.search-modal__status {
			order: 4;
			/* Full-bleed the divider edge-to-edge by negating the header's own horizontal padding
			   (padding-inline: 18px 14px), then restoring that same inset via padding so the text
			   still lines up with the input above it. flex-basis (not width) drives a flex item's
			   main size, so the +32px (14+18) has to be added here too — negative margins alone
			   don't stretch it, since `flex-basis: 100%` resolves against the header's content box,
			   which already excludes that padding. */
			flex-basis: calc(100% + 32px);
			display: flex;
			justify-content: space-between;
			margin-block: 0 0;
			margin-inline: -18px -14px;
			padding-block: 10px 10px;
			padding-inline: 18px 14px;
			border-block-start: 1px solid var(--hairline-06);
		}

		/* Empty status (fresh open, or query cleared back to empty — search.ts's setStatus("")
		   leaves no child nodes) must collapse fully: no border, no padding, no height. Otherwise a
		   blank divider band shows between the input row and the header's own bottom hairline. */
		.search-modal__status:empty {
			display: none;
		}

		/* Kbd hints (↑↓ / ↵ / esc) don't apply to touch input — "cancel" already covers dismissal,
		   and results are opened by tapping. */
		.search-modal__footer {
			display: none;
		}
	}
</style>
