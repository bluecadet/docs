---
// Doc-page header: logo cell aligned with the sidebar rail, search trigger pill (visual only —
// SearchModal.astro's script wires the modal behind the shared `data-search-trigger`), and the
// shared primary nav. No version chip: no data source for one.
//
// The shell (sticky positioning, grid/flex layout, translucent+blurred background, hairline
// border) and the brand/nav/search/hamburger pieces are shared with LandingHeader.astro via
// components/header/* so the two variants can't drift apart — see HeaderShell.astro for the
// tablet/mobile breakpoint behavior both headers follow, and HeaderNav.astro for the link set.
import HeaderShell from "./header/HeaderShell.astro";
import HeaderNav from "./header/HeaderNav.astro";
import Wordmark from "./header/Wordmark.astro";
import SearchTrigger from "./header/SearchTrigger.astro";
import NavToggle from "./header/NavToggle.astro";
import { getDocsConfig } from "../lib/config";

const config = getDocsConfig();
const base = import.meta.env.BASE_URL;
---

<HeaderShell>
	<Wordmark title={config.title} href={base} />
	<div class="site-header__right">
		<SearchTrigger />
		<HeaderNav />
		<NavToggle />
	</div>
</HeaderShell>

<style>
	.site-header__right {
		display: flex;
		align-items: center;
		gap: 32px;
		padding-block: 0;
		padding-inline: var(--nav-pad-start) var(--content-pad-x);
		min-width: 0;
	}

	/* Sidebar-less pages (see BaseLayout's `--nav-flex`): HeaderShell's row is flex, not grid, at
	   desktop too, so this cell needs to grow into the space the rail column used to reserve. A
	   no-op (`initial`) on doc pages, where HeaderShell stays a grid and this is still the second
	   column filling the remaining `1fr` track on its own. */
	@media (min-width: 1024px) {
		.site-header__right {
			flex: var(--nav-flex, initial);
		}
	}

	/* Tablet: HeaderShell collapses to a flex row; push this side to the far right. */
	@media (max-width: 1023px) {
		.site-header__right {
			margin-inline-start: auto;
			padding: 0;
			gap: 20px;
		}
	}

	@media (max-width: 767px) {
		.site-header__right {
			gap: 16px;
		}
	}
</style>
