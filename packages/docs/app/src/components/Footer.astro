---
// Doc-page footer: grid mirrors the header (same --rail-width column). Only renders links we
// actually have data for — no fictional changelog/discord links, no fabricated version/license
// string (no data source for either).
const siteTitle = process.env.DOCS_TITLE ?? "docs";
const repoUrl = process.env.DOCS_REPO_URL;
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
	<div class="site-footer__brand">
		<span class="glyph">▞</span>{siteTitle}
	</div>
	<div class="site-footer__right">
		<a class="site-footer__link" href={base}>docs</a>
		{
			repoUrl && (
				<a class="site-footer__link" href={repoUrl} rel="noopener noreferrer" target="_blank">
					github
				</a>
			)
		}
	</div>
</footer>

<style>
	.site-footer {
		display: grid;
		grid-template-columns: var(--rail-width) 1fr;
		border-top: 1px solid var(--hairline-08);
		background: var(--surface-footer);
	}

	.site-footer__brand {
		display: flex;
		align-items: center;
		gap: 8px;
		border-right: 1px solid var(--hairline-08);
		padding: 26px 28px;
		font: 400 12px var(--font-mono);
		color: var(--text-faint);
		text-transform: lowercase;
		min-width: 0;
	}

	.glyph {
		color: var(--text-faint);
	}

	.site-footer__right {
		display: flex;
		align-items: center;
		gap: 28px;
		padding: 26px 56px;
		font: 400 12px var(--font-mono);
	}

	.site-footer__link {
		color: var(--text-muted);
		transition: color 0.15s ease;
	}

	.site-footer__link:hover {
		color: var(--accent);
	}

	@media (max-width: 1023px) {
		.site-footer {
			grid-template-columns: 1fr;
		}

		.site-footer__brand {
			border-right: none;
			border-bottom: 1px solid var(--hairline-08);
		}
	}
</style>
