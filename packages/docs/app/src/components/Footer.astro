---
// One footer for every route (doc pages, landing and 404 all render this via BaseLayout's
// default `footer` slot). Grid mirrors the header (same --rail-display swap to a plain flex row,
// no rail column or divider, on sidebar-less pages — see BaseLayout's `.page--no-sidebar`).
// Deliberately prop-less: everything comes from config and the nav tree, so the footer is
// byte-identical on every page — no per-template variants to drift apart. Only renders
// links/meta we actually have data for — no fictional changelog/discord links, no fabricated
// version/license string.
import { getDocsConfig, isExternalLink } from "../lib/config";
import { docsEntryHref } from "../lib/nav";

const config = getDocsConfig();
const footerLinks = config.footer?.links ?? [];
const meta = config.footer?.meta;
const docsHref = await docsEntryHref();
---

<footer class="site-footer">
	<div class="site-footer-inner">
		<div class="site-footer__brand">
			<span class="glyph">▞</span>{config.title}
		</div>
		<div class="site-footer__right">
			{
				footerLinks.length > 0 ? (
					footerLinks.map((link) => (
						<a
							class="site-footer__link"
							href={link.href}
							rel={isExternalLink(link.href) ? "noopener noreferrer" : undefined}
							target={isExternalLink(link.href) ? "_blank" : undefined}
						>
							{link.label}
						</a>
					))
				) : (
					<>
						<a class="site-footer__link" href={docsHref}>
							docs
						</a>
						{config.repoUrl && (
							<a
								class="site-footer__link"
								href={config.repoUrl}
								rel="noopener noreferrer"
								target="_blank"
							>
								github
							</a>
						)}
					</>
				)
			}
			{meta && <span class="site-footer__meta">{meta}</span>}
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--hairline-08);
		background: var(--surface-footer);
	}

	/* Capped, centered inner row — mirrors .header-shell-inner and .page-body so the left/right
	   hairlines line up into one continuous edge from the header down through the footer.
	   `--rail-display`/grid-template-columns follow the same grid-on-doc-pages, flex-on-sidebar-less
	   swap as .header-shell-inner — see its comment in HeaderShell.astro. */
	.site-footer-inner {
		display: var(--rail-display);
		grid-template-columns: var(--rail-width) 1fr;
		max-width: var(--shell-width);
		margin-inline: auto;
		border-inline: 1px solid var(--hairline-08);
	}

	.site-footer__brand {
		display: flex;
		align-items: center;
		gap: 8px;
		border-right: var(--rail-divider);
		padding: 32px var(--brand-pad-right) 32px var(--brand-pad-left);
		font: 400 12px var(--font-mono);
		color: var(--text-faint);
		text-transform: lowercase;
		min-width: 0;
	}

	.glyph {
		color: var(--text-faint);
	}

	.site-footer__right {
		display: flex;
		align-items: center;
		gap: 28px;
		padding: 32px var(--content-pad-x) 32px var(--nav-pad-left);
		font: 400 12px var(--font-mono);
	}

	/* Sidebar-less pages (see BaseLayout's `--nav-flex`): the footer row is flex, not grid, at
	   desktop too, so this cell needs to grow into the space the rail column used to reserve. A
	   no-op (`initial`) on doc pages, where it's still the grid's second column filling `1fr`. */
	@media (min-width: 1024px) {
		.site-footer__right {
			flex: var(--nav-flex, initial);
		}
	}

	.site-footer__link {
		color: var(--text-muted);
		transition: color 0.15s ease;
	}

	.site-footer__link:hover {
		color: var(--accent);
	}

	.site-footer__meta {
		margin-left: auto;
		color: var(--text-faint);
	}

	@media (max-width: 1023px) {
		.site-footer-inner {
			display: grid;
			grid-template-columns: 1fr;
		}

		.site-footer__brand {
			border-right: none;
			border-bottom: 1px solid var(--hairline-08);
			padding: 32px var(--content-pad-x);
		}
	}

	@media (max-width: 767px) {
		.site-footer__right {
			flex-wrap: wrap;
		}

		.site-footer__link {
			display: flex;
			align-items: center;
			min-height: 48px;
		}

		.site-footer__meta {
			margin-left: 0;
			flex-basis: 100%;
		}
	}
</style>
