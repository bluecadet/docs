---
// One footer for every route (doc pages, landing and 404 all render this via BaseLayout's
// default `footer` slot). Deliberately prop-less: everything comes from config and the nav tree,
// so the footer is byte-identical on every page — no per-template variants to drift apart. Only
// renders link groups/meta we actually have data for — no fictional changelog/discord links, no
// fabricated version/license string.
//
// Layout differences between the docs (sidebar) and landing/404 (no-sidebar) pages come only from
// the `--rail-*`/`--brand-pad-*`/`--nav-flex` custom properties BaseLayout sets on `.page` /
// `.page--no-sidebar` — see Header/HeaderShell's matching comments — never from a prop here. The
// same mechanism also moves the brand mark between the rail column (docs, where the sidebar
// already lives under it) and the bottom bar (landing/404, which has no rail to put it in): see
// the `:global(.page--no-sidebar)` rules below.
import { externalLinkAttrs, getDocsConfig, isExternalLink } from "../lib/config";
import type { FooterGroup } from "../lib/config";
import { footerGroups } from "../lib/nav";

const config = getDocsConfig();
const meta = config.footer?.meta;

// See footerGroups() (lib/nav.ts) for the fallback applied when the config declares no groups —
// shared with NavSheet.astro so the two can never drift apart.
const groups: FooterGroup[] = await footerGroups(config);

// Desktop column proportions, generalized for however many groups the config declares (n):
// the last group — typically the note-bearing "from the same shop" list — gets extra width so
// its links end well before the right edge instead of stretching to match the other columns.
// Computed from `groups.length` server-side and handed to the two media-scoped grid rules below
// as custom properties — this reads config data, not an external prop, so it doesn't reintroduce
// the per-template variants the prop-less design avoids.
//   - rail (docs): `repeat(n-1, 1fr) 1.4fr` — n === 3 is exactly the reference's `1fr 1fr 1.4fr`.
//   - no-rail (landing): `repeat(n+1, 1fr)`, last group spans 2 of those tracks — n === 3 is
//     exactly the reference's `repeat(4, 1fr)` with the shop group at `span 2`.
// n <= 1 has nothing to differentiate, so both variants just render one full-width column
// (`repeat(0, ...)` is invalid CSS and would drop the whole declaration, so guard it explicitly).
const groupCount = groups.length;
const groupsColumnsRail = groupCount > 1 ? `repeat(${groupCount - 1}, 1fr) 1.4fr` : "1fr";
const groupsColumnsNoRail = groupCount > 1 ? `repeat(${groupCount + 1}, 1fr)` : "1fr";
const lastGroupIsWide = groupCount > 1;
---

<footer class="site-footer">
	<div class="site-footer-inner">
		<div class="site-footer__top">
			<div class="site-footer__brand type-sm site-footer__brand--rail">
				<span class="glyph">▞</span>{config.title}
			</div>
			<div
				class="site-footer__groups"
				style={`--groups-columns-rail:${groupsColumnsRail};--groups-columns-no-rail:${groupsColumnsNoRail}`}
			>
				{
					groups.map((group, index) => {
						// A group whose links carry notes (e.g. the "from the same shop" URLs) gets its own
						// single-column treatment on the stacked tiers — see `.site-footer__group-links--notes`.
						const hasNotes = group.links.some((link) => link.note);
						const isLast = index === groups.length - 1;
						return (
							<div class:list={["site-footer__group", "type-sm", { "site-footer__group--wide": lastGroupIsWide && isLast }]}>
								<div class="site-footer__group-title">{group.title}</div>
								<div
									class:list={[
										"site-footer__group-links",
										{ "site-footer__group-links--notes": hasNotes },
									]}
								>
									{group.links.map((link) => (
										<a class="site-footer__link link-muted" href={link.href} {...externalLinkAttrs(link.href)}>
											<span class="site-footer__link-label">
												{link.label}
												{isExternalLink(link.href) && " ↗"}
											</span>
											{link.note && <span class="site-footer__note">{link.note}</span>}
										</a>
									))}
								</div>
							</div>
						);
					})
				}
			</div>
		</div>
		<div class="site-footer__bottom type-sm">
			<div class="site-footer__brand type-sm site-footer__brand--bottom">
				<span class="glyph">▞</span>{config.title}
			</div>
			{meta && <span class="site-footer__meta">{meta}</span>}
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-block-start: 1px solid var(--hairline-08);
		background: var(--surface-footer);
	}

	/* Capped, centered inner column — mirrors .header-shell-inner and .page-body so the inline
	   hairlines line up into one continuous edge from the header down through the footer. */
	.site-footer-inner {
		max-inline-size: var(--shell-width);
		margin-inline: auto;
		border-inline: 1px solid var(--hairline-08);
	}

	/* Brand + link groups row. Follows the same grid-on-doc-pages, flex-on-sidebar-less swap as
	   .header-shell-inner — see its comment in HeaderShell.astro. */
	.site-footer__top {
		display: var(--rail-display);
		grid-template-columns: var(--rail-width) 1fr;
	}

	.site-footer__brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-faint);
		text-transform: lowercase;
		min-inline-size: 0;
	}

	.glyph {
		color: var(--text-faint);
	}

	.site-footer__brand--rail {
		/* The grid row stretches this cell to match the (taller) groups cell's height, and
		   `.site-footer__brand`'s `align-items: center` above would then center the one-line brand
		   mark inside that stretched box — dropping it well below the 2.5rem top padding and out of
		   line with the group titles beside it. Pin it to the top of its own box instead so both
		   cells' first line start at the same y. */
		align-items: flex-start;
		border-inline-end: var(--rail-divider);
		padding-block: 2.5rem 2rem;
		padding-inline: var(--brand-pad-start) var(--brand-pad-end);
	}

	/* Only ever shown on sidebar-less pages at desktop widths — see the `min-width: 1024px` rule
	   below, which is the *only* place this flips to `flex` — where the rail brand cell has nowhere
	   to go, so it moves down into the bottom bar. Below 1024px every template (docs and landing
	   alike) uses the stacked `.site-footer__brand--rail` block instead — see the
	   `max-width: 1023px` rule further down — so this stays hidden there. */
	.site-footer__brand--bottom {
		display: none;
	}

	.site-footer__groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		padding: 2.5rem var(--content-pad-x) 2rem var(--content-pad-x);
	}

	/* Adopts .type-sm (see typography.css) for family/weight/size; line-height alone stays local
	   since the mono UI ramp classes deliberately omit it (see typography.css's header comment). */
	.site-footer__group {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
		line-height: var(--leading-relaxed);
		min-inline-size: 0;
	}

	.site-footer__group-title {
		font-size: 0.71875rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	/* `display: contents` on desktop lets the links participate directly in .site-footer__group's
	   flex column (and its gap) as if the wrapper weren't there; the mobile breakpoint below turns
	   it into the reference's two-column link grid instead. */
	.site-footer__group-links {
		display: contents;
	}

	/* Note (e.g. a "from the same shop" URL) sits immediately after the label with a small gap, at
	   every viewport — no `justify-content: space-between`/`margin-inline-start: auto` pushing it off to
	   the far edge of the row. */
	.site-footer__link {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.site-footer__note {
		color: var(--text-faint);
		font-size: 0.92em;
		white-space: nowrap;
	}

	.site-footer__bottom {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
		padding-block: 1.25rem 1.5rem;
		padding-inline: var(--brand-pad-start) var(--content-pad-x);
		border-block-start: 1px solid var(--hairline-08);
		color: var(--text-faint);
	}

	.site-footer__meta {
		margin-inline-start: auto;
	}

	@media (min-width: 1024px) {
		/* No rail column on sidebar-less pages (see BaseLayout's `--nav-flex`): the groups cell
		   needs to grow into the space the rail column used to reserve. A no-op (`initial`) on doc
		   pages, where it's still the top row's second column filling `1fr`.
		   `grid-template-columns` here is the rail (docs) proportions — see the frontmatter comment
		   above `groupsColumnsRail`/`groupsColumnsNoRail` for how the two custom properties are
		   computed from `groups.length`; the no-rail (landing) override sits right below. */
		.site-footer__groups {
			grid-template-columns: var(--groups-columns-rail);
			flex: var(--nav-flex, initial);
			gap: 2.5rem 3rem;
		}

		:global(.page--no-sidebar) .site-footer__groups {
			grid-template-columns: var(--groups-columns-no-rail);
		}

		/* Only meaningful in the no-rail template: the rail variant's trailing `1.4fr` track already
		   gives the last group its extra width by position, so it needs no span there. */
		:global(.page--no-sidebar) .site-footer__group--wide {
			grid-column: span 2;
		}

		/* Sidebar-less pages have no rail for the brand to sit beside, so it swaps into the bottom
		   bar instead — same swap Header.astro drives off `.page--no-sidebar`, just relocating the
		   brand rather than reflowing it in place. Scoped to this desktop-only query on purpose: the
		   rail brand must stay visible as the stacked top block below 1024px on every template,
		   sidebar or not — see `.site-footer__brand--bottom`'s comment above. */
		:global(.page--no-sidebar) .site-footer__brand--rail {
			display: none;
		}

		:global(.page--no-sidebar) .site-footer__brand--bottom {
			display: flex;
		}
	}

	/* Tablet (768–1023) and mobile (≤767, further tightened below) share this single range: both
	   restyle `.site-footer__brand--rail` into the same stacked top block, on docs and landing
	   alike — there's no `.page--no-sidebar` override in this range (that only exists in the
	   `min-width: 1024px` block above), so the two tiers stay identical here by construction. */
	@media (max-width: 1023px) {
		.site-footer__top {
			display: grid;
			grid-template-columns: 1fr;
		}

		/* Vertical rhythm below matches the reference's mobile frame (`26px 22px`/`22px 22px 30px`
		   block padding, 16px title→list gap, 16px/20px 2-col link grid, 18px note-row gap) — only
		   the horizontal insets stay on the repo's `--content-pad-x` convention (18px at mobile)
		   instead of the reference's hard-coded 22px. */
		.site-footer__brand--rail {
			border-inline-end: none;
			border-block-end: 1px solid var(--hairline-08);
			padding: 1.625rem var(--content-pad-x) 1.375rem;
		}

		.site-footer__groups {
			display: flex;
			flex-direction: column;
			padding: 0;
		}

		.site-footer__group {
			padding: 1.625rem var(--content-pad-x);
			border-block-end: 1px solid var(--hairline-06);
			gap: 1rem;
			font-size: 0.8125rem;
			line-height: 1.7;
		}

		.site-footer__group-links {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1rem 1.25rem;
		}

		/* A group whose links carry notes (e.g. the "from the same shop" URLs) renders as a single
		   column of full-width rows instead of the two-column grid above — two columns would crush
		   the long note text into an awkward wrap. Plain groups are unaffected; their own row gap
		   (18px, slightly more breathing room than the 2-col grid's 16px) comes along with it. */
		.site-footer__group-links--notes {
			grid-template-columns: 1fr;
			gap: 1.125rem;
		}

		.site-footer__bottom {
			padding: 1.375rem var(--content-pad-x) 1.875rem;
		}
	}

	@media (max-width: 767px) {
		.site-footer__meta {
			margin-inline-start: 0;
			flex-basis: 100%;
		}
	}
</style>
