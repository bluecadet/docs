---
// Terminal window: a title bar with dots + cwd, and a body that renders either a `<Line>`
// transcript slot or an asciinema cast player with custom controls.
//
//   <Terminal cwd="~/my-repo">
//     <Line prompt>npx @bluecadet/docs build</Line>
//     <Line label="reading">README.md + docs/ <Ok>✓</Ok></Line>
//   </Terminal>
//
// Lines are <Line> elements rather than raw indented text because MDX parses the children of a
// JSX block as markdown, which would collapse the leading whitespace that a transcript depends
// on. <Line label> restores the aligned label column with a mono `ch` measure instead.
//
// Passing `cast` swaps the transcript slot for a real asciinema recording (asciicast v2) played
// back through `asciinema-player`, with play/pause and restart buttons folded into the title bar
// instead of the player's stock control bar (see `terminal-player.ts` and the
// `.asciinema-player-theme-docs` theme in `styles/asciinema-theme.css`, which also hides the stock
// start overlay). The two modes are mutually exclusive — `cast` set means `<Line>` children are
// ignored. Playback tracks scroll position — playing while the terminal is in view, pausing once
// it isn't — unless the visitor prefers reduced motion (see terminal-player.ts). Kept deliberately
// small: no progress scrubbing, no volume/fullscreen/speed controls, no marker support. Consumers
// who need those should reach for the player directly.
//
// Context-neutral: this is the window only, sized to its container (`inline-size: 100%`, no max
// width, no outer margins/padding). Landing's full-bleed band chrome — caption/duration row, band
// padding, background, hairline, the 880px width cap — lives one layer up in
// `landing/TerminalBand.astro`, which renders this component. Doc-page prose bodies can render
// this directly.
export interface Props {
	/** Working-directory label in the terminal's title bar. */
	cwd?: string;
	/** URL/path to an asciicast v2 `.cast` file. When set, renders a player instead of the
	    `<Line>` transcript slot. See the CLI's asset sync (`sync.ts`) for where a consumer repo's
	    `.cast` files under `docs/` end up published — `app/public/` itself is wiped on every
	    sync, so files must live in the consumer repo's docs tree, not this package. */
	cast?: string;
	/** Terminal grid size passed to the player; falls back to the cast file's own header. */
	rows?: number;
	cols?: number;
	/** Poster frame shown before playback starts, e.g. `npt:0:03` — passed straight through. */
	poster?: string;
	/** Loops playback when it ends. */
	loop?: boolean;
}

const { cwd, cast, rows, cols, poster, loop } = Astro.props;
---

<div class="terminal">
	<div class="terminal-bar type-2xs">
		<span class="terminal-dots" aria-hidden="true">
			<span class="terminal-dot terminal-dot-1"></span>
			<span class="terminal-dot terminal-dot-2"></span>
			<span class="terminal-dot terminal-dot-3"></span>
		</span>
		{cwd && <span class="terminal-cwd">{cwd}</span>}
		{
			cast && (
				<span class="terminal-cast-actions">
					<button
						type="button"
						class="terminal-play terminal-button"
						data-terminal-play
						aria-label="Play"
					>
						▶
					</button>
					<button
						type="button"
						class="terminal-restart terminal-button"
						data-terminal-restart
						aria-label="Restart"
					>
						↺
					</button>
				</span>
			)
		}
	</div>
	{
		cast ? (
			<div
				class="terminal-cast"
				data-terminal-cast={cast}
				data-terminal-rows={rows}
				data-terminal-cols={cols}
				data-terminal-poster={poster}
				data-terminal-loop={loop ? "true" : undefined}
			/>
		) : (
			<pre class="terminal-body type-md"><slot /></pre>
		)
	}
</div>

{
	cast && (
		<script>
			import "../scripts/terminal-player";
		</script>
	)
}

<style>
	.terminal {
		inline-size: 100%;
		border: 1px solid var(--hairline-10);
		border-radius: var(--radius-md);
		background: var(--surface-code);
		overflow: hidden;
	}

	.terminal-bar {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding-inline-start: 0.875rem;
		min-block-size: 2.5rem;
		border-block-end: 1px solid var(--hairline-08);
		color: var(--text-dim);
	}

	.terminal-dots {
		display: flex;
		gap: 0.3125rem;
	}

	.terminal-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}

	.terminal-dot-1 {
		background: var(--accent);
	}

	.terminal-dot-2 {
		background: var(--accent-2);
	}

	.terminal-dot-3 {
		background: var(--terminal-dot-3);
	}

	/* `white-space: normal` on the <pre> itself, `pre` on each <Line> (see Line.astro): the lines
	   are block boxes, so the newlines and indentation MDX leaves between them collapse away
	   instead of printing as blank rows. */
	.terminal-body {
		margin: 0;
		padding: 1.375rem 1.5rem;
		line-height: 2;
		color: var(--text-code);
		white-space: normal;
		overflow-x: auto;
	}

	/* asciinema mode — the player mounts directly into `.terminal-cast` and paints its own terminal
	   grid (see terminal-player.ts). It renders at a fixed font size rather than scaling to fit its
	   container (`fit: "none"` in terminal-player.ts), so a cast wider than the terminal chrome
	   needs its own scrollbar rather than overflowing the card. */
	.terminal-cast {
		line-height: 0;
		overflow-x: auto;
	}

	/* Play/pause + restart live in the title bar rather than a second control row — `margin-inline-
	   start: auto` pushes them to the far end whether or not `cwd` is also present. */
	.terminal-cast-actions {
		display: flex;
		align-items: center;
		margin-inline-start: auto;
	}

	.terminal-button {
		flex: 0 0 auto;
		border: none;
		background: none;
		padding: 0;
		font-size: 0.8125rem;
		line-height: 1;
		color: var(--text-dim);
		cursor: pointer;
		transition: color var(--transition-fast);
		width: 40px;
		height: 40px;
		display: flex;
		justify-content: center;
		align-items: center;
		border-inline-start: 1px solid var(--hairline-08);
	}

	.terminal-button:hover,
	.terminal-button:focus-visible {
		color: var(--text-code);
	}

	.terminal-button:disabled {
		color: var(--text-dim);
		cursor: not-allowed;
		opacity: 0.5;
	}

	@media (max-width: 1023px) {
		.terminal-body {
			padding: 0rem 1.5rem;
			font-size: 0.78125rem;
		}
	}

	@media (max-width: 767px) {
		.terminal-bar {
			gap: 0.625rem;
			padding-inline-start: 0.875rem;
		}

		.terminal-dot {
			width: 8px;
			height: 8px;
		}

		.terminal-body {
			padding: 1.1875rem 1.25rem;
			font-size: 0.6875rem;
		}
	}
</style>

<style is:global>
	/* Overrides for the player's stock CSS, which is injected into <head> at runtime as a plain
	   unlayered stylesheet (see `loadStockPlayerCss` in terminal-player.ts) — unlayered normal-
	   priority rules always beat this component's own scoped styles regardless of specificity, so
	   everything here needs `!important` to win back control. */
	.ap-player {
		--term-color-background: transparent !important;
		/* The stock rule also caps `.ap-player` at `max-width: 100%` and clips it with `overflow:
		   hidden`, cropping a cast wider than its terminal instead of letting it overflow. Lifting
		   both, plus `flex-shrink: 0` since `.ap-wrapper` is a flex container that would otherwise
		   squish it to fit, is what makes `.terminal-cast`'s `overflow-x: auto` (scoped styles below)
		   actually produce a scrollbar rather than cropped or squished content. */
		flex-shrink: 0 !important;
		max-width: none !important;
		overflow: visible !important;
	}

	/* The stock `.ap-wrapper` centers `.ap-player` when the wrapper is wider than the fixed-size
	   content (see `fit: "none"` in terminal-player.ts) — left-align instead, to match a terminal
	   prompt's natural alignment. */
	.ap-wrapper {
		justify-content: flex-start !important;
	}

	/* The stock player renders a large centered play button over the terminal grid before playback
	   starts. Terminal.astro's title-bar play/pause already covers that, so hide it. */
	.ap-overlay-start {
		display: none !important;
	}
</style>