---
// Button in one of three variants — primary (accent fill), secondary (attention outline) or
// ghost (neutral outline):
//
//   <Button href="/tutorials/add-docs-to-your-repo/">read the docs →</Button>
//   <Button variant="ghost" href="https://github.com/acme/acme" target="_blank">github ↗</Button>
//   <Button variant="secondary" data-search-trigger>search everything</Button>
//
// `href` picks the element: with one this renders an <a>, without one a <button> (type="button"
// unless you pass another type). Every other attribute — target/rel, data-*, aria-*, disabled —
// passes straight through, and a `class` of your own is merged rather than dropped, so a caller
// can hang its own positioning on the same element.
//
// The look lives in styles/buttons.css, not here, because ClosingCta styles author-written plain
// <a> tags it never gets to put a class on: both paths have to share one set of declarations.
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"a">, "type"> &
	HTMLAttributes<"button"> & {
		/** Defaults to primary. */
		variant?: "primary" | "secondary" | "ghost";
	};

const { variant = "primary", href, type, class: className, ...rest } = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
	class:list={["btn", "type-md", `btn-${variant}`, className]}
	href={href}
	type={href ? undefined : (type ?? "button")}
	{...rest}
>
	<slot />
</Tag>

<style>

.btn {
	display: inline-flex;
	align-items: center;
	gap: 0.375rem; /* 6px — separates a trailing <kbd> or glyph from the label */
	padding: 0.75rem 1.25rem; /* 12px 20px */
	border-radius: var(--radius-md);
	cursor: pointer;
	/* Every button clears the 48px touch target, with its label centered in the taller box. */
	justify-content: center;
	min-block-size: 48px;
}

/* ---- Variants -----------------------------------------------------------
   Primary carries the brand accent as a fill; secondary and ghost are both outlines, differing
   only in how loud they are — secondary in the attention accent, ghost in the neutral hairline
   the rest of the chrome uses. */
.btn-primary {
	color: var(--bg);
	background-color: var(--button-color, var(--accent));


	&:hover {
		background-color: color-mix(in srgb, var(--button-color, var(--accent)) 90%, transparent);
	}
}

.btn-secondary {
	color: var(--button-color, var(--accent-2));
	border: 1px solid var(--accent-2-border-40);
	background-color: transparent;

	&:hover {
		background-color: color-mix(in srgb, var(--button-color, var(--accent-2)) 6%, transparent);
	}
}

.btn-ghost {
	color: var(--button-color, var(--accent-2));
	border: none;
	background-color: transparent;

	&:hover {
		background-color: color-mix(in srgb, var(--button-color, var(--accent-2)) 6%, transparent);
	}
}

</style>