---
// Full-screen mobile/tablet nav drawer — the hamburger's destination from Header.astro /
// LandingHeader.astro and the mobile breadcrumb pill's "all pages" trigger (see Breadcrumb.astro).
// One instance per page, mounted once from BaseLayout.astro. Renders the same recursive tree as
// SidebarNav.astro (see ../lib/nav.ts) so the two can never drift apart, at touch-sized targets.
import {
	childrenAreNested,
	footerGroups,
	getNavTree,
	isSectionHeading,
	type NavNode,
} from "../lib/nav";
import { externalLinkAttrs, getDocsConfig, isExternalLink } from "../lib/config";
import type { FooterLink } from "../lib/config";
import Wordmark from "./header/Wordmark.astro";

interface Props {
	/** Active page id, when one of the nav entries is the current page. */
	currentId?: string;
	/** Recursion only — set by this component when it calls itself. */
	nodes?: NavNode[];
	/** Recursion only — true for lists rendered inside the indented, bordered column. */
	nested?: boolean;
}

const { currentId, nodes, nested = false } = Astro.props;
const isRoot = nodes === undefined;
const items = nodes ?? (await getNavTree()).nodes;
const config = getDocsConfig();
const base = import.meta.env.BASE_URL;

// Same groups Footer.astro renders as columns (see footerGroups() in lib/nav.ts, including its
// fallback when the config declares no groups), flattened into a single list here since the nav
// sheet's footer isn't grouped, just a row of links. Only computed for the root render, which is
// the only one with a `.nav-sheet__footer` to fill.
let footerLinks: FooterLink[] = [];
if (isRoot) {
	footerLinks = (await footerGroups(config)).flatMap((group) => group.links);
}
---

{
	isRoot ? (
		<dialog id="nav-sheet" class="nav-sheet" aria-label="Site navigation">
			<div class="nav-sheet__header">
				<Wordmark title={config.title} href={base} />
				<button
					type="button"
					class="nav-sheet__close"
					data-nav-sheet-close
					aria-label="Close navigation"
				>
					✕
				</button>
			</div>

			<button type="button" class="nav-sheet__search type-code" data-search-trigger>
				<span class="nav-sheet__search-icon">⌕</span>
				search docs
				<span class="nav-sheet__search-kbd type-2xs">/</span>
			</button>

			<div class="nav-sheet__body dialog-body">
				<nav class="nav-sheet__nav" aria-label="Docs navigation">
					<Astro.self nodes={items} currentId={currentId} />
				</nav>

				<div class="nav-sheet__footer type-sm">
					{
						footerLinks.map((link) => (
							<a
								class="nav-sheet__footer-link"
								href={link.href}
								{...externalLinkAttrs(link.href)}
							>
								{link.label}
								{isExternalLink(link.href) && " ↗"}
							</a>
						))
					}
				</div>
			</div>
		</dialog>
	) : (
		<div class="nav-sheet__list" class:list={{ "is-nested": nested }}>
			{items.map((node) => (
				<>
					{node.href ? (
						<a
							class="nav-sheet__item"
							class:list={{
								"nav-sheet__item--section": isSectionHeading(node),
								"type-label-plain": isSectionHeading(node),
								"is-active": node.id === currentId,
								"active-row": node.id === currentId,
							}}
							href={node.href}
							aria-current={node.id === currentId ? "page" : undefined}
						>
							{node.label}
						</a>
					) : (
						<div class="nav-sheet__label type-label-plain">{node.label}/</div>
					)}
					{node.children.length > 0 && (
						<Astro.self
							nodes={node.children}
							currentId={currentId}
							nested={childrenAreNested(node, nested)}
						/>
					)}
				</>
			))}
		</div>
	)
}

<script>
	import { initNavSheet } from "../scripts/nav-sheet";
	initNavSheet();
</script>

<style>
	.nav-sheet {
		position: fixed;
		inset: 0;
		inline-size: 100vw;
		block-size: 100vh;
		block-size: 100dvh;
		max-inline-size: none;
		max-block-size: none;
		margin: 0;
		padding: 0;
		border: none;
		/* Matches .header-shell-inner's border-inline (HeaderShell.astro) — the sheet is a
		   full-screen fixed overlay, so these hairlines land at the same x-position as the closed
		   header's, keeping the brand/close insets pixel-identical to the real header row. */
		border-inline: 1px solid var(--hairline-08);
		background: var(--surface-page);
		color: var(--ink);
		display: none;
		flex-direction: column;
		/* Overrides the UA stylesheet's default `overflow: auto` on <dialog> — scrolling now lives
		   only on .nav-sheet__body below, so the header and search bar it doesn't wrap can stay
		   pinned in view. */
		overflow: hidden;
	}

	.nav-sheet[open] {
		display: flex;
	}

	.nav-sheet::backdrop {
		background: var(--overlay-scrim);
	}

	@media (min-width: 768px) {
		/* Nav sheet is a mobile-only surface — its trigger buttons are hidden at tablet/desktop
		   widths (see NavToggle.astro / Breadcrumb.astro) now that SidebarNav stays visible down to
		   768px, so it never opens there, but keep it fully inert as a safety net. */
		.nav-sheet {
			display: none !important;
		}
	}

	.nav-sheet__header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-block-size: var(--header-height);
		/* Matches .header-shell-inner's <=767px padding (HeaderShell.astro) exactly — the sheet is
		   mobile-only, so there's no wider breakpoint to account for here. */
		padding: 0 var(--content-pad-x);
		border-block-end: 1px solid var(--hairline-08);
		/* Same background as .header-shell (Header.astro) — this bar visually replaces the site
		   header while the sheet is open, so it must read as identically colored, not a different
		   surface, when the sheet toggles open/closed. */
		background: var(--bg);
		flex-shrink: 0;
	}

	.nav-sheet__close {
		position: relative;
		margin-inline-start: auto;
		display: flex;
		align-items: center;
		/* WCAG tap-target minimum — stays fixed CSS px, doesn't track text zoom. */
		min-block-size: 44px;
		padding: 0;
		background: none;
		border: none;
		color: var(--text-muted);
		font-size: 1.125rem;
		line-height: 1;
		cursor: pointer;
	}

	.nav-sheet__close::after {
		content: "";
		position: absolute;
		inset-block: 0;
		/* Extends the tap-target hit area, not visual layout — stays px alongside the 44px
		   min-block-size above rather than scaling with text zoom. */
		inset-inline: -32px -12px;
	}

	.nav-sheet__search {
		display: flex;
		align-items: center;
		gap: 0.5625rem;
		inline-size: 100%;
		/* WCAG tap-target minimum — stays fixed CSS px, doesn't track text zoom. */
		min-block-size: 48px;
		padding: 0 1.625rem;
		/* Matches Breadcrumb.astro's .breadcrumb-pill background — the two are the same "search /
		   wayfinding bar" affordance at different breakpoints and should read as the same surface. */
		background: var(--white-02);
		border: none;
		border-block-end: 1px solid var(--hairline-06);
		color: var(--text-muted);
		cursor: pointer;
		text-align: start;
		flex-shrink: 0;
	}

	.nav-sheet__search-icon {
		color: var(--accent);
	}

	.nav-sheet__search-kbd {
		margin-inline-start: auto;
		color: var(--text-faint);
	}

	/* Only this region scrolls — .nav-sheet__header and .nav-sheet__search stay flex items above
	   it, pinned in place, instead of scrolling away with the nav tree (previously overflow-y:auto
	   lived on .nav-sheet itself, so the whole column — header and search bar included — scrolled
	   as one block on long nav trees). */
	.nav-sheet__body {
		flex: 1 1 auto;
		min-block-size: 0;
		overflow-y: auto;
	}

	.nav-sheet__nav {
		padding: 0.5rem 0;
	}

	/* Hairline between each top-level section of the tree. Direct-child selectors keep it off
	   nested lists, and :not(:first-child) keeps the first section from doubling up against the
	   search bar's own bottom border. */
	.nav-sheet__nav > .nav-sheet__list > .nav-sheet__item:not(:first-child),
	.nav-sheet__nav > .nav-sheet__list > .nav-sheet__label:not(:first-child) {
		border-block-start: 1px solid var(--hairline-06);
	}

	.nav-sheet__list {
		display: flex;
		flex-direction: column;
	}

	.nav-sheet__label {
		padding: 1rem 1.625rem 0.25rem;
		color: var(--text-dim);
	}

	.nav-sheet__item {
		display: flex;
		align-items: center;
		/* WCAG tap-target minimum — stays fixed CSS px, doesn't track text zoom. */
		min-block-size: 48px;
		padding: 0 1.625rem;
		color: var(--text-muted);
		font-size: 0.90625rem;
	}

	/* Exactly one row — the current page — carries the "you are here" mark
	   (see .active-row in global.css for the shared background/box-shadow). */
	.nav-sheet__item.is-active {
		color: var(--ink);
	}

	/* A root-level group heading (see isSectionHeading()) keeps the dim "section" look even once
	   it's clickable via `sidebar[].link` — only a nested group heading adopts the plain
	   .nav-sheet__item look above. Three-class selector so it reliably wins over the plainer
	   .nav-sheet__item rules regardless of source order. `font-size` is restated here (matching
	   .type-label-plain's own 0.6875rem, see typography.css) rather than left to that class alone:
	   `.nav-sheet__item`'s own font-size above is a plain unlayered declaration that would otherwise
	   always beat `.type-label-plain`'s layered one on this specific property, silently widening
	   section labels back to body size even though the class's family/weight/letter-spacing still
	   apply correctly (pre-existing cascade footgun, fixed here — see this file's `.type-label-plain`
	   adoption on the markup side). */
	.nav-sheet__item.nav-sheet__item--section {
		font-size: 0.6875rem;
		color: var(--text-dim);
	}

	.nav-sheet__item.nav-sheet__item--section.is-active {
		color: var(--ink);
	}

	.nav-sheet__list.is-nested {
		margin-block: 0.125rem 0.25rem;
		margin-inline: 2.5rem 0;
		border-inline-start: 1px solid var(--hairline-10);
	}

	.nav-sheet__list.is-nested .nav-sheet__item {
		/* WCAG tap-target minimum — stays fixed CSS px, doesn't track text zoom. */
		min-block-size: 44px;
		padding: 0 1rem;
		font-size: 0.84375rem;
	}

	/* Same cascade-footgun fix as the root `.nav-sheet__item.nav-sheet__item--section` rule above —
	   this nested-scope font-size is just as unlayered and would otherwise win over
	   .type-label-plain's for a nested section heading too. */
	.nav-sheet__list.is-nested .nav-sheet__item.nav-sheet__item--section {
		font-size: 0.6875rem;
	}

	/* The active sub-page keeps the canonical "you are here" treatment; the -1px pull lets its
	   2px state-accented bar sit on top of the column hairline rather than beside it. */
	.nav-sheet__list.is-nested .nav-sheet__item.is-active {
		margin-inline-start: -1px;
	}

	.nav-sheet__list.is-nested .nav-sheet__label {
		padding: 0.75rem 1rem 0.25rem;
	}

	.nav-sheet__footer {
		display: flex;
		flex-wrap: wrap;
		/* No row gap and symmetric vertical padding — the 48px-tall links carry the vertical rhythm
		   themselves, so wrapped rows stack at the same cadence as the nav list's rows and the space
		   above the first row equals the space below the last. */
		gap: 0 1.5rem;
		border-block-start: 1px solid var(--hairline-08);
		background: var(--surface-panel-1);
		padding: 0.5rem 1.625rem;
		flex-shrink: 0;
	}

	.nav-sheet__footer-link {
		display: flex;
		align-items: center;
		/* WCAG tap-target minimum — stays fixed CSS px, doesn't track text zoom. */
		min-block-size: 48px;
		color: var(--text-muted);
	}

	@media (max-width: 767px) {
		.nav-sheet__search {
			padding: 0 1.125rem;
		}

		.nav-sheet__label {
			padding-inline: 1.125rem;
		}

		.nav-sheet__item {
			padding: 0 1.125rem;
		}

		.nav-sheet__list.is-nested {
			margin-inline-start: 2rem;
		}

		.nav-sheet__list.is-nested .nav-sheet__item,
		.nav-sheet__list.is-nested .nav-sheet__label {
			padding-inline: 0.875rem;
		}

		.nav-sheet__footer {
			padding: 0.5rem 1.125rem;
		}
	}
</style>
