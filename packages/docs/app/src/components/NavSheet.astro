---
// Full-screen mobile/tablet nav drawer — the hamburger's destination from Header.astro /
// LandingHeader.astro and the mobile breadcrumb pill's "all pages" trigger (see Breadcrumb.astro).
// One instance per page, mounted once from BaseLayout.astro. Renders the same recursive tree as
// SidebarNav.astro (see ../lib/nav.ts) so the two can never drift apart, at touch-sized targets.
import { docsEntryHref, getNavTree, type NavNode } from "../lib/nav";
import { getDocsConfig, isExternalLink } from "../lib/config";

interface Props {
	/** Active page id, when one of the nav entries is the current page. */
	currentId?: string;
	/** Recursion only — set by this component when it calls itself. */
	nodes?: NavNode[];
	/** Recursion only — true for lists rendered inside the indented, bordered column. */
	nested?: boolean;
}

const { currentId, nodes, nested = false } = Astro.props;
const isRoot = nodes === undefined;
const items = nodes ?? (await getNavTree()).nodes;
const config = getDocsConfig();
const footerLinks = config.footer?.links ?? [];
const base = import.meta.env.BASE_URL;

// Same rule as SidebarNav: root-level directories keep the flat group treatment; everything
// deeper becomes an indented sub-page column.
function childrenAreNested(node: NavNode): boolean {
	return nested || node.isPage || node.depth > 0;
}

// Same rule as SidebarNav: a root-level sidebar group keeps the dim "section heading" look even
// once it's clickable via `sidebar[].link` — a group nested below the root always looks like a
// plain item.
function isSectionHeading(node: NavNode): boolean {
	return node.depth === 0 && Boolean(node.isGroup);
}
---

{
	isRoot ? (
		<dialog id="nav-sheet" class="nav-sheet" aria-label="Site navigation">
			<div class="nav-sheet__header">
				<a class="nav-sheet__brand" href={base}>
					<span class="glyph">▞</span>
					{config.title}
				</a>
				<button
					type="button"
					class="nav-sheet__close"
					data-nav-sheet-close
					aria-label="Close navigation"
				>
					✕
				</button>
			</div>

			<button type="button" class="nav-sheet__search" data-search-trigger>
				<span class="nav-sheet__search-icon">⌕</span>
				search docs
				<span class="nav-sheet__search-kbd">/</span>
			</button>

			<div class="nav-sheet__body">
				<nav class="nav-sheet__nav" aria-label="Docs navigation">
					<Astro.self nodes={items} currentId={currentId} />
				</nav>

				<div class="nav-sheet__footer">
					{
						footerLinks.length > 0 ? (
							footerLinks.map((link) => (
								<a
									class="nav-sheet__footer-link"
									href={link.href}
									rel={isExternalLink(link.href) ? "noopener noreferrer" : undefined}
									target={isExternalLink(link.href) ? "_blank" : undefined}
								>
									{link.label}
									{isExternalLink(link.href) && " ↗"}
								</a>
							))
						) : (
							<>
								<a class="nav-sheet__footer-link" href={await docsEntryHref()}>
									docs
								</a>
								{config.repoUrl && (
									<a
										class="nav-sheet__footer-link"
										href={config.repoUrl}
										rel="noopener noreferrer"
										target="_blank"
									>
										github ↗
									</a>
								)}
							</>
						)
					}
				</div>
			</div>
		</dialog>
	) : (
		<div class="nav-sheet__list" class:list={{ "is-nested": nested }}>
			{items.map((node) => (
				<>
					{node.href ? (
						<a
							class="nav-sheet__item"
							class:list={{
								"nav-sheet__item--section": isSectionHeading(node),
								"is-active": node.id === currentId,
							}}
							href={node.href}
							aria-current={node.id === currentId ? "page" : undefined}
						>
							{node.label}
						</a>
					) : (
						<div class="nav-sheet__label">{node.label}/</div>
					)}
					{node.children.length > 0 && (
						<Astro.self
							nodes={node.children}
							currentId={currentId}
							nested={childrenAreNested(node)}
						/>
					)}
				</>
			))}
		</div>
	)
}

<script>
	import { initNavSheet } from "../scripts/nav-sheet";
	initNavSheet();
</script>

<style>
	.nav-sheet {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: none;
		background: var(--surface-page);
		color: var(--ink);
		display: none;
		flex-direction: column;
		/* Overrides the UA stylesheet's default `overflow: auto` on <dialog> — scrolling now lives
		   only on .nav-sheet__body below, so the header and search bar it doesn't wrap can stay
		   pinned in view. */
		overflow: hidden;
	}

	.nav-sheet[open] {
		display: flex;
	}

	.nav-sheet::backdrop {
		background: var(--overlay-scrim);
	}

	@media (min-width: 768px) {
		/* Nav sheet is a mobile-only surface — its trigger buttons are hidden at tablet/desktop
		   widths (see NavToggle.astro / Breadcrumb.astro) now that SidebarNav stays visible down to
		   768px, so it never opens there, but keep it fully inert as a safety net. */
		.nav-sheet {
			display: none !important;
		}
	}

	.nav-sheet__header {
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 56px;
		padding: 0 14px 0 26px;
		border-bottom: 1px solid var(--hairline-08);
		/* Same background as .header-shell (Header.astro) — this bar visually replaces the site
		   header while the sheet is open, so it must read as identically colored, not a different
		   surface, when the sheet toggles open/closed. */
		background: var(--bg);
		flex-shrink: 0;
	}

	.nav-sheet__brand {
		display: flex;
		align-items: center;
		gap: 8px;
		font: 500 15px var(--font-mono);
		color: var(--ink);
	}

	.glyph {
		color: var(--accent);
	}

	.nav-sheet__close {
		margin-left: auto;
		min-height: 44px;
		min-width: 44px;
		padding: 0 10px;
		background: none;
		border: none;
		color: var(--text-muted);
		font-size: 18px;
		cursor: pointer;
	}

	.nav-sheet__search {
		display: flex;
		align-items: center;
		gap: 9px;
		width: 100%;
		min-height: 48px;
		padding: 0 26px;
		/* Matches Breadcrumb.astro's .breadcrumb-pill background — the two are the same "search /
		   wayfinding bar" affordance at different breakpoints and should read as the same surface. */
		background: var(--white-02);
		border: none;
		border-bottom: 1px solid var(--hairline-06);
		color: var(--text-muted);
		font: 400 12.5px var(--font-mono);
		cursor: pointer;
		text-align: left;
		flex-shrink: 0;
	}

	.nav-sheet__search-icon {
		color: var(--accent);
	}

	.nav-sheet__search-kbd {
		margin-left: auto;
		color: var(--text-faint);
		font-size: 11px;
	}

	/* Only this region scrolls — .nav-sheet__header and .nav-sheet__search stay flex items above
	   it, pinned in place, instead of scrolling away with the nav tree (previously overflow-y:auto
	   lived on .nav-sheet itself, so the whole column — header and search bar included — scrolled
	   as one block on long nav trees). */
	.nav-sheet__body {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
	}

	.nav-sheet__nav {
		padding: 8px 0 0;
	}

	.nav-sheet__list {
		display: flex;
		flex-direction: column;
	}

	.nav-sheet__label {
		padding: 16px 26px 4px;
		font: 400 11px var(--font-mono);
		letter-spacing: 0.06em;
		color: var(--text-dim);
	}

	.nav-sheet__item {
		display: flex;
		align-items: center;
		min-height: 48px;
		padding: 0 26px;
		color: var(--text-muted);
		font-size: 14.5px;
	}

	/* Exactly one row — the current page — carries the "you are here" mark. */
	.nav-sheet__item.is-active {
		color: var(--ink);
		background: var(--accent-tint-08);
		box-shadow: inset 2px 0 var(--accent);
	}

	/* A root-level group heading (see isSectionHeading()) keeps the dim "section" look even once
	   it's clickable via `sidebar[].link` — only a nested group heading adopts the plain
	   .nav-sheet__item look above. Three-class selector so it reliably wins over the plainer
	   .nav-sheet__item rules regardless of source order. */
	.nav-sheet__item.nav-sheet__item--section {
		font: 400 11px var(--font-mono);
		letter-spacing: 0.06em;
		color: var(--text-dim);
	}

	.nav-sheet__item.nav-sheet__item--section.is-active {
		color: var(--ink);
		background: var(--accent-tint-08);
		box-shadow: inset 2px 0 var(--accent);
	}

	.nav-sheet__list.is-nested {
		margin: 2px 0 4px 40px;
		border-left: 1px solid var(--hairline-10);
	}

	.nav-sheet__list.is-nested .nav-sheet__item {
		min-height: 44px;
		padding: 0 16px;
		font-size: 13.5px;
	}

	/* The active sub-page keeps the canonical "you are here" treatment; the -1px pull lets its
	   2px state-accented bar sit on top of the column hairline rather than beside it. */
	.nav-sheet__list.is-nested .nav-sheet__item.is-active {
		margin-left: -1px;
	}

	.nav-sheet__list.is-nested .nav-sheet__label {
		padding: 12px 16px 4px;
	}

	.nav-sheet__footer {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 24px;
		border-top: 1px solid var(--hairline-08);
		background: var(--surface-panel-1);
		padding: 14px 26px 20px;
		font: 400 12px var(--font-mono);
		flex-shrink: 0;
	}

	.nav-sheet__footer-link {
		display: flex;
		align-items: center;
		min-height: 48px;
		color: var(--text-muted);
	}

	@media (max-width: 767px) {
		.nav-sheet__header {
			padding: 0 14px 0 18px;
		}

		.nav-sheet__search {
			padding: 0 18px;
		}

		.nav-sheet__label {
			padding-left: 18px;
			padding-right: 18px;
		}

		.nav-sheet__item {
			padding: 0 18px;
		}

		.nav-sheet__list.is-nested {
			margin-left: 32px;
		}

		.nav-sheet__list.is-nested .nav-sheet__item,
		.nav-sheet__list.is-nested .nav-sheet__label {
			padding-left: 14px;
			padding-right: 14px;
		}

		.nav-sheet__footer {
			padding: 14px 18px 20px;
		}
	}
</style>
