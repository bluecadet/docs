---
// The one left rail — identical on the landing page, doc pages and 404 (see BaseLayout.astro,
// which is the only place that mounts it). It renders the real docs tree recursively via
// `Astro.self`: pages are links, root-level index-less directories/groups are inert `segment/`
// labels, and children nest at any depth. A group nested below the root always renders as a plain
// link (its own page via `sidebar[].link`, or its first descendant's href — see ../lib/nav.ts).
// Per-page H2 headings are NOT part of this component — that's Toc.astro's job.
//
// Two layers here: `.sidebar-rail` is the grid cell (owns the full-height hairline, so the border
// runs to the bottom of the page even when the nav is short), `.sidebar-nav` is the sticky,
// independently-scrolling nav itself.
import { childrenAreNested, getNavTree, isSectionHeading, type NavNode } from "../lib/nav";
import { getDocsConfig } from "../lib/config";

interface Props {
	/** Active page id, when one of the nav entries is the current page. */
	currentId?: string;
	/** Recursion only — set by this component when it calls itself. */
	nodes?: NavNode[];
	/** Recursion only — true for lists rendered inside the indented, bordered column. */
	nested?: boolean;
}

const { currentId, nodes, nested = false } = Astro.props;
const isRoot = nodes === undefined;
const items = nodes ?? (await getNavTree()).nodes;

// Bottom meta block (isRoot only — see below): `version` first, then each non-empty line of
// `sidebarMeta`. Rendered only when there's something to show.
const config = getDocsConfig();
const metaLines = [
	...(config.version ? [config.version] : []),
	...(config.sidebarMeta ?? "")
		.split("\n")
		.map((line) => line.trim())
		.filter(Boolean),
];
---

{
	isRoot ? (
		// A consumer with no nav-worthy pages (e.g. a single README) and no bottom meta block yields
		// nothing to render — render nothing rather than an empty rail. BaseLayout.astro collapses
		// the now-unoccupied grid column via `.page-body:not(:has(.sidebar-rail))`.
		(items.length > 0 || metaLines.length > 0) && (
			<div class="sidebar-rail">
				<nav id="sidebar-nav" class="sidebar-nav scroll-rail" aria-label="Docs navigation">
					{items.length > 0 && <Astro.self nodes={items} currentId={currentId} />}
					{metaLines.length > 0 && (
						<div class="sidebar-meta type-xs">
							{metaLines.map((line, i) => (
								<>
									{i > 0 && <br />}
									{line}
								</>
							))}
						</div>
					)}
				</nav>
				<script is:inline>
					// Restores the sidebar's scroll position across full page loads (this is a plain MPA — no
					// view transitions). Inline + synchronous so it runs before first paint and sets scrollTop
					// before the browser has anything to show — a deferred/bundled script would paint at
					// scrollTop 0 first and visibly jump. `pagehide` (not `beforeunload`) so this still fires
					// when the page is eligible for the back/forward cache.
					{
						const nav = document.getElementById("sidebar-nav");
						const saved = sessionStorage.getItem("sidebar-scroll");
						if (nav && saved !== null) nav.scrollTop = Number(saved);
						window.addEventListener("pagehide", () => {
							if (nav) sessionStorage.setItem("sidebar-scroll", String(nav.scrollTop));
						});
					}
				</script>
			</div>
		)
	) : (
		<div class="sidebar-list" class:list={{ "is-nested": nested }}>
			{items.map((node) => (
				<>
					{node.href ? (
						<a
							class="sidebar-item link-muted"
							class:list={{
								"sidebar-item--section": isSectionHeading(node),
								"type-sm": isSectionHeading(node),
								"is-active": node.id === currentId,
								"active-row": node.id === currentId,
							}}
							href={node.href}
							aria-current={node.id === currentId ? "page" : undefined}
						>
							{node.label}
						</a>
					) : (
						<div class="sidebar-label type-sm">{node.label}/</div>
					)}
					{node.children.length > 0 && (
						<Astro.self
							nodes={node.children}
							currentId={currentId}
							nested={childrenAreNested(node, nested)}
						/>
					)}
				</>
			))}
		</div>
	)
}

<style>
	.sidebar-rail {
		border-inline-end: 1px solid var(--hairline-08);
		min-inline-size: 0;
	}

	.sidebar-nav {
		padding: var(--content-pad-top) 0 48px;
		font-size: 13.5px;
		line-height: 1.6;
		/* Overrides the shared .scroll-rail thin scrollbar (see global.css) — the sidebar itself
		   should scroll without a visible scrollbar, unlike Toc.astro's .toc-aside. */
		scrollbar-width: none;
	}

	.sidebar-nav::-webkit-scrollbar {
		display: none;
	}

	.sidebar-list {
		display: flex;
		flex-direction: column;
	}

	/* Bottom-of-rail meta block (version/sidebarMeta) — only rendered when configured, after the
	   last nav group. Dimmest text tier: this is the least-emphasis content in the whole rail. */
	.sidebar-meta {
		margin: 34px 34px 0;
		padding-block-start: 24px;
		border-block-start: 1px solid var(--hairline-08);
		line-height: var(--leading-loose);
		color: var(--text-faint);
	}

	.sidebar-label {
		padding: 20px 34px 8px;
		color: var(--text-dim);
	}

	.sidebar-nav > .sidebar-list > .sidebar-label:first-child,
	.sidebar-nav > .sidebar-list > .sidebar-item.sidebar-item--section:first-child {
		padding-block-start: 0;
	}

	.sidebar-item {
		padding: 6px 34px;
	}

	/* Exactly one node in the whole tree — the current page — carries the "you are here" mark
	   (see .active-row in global.css for the shared background/box-shadow). */
	.sidebar-item.is-active {
		color: var(--ink);
	}

	.sidebar-item.is-active:hover {
		color: var(--ink);
	}

	/* A root-level group heading (see isSectionHeading()) keeps the dim mono "section" look even
	   once it's clickable via `sidebar[].link` — only a nested group heading adopts the plain
	   .sidebar-item look above. Three-class selectors here so these reliably win over the plainer
	   .sidebar-item rules regardless of source order. */
	.sidebar-item.sidebar-item--section {
		padding: 20px 34px 8px;
		color: var(--text-dim);
	}

	.sidebar-item.sidebar-item--section:hover {
		color: var(--accent);
	}

	.sidebar-item.sidebar-item--section.is-active {
		color: var(--ink);
	}

	/* Sub-page column: hairline rail, indented, smaller type. */
	.sidebar-list.is-nested {
		margin-block: 4px 6px;
		margin-inline: 36px 0;
		border-inline-start: 1px solid var(--hairline-10);
	}

	/* 2 or more levels of nesting */
	.sidebar-list.is-nested .sidebar-list.is-nested {
		margin-inline: 16px 0;
	}

	.sidebar-list.is-nested .sidebar-item {
		padding: 5px 16px;
	}

	/* The active sub-page keeps the canonical "you are here" treatment; the -1px pull lets its
	   2px state-accented bar sit on top of the column hairline rather than beside it. */
	.sidebar-list.is-nested .sidebar-item.is-active {
		margin-inline-start: -1px;
	}

	.sidebar-list.is-nested .sidebar-label {
		padding: 10px 16px 5px;
		font-size: 11.5px;
	}

	/* Tablet: rail narrows (see BaseLayout.astro's .page-body grid) — a little less padding keeps
	   items from feeling cramped. */
	@media (max-width: 1023px) {
		.sidebar-nav {
			padding: var(--content-pad-top) 0 32px;
			font-size: 13px;
		}
	}

	/* Mobile: no persistent sidebar — NavSheet.astro (hamburger + breadcrumb pill) takes over. */
	@media (max-width: 767px) {
		.sidebar-rail {
			display: none;
		}
	}
</style>
