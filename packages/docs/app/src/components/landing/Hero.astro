---
// Landing hero, composed from the MDX body instead of frontmatter:
//
//   <Hero lead="Same lead text">
//     <Fragment slot="title">Same title text, <em>with its accent clause</em></Fragment>
//     <HeroEyebrows>
//       <HeroEyebrow tone="state">Label</HeroEyebrow>
//     </HeroEyebrows>
//     <HeroInstall>npm i @bluecadet/docs</HeroInstall>
//     <HeroActions>
//       <Button variant="ghost" href="/tutorials/add-docs-to-your-repo/">read the quickstart →</Button>
//     </HeroActions>
//     <HeroNotes>
//       <HeroNote>First note.</HeroNote>
//     </HeroNotes>
//   </Hero>
//
// The title is a named slot, not a prop: the author writes the exact markup that lands in the
// h1, including any <br /> line break and the <em>/<i> that marks the italic accent clause — see
// landing.css's `.landing-heading` for the highlight styling. `lead` stays a prop since its
// typography differs from a plain paragraph. HeroEyebrows, HeroInstall, HeroActions and HeroNotes
// arrive as one flat, opaquely-typed default slot: Astro gives no way to inspect a slotted child's
// component type, so there's no `slot="eyebrows"` to write and no way for Hero to sort children
// into groups itself. Each of those renders exactly one element with a stable class name —
// HeroEyebrows/HeroActions/HeroNotes exist specifically so "several chips", "a row of buttons" and
// "up to two notes" are each a single item here too, not N flat items Hero would have to spread
// across a grid area on its own (grid items sharing one area overlap; see those components'
// comments) — and the :global() rules below place that single element with CSS Grid: a notes column
// beside the lead paragraph from tablet width up, with the install chip and the actions row side by
// side beneath, all stacked into one column on mobile. A lone `<HeroInstall>` is placed the same
// way; `<HeroInstalls>` (plural — a tabbed switcher for more than one install command) is the same
// kind of wrapper as the rest, so the `.hero-install`/`.hero-installs` :global() rules below share
// every grid-area declaration and a bare `<HeroInstall>` keeps working unwrapped.

interface Props {
	lead?: string;
}

const { lead } = Astro.props;
---

<div class="hero landing-band landing-band--flush">
	<slot />

	<h1 class="type-display landing-heading" data-reveal>
		<slot name="title" />
	</h1>

	{lead && <p class="hero-lead type-lead" data-reveal>{lead}</p>}
</div>

<style>
	/* Base (mobile): one column, six stacked rows — eyebrows, title, lead, notes, install,
	   actions. Tablet up (768px) reshapes this into a 4-row/2-column grid: notes moves into its
	   own column beside lead (spanning down through the install/actions row too, so a tall note
	   stack doesn't push the install chip down), and install/actions move back onto one shared
	   row. */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		padding: 6.5rem var(--content-pad-x) 6rem;
	}

	.hero > :global(.hero-eyebrows) {
		grid-row: 1;
		margin-block-end: 2.125rem;
	}

	h1 {
		grid-row: 2;
		margin: 0;
		font-size: 4.25rem;
		line-height: 1.08;
		max-inline-size: 15ch;
		color: var(--ink);
		--heading-accent: var(--accent);
		--reveal-delay: 1;
	}

	/* Font size holds constant across breakpoints — it's the hero's reading copy, not display
	   type, so (unlike the H1) it doesn't step down at tablet/mobile. */
	.hero-lead {
		grid-row: 3;
		margin: 2.25rem 0 0;
		max-inline-size: 58ch;
		color: var(--text-muted);
		text-wrap: balance;
		--reveal-delay: 2;
	}

	.hero > :global(.hero-notes) {
		grid-row: 4;
		margin-block-start: 2.25rem;
	}

	.hero > :global(.hero-install),
	.hero > :global(.hero-installs) {
		grid-row: 5;
		margin-block-start: 3rem;
	}

	.hero > :global(.hero-actions) {
		grid-row: 6;
		margin-block-start: 0.625rem;
	}

	/* Tablet up: two columns (main content + a fixed-width notes column), and two extra
	   content-sized columns carved out of the main column just for the install chip and the
	   actions row, so they sit snugly side by side instead of each stretching to the full
	   main-column width the way a plain 2-column grid would force a lone item to. Eyebrows/title/
	   lead all still span the full main column by spanning across those two extra column lines —
	   nothing about their own width changes, they just cross an internal division that only the
	   install/actions row cares about. */
	@media (min-width: 768px) {
		.hero {
			grid-template-columns:
				[main-start action-1-start] auto
				[action-1-end action-2-start] auto
				[action-2-end] minmax(0, 1fr)
				[main-end notes-start] 12.5rem
				[notes-end];
			align-items: start;
		}

		.hero > :global(.hero-eyebrows) {
			grid-column: main-start / notes-end;
		}

		h1 {
			grid-column: main-start / notes-end;
		}

		.hero-lead {
			grid-column: main-start / main-end;
		}

		.hero > :global(.hero-notes) {
			grid-column: notes-start / notes-end;
			/* Spans exactly the lead row and the install/actions row below (3 and 4) — not a
			   wider span through the unused row 5/6 (mobile's separate install/actions rows) —
			   so it doesn't pull an empty track into the row-sizing and throw off the two rows it
			   actually shares with lead/install. margin-block-start carries over unchanged from the
			   base rule — the notes column keeps the same top offset from the row it starts in
			   whether that row holds lead alone (this breakpoint) or is its own row (mobile). */
			grid-row: 3 / 5;
			align-self: start;
		}

		.hero > :global(.hero-install),
		.hero > :global(.hero-installs) {
			grid-column: action-1-start / action-1-end;
			grid-row: 4;
			align-self: center;
		}

		.hero > :global(.hero-actions) {
			grid-column: action-2-start / action-2-end;
			grid-row: 4;
			align-self: center;
			margin-block-start: 3rem;
			margin-inline-start: 1.5rem;
		}
	}

	@media (min-width: 1024px) {
		.hero {
			grid-template-columns:
				[main-start action-1-start] auto
				[action-1-end action-2-start] auto
				[action-2-end] minmax(0, 1fr)
				[main-end notes-start] 15rem
				[notes-end];
		}
	}

	@media (max-width: 1023px) {
		.hero {
			padding: 5rem var(--content-pad-x) 4.375rem;
		}

		h1 {
			font-size: 3.5rem;
			max-inline-size: none;
		}

		.hero > :global(.hero-install),
		.hero > :global(.hero-installs) {
			margin-block-start: 2.5rem;
		}

		.hero > :global(.hero-actions) {
			margin-block-start: 2.5rem;
		}
	}

	/* Mobile: the install chip becomes a full-width 48px tap target with the actions row stacked
	   below it (HeroActions handles its own stacking; the 48px button height comes from
	   styles/buttons.css). */
	@media (max-width: 767px) {
		.hero {
			padding: 3.625rem var(--content-pad-x) 3.25rem;
		}

		h1 {
			font-size: 2.5rem;
			line-height: 1.12;
			letter-spacing: -0.015em;
		}

		.hero-lead {
			margin-block-start: 1.375rem;
		}

		.hero > :global(.hero-notes) {
			margin-block-start: 1.375rem;
		}

		.hero > :global(.hero-install),
		.hero > :global(.hero-installs) {
			margin-block-start: 1.875rem;
		}

		.hero > :global(.hero-actions) {
			margin-block-start: 0.625rem;
		}
	}
</style>
