---
// One marginalia note inside <HeroNotes>:
//
//   <HeroNotes>
//     <HeroNote>First note.</HeroNote>
//     <HeroNote>Second note.</HeroNote>
//   </HeroNotes>
//
// The first renders in the attention accent, a second (max) renders neutral — chosen with
// :first-of-type/:not(:first-of-type) rather than a prop, since nothing upstream can pass a
// slotted child its index. A third+ is hidden with :nth-of-type instead of dropped from the DOM.
---

<p class="hero-note">
	<slot />
</p>

<style>
	.hero-note {
		margin: 0;
		padding-block: 2px 2px;
		padding-inline: 14px 0;
		font: 400 12px/1.75 var(--font-mono);
		text-wrap: pretty;
	}

	.hero-note:first-of-type {
		border-inline-start: 2px solid var(--accent-2);
		color: var(--accent-2-annotation);
	}

	.hero-note:not(:first-of-type) {
		border-inline-start: 2px solid var(--hairline-14);
		color: var(--text-dim);
	}

	.hero-note:nth-of-type(n + 3) {
		display: none;
	}

	@media (max-width: 767px) {
		.hero-note {
			padding-inline-start: 12px;
			font-size: 11.5px;
			line-height: 1.7;
		}
	}
</style>
