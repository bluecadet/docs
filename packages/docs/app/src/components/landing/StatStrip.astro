---
// Full-bleed stat band for the landing page's MDX body. Wraps a row of <Stat> children:
//
//   <StatStrip>
//     <Stat value="14" label="pages in this site" />
//     <Stat value="0" label="config files required" />
//   </StatStrip>
//
// The `landing-band` class is what tells src/pages/index.astro to let this run edge to edge
// instead of sitting inside the article measure.
---

<div class="landing-band stat-strip" data-reveal-stagger>
	<slot />
</div>

<style>
	.stat-strip {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 48px;
		padding: 44px var(--content-pad-x);
	}

	/* Tablet and mobile both go two-up; four stat cells in one row stops reading as a row well
	   below 1024. */
	@media (max-width: 1023px) {
		.stat-strip {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 30px 60px;
			padding: 36px var(--content-pad-x);
		}
	}

	@media (max-width: 767px) {
		.stat-strip {
			gap: 27px 36px;
			padding: 30px var(--content-pad-x);
		}
	}
</style>

<style is:global>
	/* Enter-motion for StatStrip: fire-once reveal triggered by the IntersectionObserver in
	   index.astro; the trigger script, the `--reveal-*` tokens, and `@keyframes landing-reveal`
	   all live in landing.css. The `[data-landing-reveal]` gate on every rule below means these
	   are inert everywhere but the landing route, so StatStrip stays safe to use on doc pages
	   too. `is:global` (rather than the scoped <style> above) because `.stat` is Stat.astro's own
	   root element, which this component's scope attribute can't reach. */
	@media (prefers-reduced-motion: no-preference) {
		/* .stat cells stagger by `--reveal-index`, one --reveal-stagger step apart — see index.astro's
		   bundled script (the `data-reveal-stagger` attribute on .stat-strip's root above) for where
		   that index gets assigned. */
		[data-landing-reveal] .stat-strip:not(.is-revealed) > .stat {
			opacity: 0;
		}

		[data-landing-reveal] .stat-strip.is-revealed > .stat {
			animation: landing-reveal var(--reveal-duration) var(--reveal-ease) both;
			animation-delay: calc(var(--reveal-stagger) * var(--reveal-index, 0));
		}
	}
</style>
