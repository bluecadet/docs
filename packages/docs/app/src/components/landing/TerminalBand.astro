---
// Full-bleed terminal transcript band for the landing page's MDX body:
//
//   <TerminalBand cwd="~/my-repo" caption="a full build" duration="3.4s">
//     <Line prompt>npx @bluecadet/docs build</Line>
//     <Line label="reading">README.md + docs/ <Ok>✓</Ok></Line>
//   </TerminalBand>
//
// Owns the band chrome — padding, hairline, background, the caption/duration row, and the
// 880px width cap — around the generic `Terminal` window (see `components/Terminal.astro` for
// the window itself, the transcript-vs-cast branch, and the `cast`/`rows`/`cols`/`poster`/`loop`
// prop docs, all passed straight through here).
import Terminal from "../Terminal.astro";

interface Props {
	/** Small caption above the terminal. */
	caption?: string;
	/** Attention-accented figure at the end of the caption row, e.g. a wall-clock duration. */
	duration?: string;
	/** Working-directory label in the terminal's title bar. */
	cwd?: string;
	/** URL/path to an asciicast v2 `.cast` file. When set, renders a player instead of the
	    `<Line>` transcript slot. */
	cast?: string;
	/** Terminal grid size passed to the player; falls back to the cast file's own header. */
	rows?: number;
	cols?: number;
	/** Poster frame shown before playback starts, e.g. `npt:0:03` — passed straight through. */
	poster?: string;
	/** Loops playback when it ends. */
	loop?: boolean;
}

const { caption, duration, ...terminalProps } = Astro.props;
---

<div class="landing-band terminal-band">
	{
		(caption || duration) && (
			<div class="terminal-caption type-xs" data-reveal>
				{caption && <span>{caption}</span>}
				{duration && <span class="terminal-duration">{duration}</span>}
			</div>
		)
	}
	<div class="terminal-band-window" data-reveal>
		<Terminal {...terminalProps}>
			<slot />
		</Terminal>
	</div>
</div>

<style>
	.terminal-band {
		padding: 4rem var(--content-pad-x) 4.5rem;
	}

	.terminal-caption {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-block-end: 1.5rem;
		color: var(--text-dim);
	}

	.terminal-duration {
		color: var(--accent-2);
	}

	.terminal-band-window {
		max-inline-size: 55rem;
		--reveal-delay: 1;
	}

	@media (max-width: 1023px) {
		.terminal-band {
			padding: 2.875rem var(--content-pad-x) 3.375rem;
		}

		.terminal-caption {
			gap: 1.125rem;
			margin-block-end: 1.25rem;
		}
	}

	@media (max-width: 767px) {
		.terminal-band {
			padding: 2.5rem var(--content-pad-x) 2.875rem;
		}

		.terminal-caption {
			gap: 0.9375rem;
			margin-block-end: 1.125rem;
		}
	}
</style>
