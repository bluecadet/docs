---
// Full-bleed terminal transcript band for the landing page's MDX body:
//
//   <TerminalBand cwd="~/my-repo" caption="a full build" duration="3.4s">
//     <Line prompt>npx @bluecadet/docs build</Line>
//     <Line label="reading">README.md + docs/ <Ok>✓</Ok></Line>
//   </TerminalBand>
//
// Owns the band chrome — padding, hairline, background, the caption/duration row, and the
// 880px width cap — around the generic `Terminal` window (see `components/Terminal.astro` for
// the window itself, the transcript-vs-cast branch, and the `cast`/`rows`/`cols`/`poster`/`loop`
// prop docs, all passed straight through here).
import Terminal from "../Terminal.astro";

interface Props {
	/** Small caption above the terminal. */
	caption?: string;
	/** Attention-accented figure at the end of the caption row, e.g. a wall-clock duration. */
	duration?: string;
	/** Working-directory label in the terminal's title bar. */
	cwd?: string;
	/** URL/path to an asciicast v2 `.cast` file. When set, renders a player instead of the
	    `<Line>` transcript slot. */
	cast?: string;
	/** Terminal grid size passed to the player; falls back to the cast file's own header. */
	rows?: number;
	cols?: number;
	/** Poster frame shown before playback starts, e.g. `npt:0:03` — passed straight through. */
	poster?: string;
	/** Loops playback when it ends. */
	loop?: boolean;
}

const { caption, duration, ...terminalProps } = Astro.props;
---

<div class="landing-band terminal-band">
	{
		(caption || duration) && (
			<div class="terminal-caption">
				{caption && <span>{caption}</span>}
				{duration && <span class="terminal-duration">{duration}</span>}
			</div>
		)
	}
	<div class="terminal-band-window">
		<Terminal {...terminalProps}>
			<slot />
		</Terminal>
	</div>
</div>

<style>
	.terminal-band {
		padding: 64px var(--content-pad-x) 72px;
	}

	.terminal-caption {
		display: flex;
		align-items: baseline;
		gap: 16px;
		margin-block-end: 24px;
		font: 400 11.5px var(--font-mono);
		color: var(--text-dim);
	}

	.terminal-duration {
		color: var(--accent-2);
	}

	.terminal-band-window {
		max-inline-size: 880px;
	}

	@media (max-width: 1023px) {
		.terminal-band {
			padding: 46px var(--content-pad-x) 54px;
		}

		.terminal-caption {
			gap: 18px;
			margin-block-end: 20px;
		}
	}

	@media (max-width: 767px) {
		.terminal-band {
			padding: 40px var(--content-pad-x) 46px;
		}

		.terminal-caption {
			gap: 15px;
			margin-block-end: 18px;
			font-size: 11.5px;
		}
	}
</style>

<style is:global>
	/* Enter-motion for TerminalBand: fire-once reveal triggered by the IntersectionObserver in
	   index.astro; the trigger script, the `--reveal-*` tokens, and `@keyframes landing-reveal`
	   all live in landing.css. The `[data-landing-reveal]` gate on every rule below means these
	   are inert everywhere but the landing route, so TerminalBand stays safe to use on doc pages
	   too. `is:global` for consistency with the rest of the landing components' motion blocks,
	   all of which key off the same gate attribute and keyframe defined in landing.css. */
	@media (prefers-reduced-motion: no-preference) {
		/* caption row, then the terminal window one step later. */
		[data-landing-reveal] .terminal-band:not(.is-revealed) > * {
			opacity: 0;
		}

		[data-landing-reveal] .terminal-band.is-revealed > * {
			animation: landing-reveal var(--reveal-duration) var(--reveal-ease) both;
		}

		[data-landing-reveal] .terminal-band.is-revealed > .terminal-band-window {
			animation-delay: var(--reveal-stagger);
		}
	}
</style>
