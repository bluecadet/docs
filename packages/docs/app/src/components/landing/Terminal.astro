---
// Full-bleed terminal transcript band for the landing page's MDX body:
//
//   <Terminal cwd="~/my-repo" caption="a full build" duration="3.4s">
//     <Line prompt>npx @bluecadet/docs build</Line>
//     <Line label="reading">README.md + docs/ <Ok>✓</Ok></Line>
//   </Terminal>
//
// Lines are <Line> elements rather than raw indented text because MDX parses the children of a
// JSX block as markdown, which would collapse the leading whitespace that a transcript depends
// on. <Line label> restores the aligned label column with a mono `ch` measure instead.
//
// Passing `cast` swaps the transcript slot for a real asciinema recording (asciicast v2) played
// back through `asciinema-player`, with a custom control bar styled to match the terminal chrome
// instead of the player's stock one (see `terminal-player.ts` and the `.asciinema-player-theme-docs`
// theme in `styles/asciinema-theme.css`). The two modes are mutually exclusive — `cast` set means
// `<Line>` children are ignored. Kept deliberately small: no volume/fullscreen/speed controls, no
// marker support. Consumers who need those should reach for the player directly.
interface Props {
	/** Working-directory label in the terminal's title bar. */
	cwd?: string;
	/** Small caption above the terminal. */
	caption?: string;
	/** Attention-accented figure at the end of the caption row, e.g. a wall-clock duration. */
	duration?: string;
	/** URL/path to an asciicast v2 `.cast` file. When set, renders a player instead of the
	    `<Line>` transcript slot. See the CLI's asset sync (`sync.ts`) for where a consumer repo's
	    `.cast` files under `docs/` end up published — `app/public/` itself is wiped on every
	    sync, so files must live in the consumer repo's docs tree, not this package. */
	cast?: string;
	/** Terminal grid size passed to the player; falls back to the cast file's own header. */
	rows?: number;
	cols?: number;
	/** Poster frame shown before playback starts, e.g. `npt:0:03` — passed straight through. */
	poster?: string;
	/** Loops playback when it ends. */
	loop?: boolean;
}

const { cwd, caption, duration, cast, rows, cols, poster, loop } = Astro.props;
---

<div class="landing-band terminal-band">
	{
		(caption || duration) && (
			<div class="terminal-caption">
				{caption && <span>{caption}</span>}
				{duration && <span class="terminal-duration">{duration}</span>}
			</div>
		)
	}
	<div class="terminal">
		<div class="terminal-bar">
			<span class="terminal-dots" aria-hidden="true">
				<span class="terminal-dot terminal-dot-1"></span>
				<span class="terminal-dot terminal-dot-2"></span>
				<span class="terminal-dot terminal-dot-3"></span>
			</span>
			{cwd && <span class="terminal-cwd">{cwd}</span>}
		</div>
		{
			cast ? (
				<div class="terminal-player">
					<div
						class="terminal-cast"
						data-terminal-cast={cast}
						data-terminal-rows={rows}
						data-terminal-cols={cols}
						data-terminal-poster={poster}
						data-terminal-loop={loop ? "true" : undefined}
					/>
					<div class="terminal-controls">
						<button type="button" class="terminal-play" data-terminal-play aria-label="Play">
							▶
						</button>
						<div class="terminal-progress" data-terminal-progress>
							<span class="terminal-progress-track">
								<span class="terminal-progress-fill" data-terminal-fill />
							</span>
						</div>
						<span class="terminal-time" data-terminal-time>
							0:00 / 0:00
						</span>
					</div>
				</div>
			) : (
				<pre class="terminal-body"><slot /></pre>
			)
		}
	</div>
</div>

{
	cast && (
		<script>
			import "../../scripts/terminal-player";
		</script>
	)
}

<style>
	.terminal-band {
		padding: 64px var(--content-pad-x) 72px;
		border-block-end: 1px solid var(--hairline-08);
		background: var(--surface-panel-2);
	}

	.terminal-caption {
		display: flex;
		align-items: baseline;
		gap: 16px;
		margin-block-end: 24px;
		font: 400 11.5px var(--font-mono);
		color: var(--text-dim);
	}

	.terminal-duration {
		color: var(--accent-2);
	}

	.terminal {
		max-width: 880px;
		border: 1px solid var(--hairline-10);
		border-radius: var(--radius-md);
		background: var(--surface-code);
		overflow: hidden;
	}

	.terminal-bar {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 11px 16px;
		border-block-end: 1px solid var(--hairline-08);
		font: 400 11px var(--font-mono);
		color: var(--text-dim);
	}

	.terminal-dots {
		display: flex;
		gap: 5px;
	}

	.terminal-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}

	.terminal-dot-1 {
		background: var(--accent);
	}

	.terminal-dot-2 {
		background: var(--accent-2);
	}

	.terminal-dot-3 {
		background: var(--terminal-dot-3);
	}

	/* `white-space: normal` on the <pre> itself, `pre` on each <Line> (see Line.astro): the lines
	   are block boxes, so the newlines and indentation MDX leaves between them collapse away
	   instead of printing as blank rows. */
	.terminal-body {
		margin: 0;
		padding: 22px 24px;
		font: 400 13px/2 var(--font-mono);
		color: var(--text-code);
		white-space: normal;
		overflow-x: auto;
	}

	/* asciinema mode — the player mounts into `.terminal-cast` (see terminal-player.ts) and paints
	   its own terminal grid; `.terminal-controls` is a second row below it standing in for the
	   player's stock control bar (disabled via `controls: false`), matching the transcript's
	   horizontal rhythm. */
	.terminal-cast {
		line-height: 0;
	}

	.terminal-controls {
		display: flex;
		align-items: center;
		gap: 14px;
		padding-block: 10px;
		padding-inline: 24px;
		border-block-start: 1px solid var(--hairline-08);
	}

	.terminal-play {
		flex: 0 0 auto;
		border: none;
		background: none;
		padding: 0;
		font: 400 11px var(--font-mono);
		color: var(--text-dim);
		cursor: pointer;
		transition: color var(--transition-fast);
	}

	.terminal-play:hover,
	.terminal-play:focus-visible {
		color: var(--text-code);
	}

	.terminal-play:disabled {
		color: var(--text-dim);
		cursor: not-allowed;
		opacity: 0.5;
	}

	.terminal-progress {
		flex: 1 1 auto;
		padding-block: 6px;
		cursor: pointer;
	}

	.terminal-progress-track {
		display: block;
		position: relative;
		block-size: 2px;
		background: var(--hairline-10);
		border-radius: var(--radius-sm);
	}

	.terminal-progress-fill {
		display: block;
		position: absolute;
		inset-block: 0;
		inset-inline-start: 0;
		inline-size: 0%;
		background: var(--accent);
		border-radius: var(--radius-sm);
	}

	.terminal-time {
		flex: 0 0 auto;
		font: 400 11px var(--font-mono);
		color: var(--text-dim);
		font-variant-numeric: tabular-nums;
	}

	/* Smallest honest failure state for a cast that fails to load (see terminal-player.ts) — amber
	   is the site's attention accent, reused here rather than introducing a dedicated error token. */
	.terminal-time-error {
		color: var(--accent-2);
	}

	@media (max-width: 1023px) {
		.terminal-band {
			padding: 46px var(--content-pad-x) 54px;
		}

		.terminal-caption {
			gap: 18px;
			margin-block-end: 20px;
		}

		.terminal-body {
			padding: 22px 24px;
			font-size: 12.5px;
		}

		.terminal-controls {
			padding-inline: 24px;
		}
	}

	@media (max-width: 767px) {
		.terminal-band {
			padding: 40px var(--content-pad-x) 46px;
		}

		.terminal-caption {
			gap: 15px;
			margin-block-end: 18px;
			font-size: 11.5px;
		}

		.terminal-bar {
			gap: 10px;
			padding: 10px 14px;
			font-size: 11px;
		}

		.terminal-dot {
			width: 8px;
			height: 8px;
		}

		.terminal-body {
			padding: 19px 20px;
			font-size: 11px;
		}

		.terminal-controls {
			gap: 10px;
			padding-block: 9px;
			padding-inline: 20px;
		}

		.terminal-time {
			font-size: 10.5px;
		}
	}
</style>
