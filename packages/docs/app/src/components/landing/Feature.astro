---
// One numbered pillar inside <Features>. The numeral is not authored — it's a CSS counter, so
// reordering or adding pillars never leaves a stale "03" behind.
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class="feature">
	<div class="feature-title">{title}</div>
	<div class="feature-body"><slot /></div>
</div>

<style>
	/* Dividers are expressed as "which cells are not on the outer edge" rather than as a fixed
	   3-cell assumption, so a fourth or fifth pillar still rules correctly. */
	.feature {
		padding: 56px 44px 64px;
		counter-increment: landing-feature;
	}

	.feature::before {
		content: counter(landing-feature, decimal-leading-zero);
		display: block;
		margin-bottom: 24px;
		font: 300 48px/1 var(--font-serif);
		color: var(--accent);
	}

	/* Sage / amber / sage — state, attention, state. */
	.feature:nth-child(even)::before {
		color: var(--accent-2);
	}

	.feature-title {
		margin-bottom: 14px;
		font: 500 20px/1.4 var(--font-serif);
		color: var(--ink);
	}

	.feature-body {
		font-size: 14px;
		line-height: 1.8;
		color: var(--text-muted);
		text-wrap: pretty;
	}

	/* `color` here isn't decorative — without it, `.prose p` (article.css, tied on specificity
	   with any bare `p` selector) would set every feature body paragraph to the article's body
	   color instead of this band's dimmer `--text-muted`. */
	.feature-body :global(p) {
		margin: 0;
		color: inherit;
	}

	/* 3-up. Outer-column cells get the shared page gutter (--content-pad-x) on their outside edge
	   instead of the 44px between-cell padding, so the grid's outer edges line up with every other
	   band's gutter. */
	@media (min-width: 1024px) {
		.feature:not(:nth-child(3n)):not(:last-child) {
			border-right: 1px solid var(--hairline-08);
		}

		.feature:nth-child(n + 4) {
			border-top: 1px solid var(--hairline-08);
		}

		.feature:nth-child(3n + 1) {
			padding-left: var(--content-pad-x);
		}

		.feature:nth-child(3n) {
			padding-right: var(--content-pad-x);
		}
	}

	/* 2-up */
	@media (max-width: 1023px) {
		.feature {
			padding: 46px 42px 52px;
		}

		.feature:nth-child(odd):not(:last-child) {
			border-right: 1px solid var(--hairline-08);
		}

		.feature:nth-child(n + 3) {
			border-top: 1px solid var(--hairline-08);
		}

		.feature:nth-child(odd) {
			padding-left: var(--content-pad-x);
		}

		.feature:nth-child(even) {
			padding-right: var(--content-pad-x);
		}

		.feature::before {
			margin-bottom: 18px;
			font-size: 42px;
		}

		.feature-title {
			font-size: 19px;
			margin-bottom: 10px;
		}
	}

	/* 1-up */
	@media (max-width: 767px) {
		.feature {
			padding: 42px var(--content-pad-x) 46px;
		}

		.feature:nth-child(odd):not(:last-child) {
			border-right: none;
		}

		.feature:nth-child(n + 2) {
			border-top: 1px solid var(--hairline-08);
		}

		.feature::before {
			font-size: 36px;
		}
	}
</style>
