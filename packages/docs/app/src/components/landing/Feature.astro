---
// One numbered pillar inside <Features>. The numeral is not authored — it's a CSS counter, so
// reordering or adding pillars never leaves a stale "03" behind.
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class="feature">
	<div class="feature-title type-heading">{title}</div>
	<div class="feature-body type-prose-sm"><slot /></div>
</div>

<style>
	/* Dividers and outer-edge gutter alignment are owned by the .landing-grid-3 utility
	   (src/styles/landing.css) on the .features container — this component only owns its own
	   content padding. */
	.feature {
		padding: 56px 44px 64px;
		counter-increment: landing-feature;
	}

	.feature::before {
		content: counter(landing-feature, decimal-leading-zero);
		display: block;
		margin-block-end: 24px;
		font: 300 48px/1 var(--font-serif);
		color: var(--accent);
	}

	/* State / attention / state. */
	.feature:nth-child(even)::before {
		color: var(--accent-2);
	}

	.feature-title {
		margin-block-end: 14px;
		color: var(--ink);
	}

	.feature-body {
		color: var(--text-muted);
		text-wrap: balance;
	}

	/* 2-up */
	@media (max-width: 1023px) {
		.feature {
			padding: 46px 42px 52px;
		}

		.feature::before {
			margin-block-end: 18px;
			font-size: 42px;
		}

		.feature-title {
			margin-block-end: 10px;
		}
	}

	/* 1-up. Inline padding is owned by the .landing-grid-3 utility at this breakpoint (it applies
	   the full gutter on both sides of a single column), so this only keeps the block padding. */
	@media (max-width: 767px) {
		.feature {
			padding: 42px 0 46px;
		}

		.feature::before {
			font-size: 36px;
		}
	}
</style>
