---
// Landing-only hero. The headline + lead come from the landing entry's title/description; the
// eyebrow chips, install-command chip and marginalia notes come from optional landing frontmatter
// (see src/content.config.ts). Each of those three renders nothing when its field is absent, so a
// repo with a plain README still gets the plain headline-and-lead hero.
import { splitAccent } from "../../lib/text";

interface Eyebrow {
	label: string;
	tone: "state" | "attention" | "neutral";
}

interface Props {
	title: string;
	lead?: string;
	/** Up to 3 chips above the headline. */
	eyebrows?: Eyebrow[];
	/** Copyable shell command, e.g. `npx @bluecadet/docs build`. */
	installCommand?: string;
	/** Marginalia beside the lead. First is the attention accent, a second is neutral. */
	notes?: string[];
	/** Target for the "read the quickstart" link beside the install chip. */
	quickstartHref?: string;
}

const { title, lead, eyebrows, installCommand, notes, quickstartHref } = Astro.props;

// Only split into the design's two-clause hero treatment (plain line + italic accent line) when
// the title has a natural clause break; a bare title (the common case for real doc collections)
// renders as a single plain line rather than faking one.
const { before: firstClause, accent: secondClause } = splitAccent(title, ", ");

const chips = eyebrows?.slice(0, 3) ?? [];
const marginalia = notes?.filter((note) => note.trim().length > 0).slice(0, 2) ?? [];
---

<div class="hero">
	{
		chips.length > 0 && (
			<div class="hero-eyebrows">
				{chips.map((chip) => (
					<span class:list={["eyebrow", `eyebrow-${chip.tone}`]}>{chip.label}</span>
				))}
			</div>
		)
	}

	<h1>
		{firstClause}
		{secondClause && (
			<>
				<br />
				<span class="hero-accent">{secondClause}</span>
			</>
		)}
	</h1>

	{lead && <p class="hero-lead">{lead}</p>}

	{
		marginalia.length > 0 && (
			<div class="hero-notes">
				{marginalia.map((note, i) => (
					<p class:list={["hero-note", i === 0 ? "hero-note-attention" : "hero-note-neutral"]}>{note}</p>
				))}
			</div>
		)
	}

	{
		installCommand && (
			<div class="hero-actions">
				<div class="install">
					<span class="install-prompt">$</span>
					<code class="install-command">{installCommand}</code>
					<button
						class="install-copy"
						type="button"
						aria-label="Copy install command"
						data-install-copy={installCommand}
					>
						⧉
					</button>
				</div>
				{quickstartHref && (
					<a class="hero-quickstart" href={quickstartHref}>
						read the quickstart →
					</a>
				)}
			</div>
		)
	}
</div>

<script>
	// Copy-to-clipboard for the hero install chip. Swaps the glyph for a checkmark for a beat so
	// the click has visible feedback; falls back silently when the Clipboard API is unavailable
	// (insecure origins), leaving the command selectable by hand.
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-install-copy]")) {
		button.addEventListener("click", async () => {
			const command = button.dataset.installCopy;
			if (!command) return;
			try {
				await navigator.clipboard.writeText(command);
			} catch {
				return;
			}
			button.textContent = "✓";
			button.classList.add("install-copy--copied");
			window.setTimeout(() => {
				button.textContent = "⧉";
				button.classList.remove("install-copy--copied");
			}, 1400);
		});
	}
</script>

<style>
	/* Named grid areas, rather than nested wrappers, are what let the marginalia column move
	   between two positions without duplicating the markup: below the lead on mobile, beside
	   the lead from tablet up. */
	.hero {
		display: grid;
		grid-template-areas: "eyebrows" "title" "lead" "notes" "actions";
		grid-template-columns: minmax(0, 1fr);
		padding: 104px var(--content-pad-x) 96px;
	}

	.hero-eyebrows {
		grid-area: eyebrows;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		margin-block-end: 34px;
	}

	.eyebrow {
		padding: 4px 9px;
		border-radius: var(--radius-sm);
		font: 400 11.5px var(--font-mono);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.eyebrow-state {
		color: var(--bg);
		background: var(--accent);
	}

	.eyebrow-attention {
		color: var(--accent-2);
		border: 1px solid var(--accent-2-border-40);
	}

	.eyebrow-neutral {
		color: var(--text-dim);
		border: 1px solid var(--hairline-12);
	}

	h1 {
		grid-area: title;
		margin: 0;
		font: 300 68px/1.08 var(--font-serif);
		max-inline-size: 15ch;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.hero-accent {
		font-style: italic;
		color: var(--accent);
	}

	/* Font size holds constant across breakpoints — it's the hero's reading copy, not display
	   type, so (unlike the H1) it doesn't step down at tablet/mobile. */
	.hero-lead {
		grid-area: lead;
		margin: 36px 0 0;
		max-inline-size: 58ch;
		color: var(--text-muted);
		font-size: 17px;
		line-height: 1.8;
		text-wrap: pretty;
	}

	.hero-notes {
		grid-area: notes;
		display: flex;
		flex-direction: column;
		gap: 28px;
		margin-block-start: 26px;
	}

	.hero-note {
		margin: 0;
		padding-block: 2px 2px;
		padding-inline: 14px 0;
		font: 400 12px/1.75 var(--font-mono);
		text-wrap: pretty;
	}

	.hero-note-attention {
		border-inline-start: 2px solid var(--accent-2);
		color: var(--accent-2-annotation);
	}

	.hero-note-neutral {
		border-inline-start: 2px solid var(--hairline-14);
		color: var(--text-dim);
	}

	/* Bottom spacing before the next band comes from `.hero`'s own bottom padding, not a margin
	   here — the actions row isn't reliably the tallest column (the notes column can run longer),
	   so a margin on it alone can't be trusted to set the hero's total height. */
	.hero-actions {
		grid-area: actions;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 24px;
		margin: 48px 0 0;
	}

	.install {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 11px 16px;
		border: 1px solid var(--accent-border-30);
		border-radius: var(--radius-md);
		background: var(--accent-tint-05);
		font: 400 13.5px var(--font-mono);
		color: var(--text-code);
	}

	.install-prompt {
		color: var(--accent);
	}

	.install-command {
		font: inherit;
		white-space: nowrap;
	}

	.install-copy {
		background: none;
		border: none;
		color: var(--accent);
		cursor: pointer;
		font: 400 13px var(--font-mono);
		padding-block: 0 0;
		padding-inline: 8px 0;
	}

	.install-copy--copied {
		color: var(--accent-2);
	}

	.hero-quickstart {
		font: 400 13px var(--font-mono);
		color: var(--accent);
	}

	/* Tablet up: the notes column moves alongside the lead paragraph. It spans the actions row too
	   so a tall stack of notes pushes nothing down — the install chip still sits directly under
	   the lead, as in the design. */
	@media (min-width: 768px) {
		.hero {
			grid-template-areas: "eyebrows eyebrows" "title title" "lead notes" "actions notes";
			grid-template-columns: minmax(0, 1fr) 200px;
			column-gap: 36px;
			align-items: start;
		}

		.hero-notes {
			align-self: start;
		}
	}

	@media (min-width: 1024px) {
		.hero {
			grid-template-columns: minmax(0, 1fr) 240px;
			column-gap: 48px;
		}
	}

	@media (max-width: 1023px) {
		.hero {
			padding: 80px var(--content-pad-x) 70px;
		}

		h1 {
			font-size: 56px;
			max-inline-size: none;
		}

		.hero-actions {
			gap: 18px;
			margin: 40px 0 0;
		}
	}

	/* Mobile: the chip becomes a full-width 48px tap target and the quickstart link a button. */
	@media (max-width: 767px) {
		.hero {
			padding: 58px var(--content-pad-x) 52px;
		}

		.hero-eyebrows {
			gap: 7px;
			margin-block-end: 24px;
		}

		.eyebrow {
			padding: 3px 7px;
			font-size: 10.5px;
			letter-spacing: 0.12em;
		}

		h1 {
			font-size: 40px;
			line-height: 1.12;
			letter-spacing: -0.015em;
		}

		.hero-lead {
			margin-block-start: 22px;
		}

		.hero-notes {
			gap: 16px;
			margin-block-start: 22px;
		}

		.hero-note {
			padding-inline-start: 12px;
			font-size: 11.5px;
			line-height: 1.7;
		}

		.hero-actions {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			gap: 10px;
			margin: 30px 0 0;
		}

		.install {
			min-block-size: 48px;
			padding: 0 14px;
			font-size: 12.5px;
			overflow-x: auto;
		}

		.install-copy {
			margin-inline-start: auto;
		}

		.hero-quickstart {
			display: flex;
			align-items: center;
			justify-content: center;
			min-block-size: 48px;
			border: 1px solid var(--hairline-14);
			border-radius: var(--radius-md);
			font-size: 12.5px;
		}
	}
</style>
