---
// Full-bleed glyph-marked list band for the landing page's MDX body — originally the "here is
// what this does not do" list, generalized to any glyph-per-row list:
//
//   <GlyphList title="Things this will not do" accent="will not" intro="A short list…">
//     <GlyphItem lead="Replace your site.">…</GlyphItem>
//     <GlyphItem glyph="✓" color="var(--accent)" lead="Get out of the way.">…</GlyphItem>
//   </GlyphList>
//
// `accent` is an optional substring of `title` that renders in italic attention accent — the
// design's attention treatment on the one clause that carries the point.
import { splitAccent } from "../../lib/text";

interface Props {
	title: string;
	/** Substring of `title` to italicise in the attention accent. Ignored when it isn't found in `title`. */
	accent?: string;
	/** Dim paragraph under the heading. */
	intro?: string;
}

const { title, accent, intro } = Astro.props;

const { before, accent: highlight, after } = splitAccent(title, accent, true);
---

<div class="landing-band glyph-list">
	<div class="glyph-list-head">
		<h2 class="glyph-list-title type-title">
			{before}{highlight && <span class="glyph-list-accent">{highlight}</span>}{after}
		</h2>
		{intro && <p class="glyph-list-intro type-prose-sm">{intro}</p>}
	</div>
	<div class="glyph-list-items" data-reveal-stagger>
		<slot />
	</div>
</div>

<style>
	.glyph-list {
		display: grid;
		grid-template-columns: 360px minmax(0, 1fr);
		gap: 88px;
		padding: 80px var(--content-pad-x) 88px;
	}

	.glyph-list-title {
		margin: 0 0 18px;
		color: var(--ink);
	}

	.glyph-list-accent {
		font-style: italic;
		color: var(--accent-2);
	}

	.glyph-list-intro {
		margin: 0;
		color: var(--text-dim);
		text-wrap: balance;
	}

	.glyph-list-items {
		display: flex;
		flex-direction: column;
	}

	/* Tablet and mobile stack: the heading column sits above the list. */
	@media (max-width: 1023px) {
		.glyph-list {
			grid-template-columns: minmax(0, 1fr);
			gap: 15px;
			padding: 56px var(--content-pad-x) 64px;
		}

		.glyph-list-title {
			margin-block-end: 12px;
			font-size: 30px;
		}

		.glyph-list-intro {
			max-inline-size: 520px;
		}
	}

	@media (max-width: 767px) {
		.glyph-list {
			gap: 12px;
			padding: 48px var(--content-pad-x) 50px;
		}

		.glyph-list-title {
			font-size: 28px;
		}
	}
</style>

<style is:global>
	/* Enter-motion for GlyphList: fire-once reveal triggered by the IntersectionObserver in
	   index.astro; the trigger script, the `--reveal-*` tokens, and `@keyframes landing-reveal`
	   all live in landing.css. The `[data-landing-reveal]` gate on every rule below means these
	   are inert everywhere but the landing route, so GlyphList stays safe to use on doc pages
	   too. `is:global` (rather than the scoped <style> above) because `.glyph-item` is
	   GlyphItem.astro's own root element, which this component's scope attribute can't reach. */
	@media (prefers-reduced-motion: no-preference) {
		/* The heading/intro column settles as one unit at delay 0; the glyph rows stagger below by
		   `--reveal-index` (assigned to .glyph-list-items' children — see its `data-reveal-stagger`
		   attribute above and index.astro's bundled script), one --reveal-stagger step apart, offset
		   by one extra step (`+ 1`) so the first row still lands one step after the head, matching the
		   second-group offset every other multi-part band uses. */
		[data-landing-reveal] .glyph-list:not(.is-revealed) > .glyph-list-head {
			opacity: 0;
		}

		[data-landing-reveal] .glyph-list.is-revealed > .glyph-list-head {
			animation: landing-reveal var(--reveal-duration) var(--reveal-ease) both;
		}

		[data-landing-reveal] .glyph-list:not(.is-revealed) .glyph-item {
			opacity: 0;
		}

		[data-landing-reveal] .glyph-list.is-revealed .glyph-item {
			animation: landing-reveal var(--reveal-duration) var(--reveal-ease) both;
			animation-delay: calc(var(--reveal-stagger) * (var(--reveal-index, 0) + 1));
		}
	}
</style>
