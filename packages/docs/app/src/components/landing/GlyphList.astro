---
// Full-bleed glyph-marked list band for the landing page's MDX body — originally the "here is
// what this does not do" list, generalized to any glyph-per-row list:
//
//   <GlyphList title="Things this will not do" accent="will not" intro="A short list…">
//     <GlyphItem lead="Replace your site.">…</GlyphItem>
//     <GlyphItem glyph="✓" color="var(--accent)" lead="Get out of the way.">…</GlyphItem>
//   </GlyphList>
//
// `accent` is an optional substring of `title` that renders in italic attention accent — the
// design's attention treatment on the one clause that carries the point.
interface Props {
	title: string;
	/** Substring of `title` to italicise in the attention accent. Ignored when it isn't found in `title`. */
	accent?: string;
	/** Dim paragraph under the heading. */
	intro?: string;
}

const { title, accent, intro } = Astro.props;

const at = accent ? title.indexOf(accent) : -1;
const before = at === -1 ? title : title.slice(0, at);
const after = at === -1 ? "" : title.slice(at + (accent?.length ?? 0));
---

<div class="landing-band glyph-list">
	<div class="glyph-list-head">
		<h2 class="glyph-list-title">
			{before}{at !== -1 && <span class="glyph-list-accent">{accent}</span>}{after}
		</h2>
		{intro && <p class="glyph-list-intro">{intro}</p>}
	</div>
	<div class="glyph-list-items">
		<slot />
	</div>
</div>

<style>
	.glyph-list {
		display: grid;
		grid-template-columns: 360px minmax(0, 1fr);
		gap: 88px;
		padding: 80px var(--content-pad-x) 88px;
		border-bottom: 1px solid var(--hairline-08);
		background: var(--surface-panel-2);
	}

	/* This band's own heading never wants article.css's `.prose h2` hairline treatment — but this
	   div lives inside `.prose` (the landing MDX body), so `padding-bottom`/`border-bottom` must
	   be reset explicitly rather than left unset, or `.prose h2` supplies them uncontested (a
	   class selector beats an unset property regardless of specificity). */
	.glyph-list-title {
		margin: 0 0 18px;
		padding-bottom: 0;
		font: 400 32px/1.2 var(--font-serif);
		color: var(--ink);
		border-bottom: none;
	}

	.glyph-list-accent {
		font-style: italic;
		color: var(--accent-2);
	}

	.glyph-list-intro {
		margin: 0;
		font-size: 14px;
		line-height: 1.8;
		color: var(--text-dim);
		text-wrap: pretty;
	}

	.glyph-list-items {
		display: flex;
		flex-direction: column;
	}

	/* Tablet and mobile stack: the heading column sits above the list. */
	@media (max-width: 1023px) {
		.glyph-list {
			grid-template-columns: minmax(0, 1fr);
			gap: 15px;
			padding: 56px var(--content-pad-x) 64px;
		}

		.glyph-list-title {
			margin-bottom: 12px;
			font-size: 30px;
		}

		.glyph-list-intro {
			max-width: 520px;
		}
	}

	@media (max-width: 767px) {
		.glyph-list {
			gap: 12px;
			padding: 48px var(--content-pad-x) 50px;
		}

		.glyph-list-title {
			font-size: 28px;
		}
	}
</style>
