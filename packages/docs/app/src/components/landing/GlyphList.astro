---
// Full-bleed glyph-marked list band for the landing page's MDX body — originally the "here is
// what this does not do" list, generalized to any glyph-per-row list:
//
//   <GlyphList intro="A short list…">
//     <Fragment slot="title">Things this <em>will not</em> do</Fragment>
//     <GlyphItem lead="Replace your site.">…</GlyphItem>
//     <GlyphItem glyph="✓" color="var(--accent)" lead="Get out of the way.">…</GlyphItem>
//   </GlyphList>
//
// The title is a named slot: the author marks the clause that carries the point with a literal
// <em>/<i>, which lands in the design's italic attention accent (landing.css's `.landing-heading`)
// — no separate prop, no substring matching.
interface Props {
	/** Dim paragraph under the heading. */
	intro?: string;
}

const { intro } = Astro.props;
---

<div class="landing-band glyph-list">
	<div class="glyph-list-head" data-reveal>
		<h2 class="glyph-list-title type-title landing-heading">
			<slot name="title" />
		</h2>
		{intro && <p class="glyph-list-intro type-prose-sm">{intro}</p>}
	</div>
	<div class="glyph-list-items" data-reveal-stagger>
		<slot />
	</div>
</div>

<style>
	.glyph-list {
		display: grid;
		grid-template-columns: 22.5rem minmax(0, 1fr);
		gap: 5.5rem;
		padding: 5rem var(--content-pad-x) 5.5rem;
	}

	.glyph-list-title {
		margin: 0 0 1.125rem;
		color: var(--ink);
	}

	.glyph-list-intro {
		margin: 0;
		color: var(--text-dim);
		text-wrap: balance;
	}

	.glyph-list-items {
		display: flex;
		flex-direction: column;
		--reveal-stagger-offset: 1;
	}

	/* Tablet and mobile stack: the heading column sits above the list. */
	@media (max-width: 1023px) {
		.glyph-list {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.9375rem;
			padding: 3.5rem var(--content-pad-x) 4rem;
		}

		.glyph-list-title {
			margin-block-end: 0.75rem;
			font-size: 1.875rem;
		}

		.glyph-list-intro {
			max-inline-size: 32.5rem;
		}
	}

	@media (max-width: 767px) {
		.glyph-list {
			gap: 0.75rem;
			padding: 3rem var(--content-pad-x) 3.125rem;
		}

		.glyph-list-title {
			font-size: 1.75rem;
		}
	}
</style>
