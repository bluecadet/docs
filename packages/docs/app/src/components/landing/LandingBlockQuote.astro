---
interface Props {
	name: string;
	title: string;
}

const { name, title } = Astro.props;
---

<div class="landing-band landing-block-quote">
  <blockquote class="type-quote">
    <slot />
  </blockquote>
  <p class="attribution type-sm">
    <span class="attribution-name">{name}</span>
    <span class="attribution-title">{title}</span>
  </p>
</div>

<style>
  .landing-block-quote {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-inline-start: 2rem;
    border-inline-start: 2px solid var(--accent);
  }

  blockquote {
    color: var(--ink);

    & i {
      font-style: italic;
      color: var(--accent);
    }
  }

  .attribution {
    display: flex;
    flex-direction: column;
    line-height: var(--leading-relaxed);
    color: var(--text-dim);
  }

  .attribution-title {
    color: var(--text-faint);

  }

  @media (max-width: 767px) {
    blockquote {
      font-size: var(--type-h2);
    }
  }
</style>
