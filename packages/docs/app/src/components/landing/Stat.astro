---
// One cell of a <StatStrip>. The label may be given as a prop or as children, whichever reads
// better in the source:
//
//   <Stat value="4.1s" label="cold build" />
//   <Stat value="4.1s">cold build, start to finish</Stat>
interface Props {
	/** The large serif figure. */
	value: string;
	/** Mono caption under the figure. Falls back to this component's children. */
	label?: string;
}

const { value, label } = Astro.props;
---

<div class="stat type-sm">
	<span class="stat-value type-stat">{value}</span>
	<span class="stat-label">{label ? label : <slot />}</span>
</div>

<style>
	.stat {
		display: flex;
		flex-direction: column;
		gap: 8px;
		color: var(--text-dim);
		text-wrap: balance;
	}

	.stat-value {
		color: var(--ink);
	}

	@media (max-width: 1023px) {
		.stat {
			gap: 7px;
		}

		.stat-value {
			font-size: 30px;
		}
	}

	@media (max-width: 767px) {
		.stat {
			gap: 6px;
			font-size: 11.5px;
		}

		.stat-value {
			font-size: 28px;
		}
	}
</style>
