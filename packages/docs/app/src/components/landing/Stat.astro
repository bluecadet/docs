---
// One cell of a <StatStrip>. The label may be given as a prop or as children, whichever reads
// better in the source:
//
//   <Stat value="4.1s" label="cold build" />
//   <Stat value="4.1s">cold build, start to finish</Stat>
interface Props {
	/** The large serif figure. */
	value: string;
	/** Mono caption under the figure. Falls back to this component's children. */
	label?: string;
}

const { value, label } = Astro.props;
---

<div class="stat">
	<span class="stat-value">{value}</span>
	<span class="stat-label">{label ? label : <slot />}</span>
</div>

<style>
	.stat {
		display: flex;
		flex-direction: column;
		gap: 7px;
		font: 400 12px var(--font-mono);
		color: var(--text-dim);
		text-wrap: pretty;
	}

	.stat-value {
		font: 300 30px/1 var(--font-serif);
		color: var(--ink);
	}

	@media (min-width: 1920px) {
		.stat {
			gap: 8px;
			font-size: 12.5px;
		}

		.stat-value {
			font-size: 34px;
		}
	}

	@media (max-width: 1023px) {
		.stat {
			gap: 6px;
		}

		.stat-value {
			font-size: 28px;
		}
	}

	@media (max-width: 767px) {
		.stat {
			gap: 5px;
			font-size: 11.5px;
		}

		.stat-value {
			font-size: 26px;
		}
	}
</style>
