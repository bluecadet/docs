---
interface Props {
	title: string;
	subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<div class="landing-band other-tools">
  <div class="other-tools-head" data-reveal>
    <h2 class="type-title title">{title}</h2>
    <p class="type-prose-sm subtitle">{subtitle}</p>
  </div>
  <div class="list-wrapper" data-reveal data-reveal-stagger>
    <slot />
  </div>
</div>

<style>
  .other-tools {
    padding: 5rem var(--content-pad-x) 5.5rem;
  }

  .title {
    margin: 0 0 1.125rem;
    color: var(--ink);
  }

  .subtitle {
    margin: 0;
    color: var(--text-dim);
		text-wrap: balance;
  }

  .list-wrapper {
    border: 1px solid var(--hairline-06);
    border-radius: var(--radius-md);
    margin-block-start: 2.5rem;
    overflow: hidden;
    --reveal-delay: 1;
    --reveal-stagger-offset: 2;
  }

  @media (min-width: 768px) {
    .list-wrapper {
      display: flex;
      flex-direction: row;
    }
  }


  @media (min-width: 1280px) {
    .other-tools {
      display: grid;
      grid-template-columns: 22.5rem minmax(0, 1fr);
      gap: 5.5rem;
    }

    .list-wrapper {
      margin-block-start: 0;
    }
  }
</style>
