---
interface Props {
	title: string;
	subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<div class="landing-band other-tools">
  <div class="other-tools-head">
    <h2 class="type-title title">{title}</h2>
    <p class="type-prose-sm subtitle">{subtitle}</p>
  </div>
  <div class="list-wrapper" data-reveal-stagger>
    <slot />
  </div>
</div>

<style>
  .other-tools {
    padding: 5rem var(--content-pad-x) 5.5rem;
  }

  .title {
    margin: 0 0 1.125rem;
    color: var(--ink);
  }

  .subtitle {
    margin: 0;
    color: var(--text-dim);
		text-wrap: balance;
  }

  .list-wrapper {
    border: 1px solid var(--hairline-06);
    border-radius: var(--radius-md);
    margin-block-start: 2.5rem;
  }

  @media (min-width: 768px) {
    .list-wrapper {
      display: flex;
      flex-direction: row;
    }
  }


  @media (min-width: 1280px) {
    .other-tools {
      display: grid;
      grid-template-columns: 22.5rem minmax(0, 1fr);
      gap: 5.5rem;
    }

    .list-wrapper {
      margin-block-start: 0;
    }
  }
</style>


<style is:global>
	@media (prefers-reduced-motion: no-preference) {
		[data-landing-reveal] .other-tools:not(.is-revealed) > .other-tools-head {
			opacity: 0;
		}

		[data-landing-reveal] .other-tools.is-revealed > .other-tools-head {
			animation: landing-reveal var(--reveal-duration) var(--reveal-ease) both;
		}

		[data-landing-reveal] .other-tools:not(.is-revealed) .list-wrapper {
			opacity: 0;
		}

		[data-landing-reveal] .other-tools.is-revealed .list-wrapper {
			animation: landing-reveal var(--reveal-duration) var(--reveal-ease) both;
			animation-delay: var(--reveal-stagger);
      overflow: hidden;
		}

		[data-landing-reveal] .other-tools:not(.is-revealed) .list-wrapper .other-tool-item {
			opacity: 0;
		}

		[data-landing-reveal] .other-tools.is-revealed .list-wrapper .other-tool-item {
			animation: landing-reveal var(--reveal-duration) var(--reveal-ease) both;
			animation-delay: calc(var(--reveal-stagger) * (var(--reveal-index, 0) + 2));
		}
	}
</style>
