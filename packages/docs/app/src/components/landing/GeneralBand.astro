---
interface Props {
	eyebrow?: string;
}

const { eyebrow } = Astro.props;
---

<div class="landing-band general-band">
	{eyebrow && (
		<div class="eyebrow type-xs" data-reveal>
			{eyebrow}
		</div>
	)}
	<div class="content" data-reveal data-reveal-root>
			<slot />
	</div>

</div>

<style>
	.general-band {
		padding: 4rem var(--content-pad-x) 4.5rem;
	}

	.eyebrow {
		color: var(--text-dim);
		text-transform: uppercase;
		margin-block-end: 1rem;
		letter-spacing: var(--tracking-brand);
	}

	.content :global(> h2) {
		font: 400 1.75rem/1.2 var(--font-serif);
		color: var(--ink);
	}


	.content :global(> h2 em) {
		color: var(--accent);
	}

	.content :global(> p) {
		font-size: 1.0625rem;
		line-height: 1.8;
		color: var(--text-muted);
	}

	.content {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		max-width: 60ch;
		--reveal-delay: 1;
	}


	@media (min-width: 1024px) {
		.general-band {
			display: grid;
			grid-template-columns: 1fr 3fr 2fr;
			gap: 3rem;
			align-items: baseline;
			max-width: none;
		}

		.eyebrow {
			grid-column: 1 / 2;
		}

		.content {
			grid-column: 2 / 3;
			gap: 2rem;
		}

		.content :global(> h2) {
			font-size: 2rem;
		}
	}
</style>
