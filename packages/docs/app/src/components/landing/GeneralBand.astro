---
interface Props {
	eyebrow?: string;
}

const { eyebrow } = Astro.props;
---

<div class="landing-band general-band">
	{eyebrow && (
		<div class="eyebrow type-xs">
			{eyebrow}
		</div>
	)}
	<div class="content">
			<slot />
	</div>

</div>

<style>
	.general-band {
		padding: 4rem var(--content-pad-x) 4.5rem;
	}

	.eyebrow {
		color: var(--text-dim);
		text-transform: uppercase;
		margin-block-end: 1rem;
		letter-spacing: var(--tracking-brand);
	}

	.content :global(> h2) {
		font: 400 1.75rem/1.2 var(--font-serif);
		color: var(--ink);
	}

	.content :global(> p) {
		font-size: 1.0625rem;
		line-height: 1.8;
		color: var(--text-muted);
	}

	.content {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		max-width: 60ch;
	}


	@media (min-width: 1024px) {
		.general-band {
			display: grid;
			grid-template-columns: 1fr 3fr 2fr;
			gap: 3rem;
			align-items: baseline;
			max-width: none;
		}

		.eyebrow {
			grid-column: 1 / 2;
		}

		.content {
			grid-column: 2 / 3;
			gap: 2rem;
		}

		.content :global(> h2) {
			font-size: 2rem;
		}
	}
</style>

<style is:global>
	/* Enter-motion for GeneralBand: fire-once reveal triggered by the IntersectionObserver in
	   index.astro; the trigger script, the `--reveal-*` tokens, and `@keyframes landing-reveal`
	   all live in landing.css. The `[data-landing-reveal]` gate on every rule below means these
	   are inert everywhere but the landing route, so TerminalBand stays safe to use on doc pages
	   too. `is:global` for consistency with the rest of the landing components' motion blocks,
	   all of which key off the same gate attribute and keyframe defined in landing.css. */
	@media (prefers-reduced-motion: no-preference) {
		/* caption row, then the terminal window one step later. */
		[data-landing-reveal] .general-band:not(.is-revealed) > * {
			opacity: 0;
		}

		[data-landing-reveal] .general-band.is-revealed > * {
			animation: landing-reveal var(--reveal-duration) var(--reveal-ease) both;
		}

		[data-landing-reveal] .general-band.is-revealed .content > * {
			animation: landing-reveal var(--reveal-duration) var(--reveal-ease) both;
		}

		[data-landing-reveal] .general-band.is-revealed .content {
			animation-delay: var(--reveal-stagger);
		}
	}
</style>
