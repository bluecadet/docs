---
// Groups <HeroNote> marginalia into the column beside the lead paragraph (tablet up) or the row
// below it (mobile) — see Hero.astro's header comment for why this needs to be a single wrapper.
// Notes stack inside it with an ordinary flex column; `--reveal-delay: 3` staggers the reveal-on-scroll.
---

<div class="hero-notes" data-reveal>
	<slot />
</div>

<style>
	.hero-notes {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		--reveal-delay: 3;
	}

	@media (max-width: 767px) {
		.hero-notes {
			gap: 1rem;
		}
	}
</style>
