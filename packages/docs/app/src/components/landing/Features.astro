---
// Full-bleed numbered feature grid for the landing page's MDX body:
//
//   <Features>
//     <Feature title="Reads what you already wrote">…</Feature>
//     <Feature title="No project to maintain">…</Feature>
//     <Feature title="One command in CI">…</Feature>
//   </Features>
//
// The numerals are a CSS counter reset here and incremented in Feature.astro — Astro components
// can't inspect their slotted children, so numbering and the state/attention alternation are
// both done in CSS rather than in JS.
---

<div class="landing-band features">
	<slot />
</div>

<style>
	.features {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-bottom: 1px solid var(--hairline-08);
		background: var(--surface-panel-1);
		counter-reset: landing-feature;
	}

	@media (max-width: 1023px) {
		.features {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 767px) {
		.features {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
