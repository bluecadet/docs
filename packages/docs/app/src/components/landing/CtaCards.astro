---
// Full-bleed CTA link grid for the landing page's MDX body. Pure composition — it takes no props
// and reads nothing itself; compose it from <CtaCard> children:
//
//   <CtaCards>
//     <CtaCard label="guides" title="Start here" href="/guides/intro/">
//       Zero to docs in five minutes.
//     </CtaCard>
//   </CtaCards>
//
// A childless <CtaCards /> renders nothing.
const hasCards = Astro.slots.has("default");
---

{
	hasCards && (
		<div class="landing-band cta-band">
			<div class="cta-cards">
				<slot />
			</div>
		</div>
	)
}

<style>

	.cta-cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1px;
		padding-bottom: 1px;
		background: var(--hairline-10);
		overflow: hidden;
		counter-reset: cta-card;
	}

	/* Tablet keeps the 2-up grid (it's already the default above); only mobile collapses to a
	   single column. */
	@media (max-width: 767px) {
		.cta-cards {
			grid-template-columns: 1fr;
		}
	}
</style>
