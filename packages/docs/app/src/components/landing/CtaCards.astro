---
// Landing-only CTA link grid: one numbered card per top-level doc section, linking to that
// section's first page.
import type { NavSection } from "./nav-tree";

interface Props {
	sections: NavSection[];
	base: string;
}

const { sections, base } = Astro.props;

function pad(n: number): string {
	return String(n).padStart(2, "0");
}
---

<div class="cta-cards">
	{sections.map((section, i) => (
		<a class="cta-card" href={`${base}${section.firstEntry.id}/`}>
			<span class="cta-num">
				{pad(i + 1)} / {section.title.toLowerCase()}
			</span>
			<span class="cta-title">{section.firstEntry.data.title}</span>
			<span class="cta-desc">
				{section.firstEntry.data.description ??
					`${section.entries.length} page${section.entries.length === 1 ? "" : "s"}`}
			</span>
		</a>
	))}
</div>

<style>
	.cta-cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1px;
		background: var(--hairline-10);
		border: 1px solid var(--hairline-10);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.cta-card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 22px;
		background: var(--bg);
		transition: background 0.15s ease;
	}

	.cta-card:hover {
		background: var(--white-02);
	}

	.cta-num {
		font: 400 11.5px var(--font-mono);
		color: var(--accent);
	}

	.cta-card:nth-child(4n + 2) .cta-num,
	.cta-card:nth-child(4n + 3) .cta-num {
		color: var(--accent-2);
	}

	.cta-title {
		font: 500 20px var(--font-serif);
		color: var(--ink);
		transition: color 0.15s ease;
	}

	.cta-card:hover .cta-title {
		color: var(--accent);
	}

	.cta-desc {
		font-size: 13.5px;
		color: var(--text-muted);
	}

	@media (min-width: 1920px) {
		.cta-cards {
			grid-template-columns: repeat(4, 1fr);
		}

		.cta-card {
			padding: 34px;
		}
	}

	@media (max-width: 1023px) {
		.cta-cards {
			grid-template-columns: 1fr;
		}
	}
</style>
