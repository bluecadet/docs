---
// One row of a <GlyphList>. Default is a dim ✕ ("no, and that's deliberate"); pass `glyph`/`color`
// to use any other mark and accent, e.g. a state-accented ✓ for an affirmative row:
//
//   <GlyphItem lead="Replace your site.">…</GlyphItem>
//   <GlyphItem glyph="✓" color="var(--accent)" lead="Get out of the way.">…</GlyphItem>
//
interface Props {
	/** Bold ink lead-in sentence. */
	lead: string;
	/** Glyph rendered in the leading column. */
	glyph?: string;
	/** Any CSS color for the glyph. */
	color?: string;
}

const { lead, glyph = "✕", color = "var(--text-faint)" } = Astro.props;
---

<div class="glyph-item" style={`--glyph-color: ${color}`}>
	<span class="glyph-item-icon" aria-hidden="true">{glyph}</span>
	<span class="glyph-item-text"><span class="glyph-item-lead">{lead}</span> <slot /></span>
</div>

<style>
	.glyph-item {
		display: grid;
		grid-template-columns: 28px minmax(0, 1fr);
		gap: 20px;
		padding: 20px 0;
		/* --hairline-07 isn't in the token set; this is the design's row rule, one step below the
		   band hairlines so a list of rows never reads as a table. */
		border-bottom: 1px solid color-mix(in srgb, white 7%, transparent);
		font-size: 15px;
		color: var(--text-muted);
		text-wrap: pretty;
	}

	.glyph-item:last-child {
		border-bottom: none;
	}

	.glyph-item-icon {
		font: 400 12px var(--font-mono);
		color: var(--glyph-color);
	}

	.glyph-item-lead {
		color: var(--ink);
	}

	/* `color` here isn't decorative — without it, `.prose p` (article.css, tied on specificity
	   with any bare `p` selector) would set this row's body text to the article's body color
	   instead of inheriting `.glyph-item`'s dimmer `--text-muted`. */
	.glyph-item-text :global(p) {
		display: inline;
		margin: 0;
		color: inherit;
	}

	@media (max-width: 1023px) {
		.glyph-item {
			grid-template-columns: 24px minmax(0, 1fr);
			gap: 18px;
			padding: 18px 0;
			font-size: 14.5px;
		}
	}

	@media (max-width: 767px) {
		.glyph-item {
			grid-template-columns: 22px minmax(0, 1fr);
			gap: 16px;
			padding: 16px 0;
			font-size: 14px;
		}

		.glyph-item-icon {
			padding-top: 2px;
			font-size: 11.5px;
		}
	}
</style>
