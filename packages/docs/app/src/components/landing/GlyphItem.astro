---
// One row of a <GlyphList>. Default is a dim ✕ ("no, and that's deliberate"); pass `glyph`/`color`
// to use any other mark and accent, e.g. a state-accented ✓ for an affirmative row:
//
//   <GlyphItem lead="Replace your site.">…</GlyphItem>
//   <GlyphItem glyph="✓" color="var(--accent)" lead="Get out of the way.">…</GlyphItem>
//
interface Props {
	/** Bold ink lead-in sentence. */
	lead: string;
	/** Glyph rendered in the leading column. */
	glyph?: string;
	/** Any CSS color for the glyph. */
	color?: string;
}

const { lead, glyph = "✕", color = "var(--text-faint)" } = Astro.props;
---

<div class="glyph-item" style={`--glyph-color: ${color}`}>
	<span class="glyph-item-icon type-sm" aria-hidden="true">{glyph}</span>
	<span class="glyph-item-text"><span class="glyph-item-lead">{lead}</span> <slot /></span>
</div>

<style>
	.glyph-item {
		display: grid;
		grid-template-columns: 1.75rem minmax(0, 1fr);
		gap: 1.25rem;
		padding: 1.25rem 0;
		font-size: 0.9375rem;
		color: var(--text-muted);
		text-wrap: balance;
	}

	.glyph-item + .glyph-item {
		border-block-start: 1px solid var(--hairline-08);
	}

	.glyph-item-icon {
		color: var(--glyph-color);
	}

	.glyph-item-lead {
		color: var(--ink);
	}

	.glyph-item-text {
		max-width: 70ch;
	}

	/* MDX wraps the slotted row text in its own `<p>` — inline so it reads as one run of text
	   after `.glyph-item-lead` rather than dropping to its own block. */
	.glyph-item-text :global(p) {
		display: inline;
	}

	@media (max-width: 1023px) {
		.glyph-item {
			grid-template-columns: 1.5rem minmax(0, 1fr);
			gap: 1.125rem;
			padding: 1.125rem 0;
			font-size: 0.90625rem;
		}
	}

	@media (max-width: 767px) {
		.glyph-item {
			grid-template-columns: 1.375rem minmax(0, 1fr);
			gap: 1rem;
			padding: 1rem 0;
			font-size: 0.875rem;
		}

		.glyph-item-icon {
			padding-block-start: 0.125rem;
			font-size: 0.71875rem;
		}
	}
</style>
