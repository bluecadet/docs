---
// Groups <Button>s into the hero's actions row, beside the install chip:
//
//   <HeroActions>
//     <Button variant="ghost" href="/tutorials/add-docs-to-your-repo/">read the quickstart →</Button>
//   </HeroActions>

---

<div class="hero-actions" data-reveal>
	<slot />
</div>

<style>
	.hero-actions {
		display: flex;
		gap: 0.875rem; /* 14px */
		--reveal-delay: 5;
	}

	/* Mobile: full-width buttons stacked under the install chip, matching the chip's own 48px tap
	   target rather than sitting beside it in a cramped row. */
	@media (max-width: 767px) {
		.hero-actions {
			flex-direction: column;
			align-items: stretch;
			gap: 0.625rem;
		}
	}
</style>
