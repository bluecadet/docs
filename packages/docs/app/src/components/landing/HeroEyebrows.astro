---
// Groups <HeroEyebrow> chips into the row above the headline. See Hero.astro's header comment for
// why this needs to be a single wrapper (Astro can't inspect a slotted child's component type, so
// N flat children can't be spread across a grid area on their own) — chips inside lay out via flex.
---

<div class="hero-eyebrows" data-reveal>
	<slot />
</div>

<style>
	.hero-eyebrows {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	@media (max-width: 767px) {
		.hero-eyebrows {
			gap: 0.4375rem;
		}
	}
</style>
