---
// Landing-only closing CTA band: points at the first doc section, plus an outbound repo link
// when one is configured.
interface Props {
	firstSectionTitle: string;
	firstHref: string;
	repoUrl?: string;
	/** Optional italic amber second clause from landing frontmatter (`closingAccent`). */
	accent?: string;
}

const { firstSectionTitle, firstHref, repoUrl, accent } = Astro.props;
---

<div class="closing-cta">
	<h2 class="closing-cta-title">
		Start with the {firstSectionTitle.toLowerCase()}.{" "}
		{accent && <span class="closing-cta-accent">{accent}</span>}
	</h2>
	<div class="closing-cta-actions">
		<a class="btn btn-primary" href={firstHref}>read the docs →</a>
		{repoUrl && (
			<a class="btn btn-secondary" href={repoUrl} rel="noopener noreferrer" target="_blank">
				github ↗
			</a>
		)}
	</div>
</div>

<style>
	.closing-cta {
		padding: 88px var(--content-pad-x) 96px;
		background: var(--surface-panel-1);
		display: flex;
		align-items: baseline;
		gap: 56px;
		flex-wrap: wrap;
	}

	.closing-cta-title {
		margin: 0;
		font: 300 38px/1.2 var(--font-serif);
		max-width: 24ch;
		color: var(--ink);
	}

	.closing-cta-accent {
		font-style: italic;
		color: var(--accent-2);
	}

	.closing-cta-actions {
		display: flex;
		gap: 14px;
		margin-left: auto;
	}

	.btn {
		font: 400 13px var(--font-mono);
		padding: 12px 20px;
		border-radius: var(--radius-md);
	}

	.btn-primary {
		color: var(--bg);
		background: var(--accent);
	}

	.btn-secondary {
		color: var(--accent-2);
		border: 1px solid var(--amber-border-40);
	}

	/* Tablet keeps the flex row (it already wraps via flex-wrap above, just with less padding);
	   only mobile stacks into a column. */
	@media (max-width: 1023px) {
		.closing-cta {
			padding: 60px var(--content-pad-x);
		}
	}

	@media (max-width: 767px) {
		.closing-cta {
			padding: 60px var(--content-pad-x);
			flex-direction: column;
			align-items: flex-start;
			gap: 30px;
		}

		.closing-cta-actions {
			margin-left: 0;
		}

		.btn {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 48px;
		}
	}
</style>
