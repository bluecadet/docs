---
// Full-bleed closing CTA band for the landing page's MDX body. Zero-config, it points at the
// first doc section and an outbound repo link when one is configured — both derived from the nav
// tree and site config:
//
//   <ClosingCta />
//
// A `title` slot replaces the derived "Start with the …" headline, with the author writing any
// <em>/<i> accent clause directly into it (see landing.css's `.landing-heading`); a default slot
// of plain <a> links replaces the two default buttons (first one styled primary, the rest
// secondary):
//
//   <ClosingCta>
//     <Fragment slot="title">Ready when you are. <em>It really is one command.</em></Fragment>
//     <a href="/tutorials/add-docs-to-your-repo/">read the docs →</a>
//     <a href="https://github.com/acme/acme" target="_blank" rel="noopener noreferrer">github ↗</a>
//   </ClosingCta>
//
import { getDocsConfig } from "../../lib/config";
import { firstPageOf, getNavTree, type NavNode } from "../../lib/nav";

const hasTitle = Astro.slots.has("title");
const hasActions = Astro.slots.has("default");

// Only touch the nav tree when something actually needs it: the derived headline (no `title`
// slot) or the derived buttons (no slotted actions).
let firstSection: NavNode | undefined;
if (!hasTitle || !hasActions) {
	({ 0: firstSection } = (await getNavTree()).nodes);
}

// With a slotted title the band always renders; without one it keeps the old "no sections yet"
// no-render behavior.
const shouldRender = hasTitle || Boolean(firstSection);

let firstHref: string | undefined;
let repoUrl: string | undefined;
if (!hasActions) {
	firstHref = firstSection ? (firstPageOf(firstSection)?.href ?? import.meta.env.BASE_URL) : undefined;
	({ repoUrl } = getDocsConfig());
}
---

{
	shouldRender && (
		<div class="landing-band closing-cta">
			<h2 class="closing-cta-title landing-heading" data-reveal>
				<slot name="title">
					{firstSection && `Start with the ${firstSection.label.toLowerCase()}.`}
				</slot>
			</h2>
			<div class="closing-cta-actions" data-reveal>
				{hasActions ? (
					<slot />
				) : (
					<>
						<a href={firstHref}>read the docs →</a>
						{repoUrl && (
							<a href={repoUrl} rel="noopener noreferrer" target="_blank">
								github ↗
							</a>
						)}
					</>
				)}
			</div>
		</div>
	)
}

<style>
	.closing-cta {
		padding: 5.5rem var(--content-pad-x) 6rem;
		display: flex;
		align-items: baseline;
		gap: 3.5rem;
		flex-wrap: wrap;
	}

	.closing-cta-title {
		margin: 0;
		font: 300 2.375rem/1.2 var(--font-serif);
		max-inline-size: 24ch;
		color: var(--ink);
	}

	.closing-cta-actions {
		display: flex;
		gap: 0.875rem;
		margin-inline-start: auto;
		--reveal-delay: 1;
	}

	/* Styles both the default-rendered buttons and any slotted links through the same selectors —
	   one source of truth for the primary/secondary button look, keyed off DOM order rather than
	   a class, since slotted <a> tags are authored plain. */
	.closing-cta-actions :global(a) {
		font: 400 0.8125rem var(--font-mono);
		padding: 0.75rem 1.25rem;
		border-radius: var(--radius-md);
	}

	.closing-cta-actions :global(a:first-child) {
		color: var(--bg);
		background: var(--accent);
	}

	.closing-cta-actions :global(a:not(:first-child)) {
		color: var(--accent-2);
		border: 1px solid var(--accent-2-border-40);
	}

	/* Tablet keeps the flex row (it already wraps via flex-wrap above, just with less padding);
	   only mobile stacks into a column. */
	@media (max-width: 1023px) {
		.closing-cta {
			padding: 3.75rem var(--content-pad-x);
		}
	}

	@media (max-width: 767px) {
		.closing-cta {
			padding: 3.75rem var(--content-pad-x);
			flex-direction: column;
			align-items: flex-start;
			gap: 1.875rem;
		}

		.closing-cta-actions {
			margin-inline-start: 0;
		}

		.closing-cta-actions :global(a) {
			display: flex;
			align-items: center;
			justify-content: center;
			min-block-size: 48px;
		}
	}
</style>
