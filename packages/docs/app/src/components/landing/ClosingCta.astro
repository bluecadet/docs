---
// Full-bleed closing CTA band for the landing page's MDX body. Zero-config, it points at the
// first doc section and an outbound repo link when one is configured — both derived from the nav
// tree and site config:
//
//   <ClosingCta accent="It really is one command." />
//
// `title` replaces the derived headline; a default slot of plain <a> links replaces the two
// default buttons (first one styled primary, the rest secondary):
//
//   <ClosingCta title="Ready when you are.">
//     <a href="/tutorials/add-docs-to-your-repo/">read the docs →</a>
//     <a href="https://github.com/acme/acme" target="_blank" rel="noopener noreferrer">github ↗</a>
//   </ClosingCta>
//
import { getDocsConfig } from "../../lib/config";
import { firstPageOf, getNavTree, type NavNode } from "../../lib/nav";

interface Props {
	/** Replaces the derived "Start with the …" headline when given. */
	title?: string;
	/** Optional italic attention-accented second clause appended to the closing headline. */
	accent?: string;
}

const { title, accent } = Astro.props;
const hasActions = Astro.slots.has("default");

// Only touch the nav tree when something actually needs it: the derived headline (no `title`) or
// the derived buttons (no slotted actions).
let firstSection: NavNode | undefined;
if (!title || !hasActions) {
	({ 0: firstSection } = (await getNavTree()).nodes);
}

const headline = title ?? (firstSection && `Start with the ${firstSection.label.toLowerCase()}.`);
// With an explicit title the band always renders; without one it keeps the old "no sections yet"
// no-render behavior.
const shouldRender = Boolean(title) || Boolean(firstSection);

let firstHref: string | undefined;
let repoUrl: string | undefined;
if (!hasActions) {
	firstHref = firstSection ? (firstPageOf(firstSection)?.href ?? import.meta.env.BASE_URL) : undefined;
	({ repoUrl } = getDocsConfig());
}
---

{
	shouldRender && (
		<div class="landing-band closing-cta">
			<h2 class="closing-cta-title">
				{headline}{" "}
				{accent && <span class="closing-cta-accent">{accent}</span>}
			</h2>
			<div class="closing-cta-actions">
				{hasActions ? (
					<slot />
				) : (
					<>
						<a href={firstHref}>read the docs →</a>
						{repoUrl && (
							<a href={repoUrl} rel="noopener noreferrer" target="_blank">
								github ↗
							</a>
						)}
					</>
				)}
			</div>
		</div>
	)
}

<style>
	.closing-cta {
		padding: 88px var(--content-pad-x) 96px;
		background: var(--surface-panel-1);
		display: flex;
		align-items: baseline;
		gap: 56px;
		flex-wrap: wrap;
	}

	.closing-cta-title {
		margin: 0;
		font: 300 38px/1.2 var(--font-serif);
		max-inline-size: 24ch;
		color: var(--ink);
	}

	.closing-cta-accent {
		font-style: italic;
		color: var(--accent-2);
	}

	.closing-cta-actions {
		display: flex;
		gap: 14px;
		margin-inline-start: auto;
	}

	/* Styles both the default-rendered buttons and any slotted links through the same selectors —
	   one source of truth for the primary/secondary button look, keyed off DOM order rather than
	   a class, since slotted <a> tags are authored plain. */
	.closing-cta-actions :global(a) {
		font: 400 13px var(--font-mono);
		padding: 12px 20px;
		border-radius: var(--radius-md);
	}

	.closing-cta-actions :global(a:first-child) {
		color: var(--bg);
		background: var(--accent);
	}

	.closing-cta-actions :global(a:not(:first-child)) {
		color: var(--accent-2);
		border: 1px solid var(--accent-2-border-40);
	}

	/* Tablet keeps the flex row (it already wraps via flex-wrap above, just with less padding);
	   only mobile stacks into a column. */
	@media (max-width: 1023px) {
		.closing-cta {
			padding: 60px var(--content-pad-x);
		}
	}

	@media (max-width: 767px) {
		.closing-cta {
			padding: 60px var(--content-pad-x);
			flex-direction: column;
			align-items: flex-start;
			gap: 30px;
		}

		.closing-cta-actions {
			margin-inline-start: 0;
		}

		.closing-cta-actions :global(a) {
			display: flex;
			align-items: center;
			justify-content: center;
			min-block-size: 48px;
		}
	}
</style>
