---
// Landing-only header variant (reused as-is on the 404 page). Same wordmark, search trigger and
// shared primary nav as the doc-page Header.astro — the only differences are layout tweaks for
// pages without a sidebar (wider tablet search pill, tighter gap). The link set itself lives in
// HeaderNav.astro so it can't diverge between templates; the shell (sticky positioning, grid/flex
// layout, translucent+blurred background, hairline border) is HeaderShell.astro.
import HeaderShell from "../header/HeaderShell.astro";
import HeaderNav from "../header/HeaderNav.astro";
import Wordmark from "../header/Wordmark.astro";
import SearchTrigger from "../header/SearchTrigger.astro";
import NavToggle from "../header/NavToggle.astro";
import { getDocsConfig } from "../../lib/config";

const config = getDocsConfig();
const base = import.meta.env.BASE_URL;
---

<HeaderShell>
	<Wordmark title={config.title} href={base} />
	<div class="landing-header-nav">
		<SearchTrigger tabletWidth="230px" />
		<HeaderNav />
		<NavToggle />
	</div>
</HeaderShell>

<style>
	.landing-header-nav {
		display: flex;
		align-items: center;
		gap: 24px;
		padding: 0 var(--content-pad-x);
		min-width: 0;
	}

	/* Tablet: HeaderShell collapses to a flex row; push this side to the far right. */
	@media (max-width: 1023px) {
		.landing-header-nav {
			margin-left: auto;
			padding: 0;
			gap: 20px;
		}
	}

	@media (max-width: 767px) {
		.landing-header-nav {
			gap: 16px;
		}
	}
</style>
