---
// Stub: page table-of-contents rail. Renders the rendered entry's real headings. Design pass
// will style this later.
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
---

{headings.length > 0 && (
	<nav class="toc" aria-label="Table of contents">
		<ul>
			{headings.map((heading) => (
				<li class={`toc-depth-${heading.depth}`}>
					<a href={`#${heading.slug}`}>{heading.text}</a>
				</li>
			))}
		</ul>
	</nav>
)}

<style>
	.toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
