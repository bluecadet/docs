---
// "On this page" — the per-page H2–H4 outline. This is the ONLY place headings appear in navigation
// (the sidebar lists pages, not headings).
//
// Two variants, deliberately mounted in different places:
//   `aside`      — the right-hand rail column, desktop/wide only. Mounted by BaseLayout.astro as a
//                  sibling of the content column. Sticky, scrolls independently, scroll-spied.
//   `disclosure` — a native <details> for tablet/mobile. Mounted INSIDE the article content by the
//                  doc page template so it sits in the article flow rather than above the
//                  breadcrumb. Native <details>/<summary> handles disclosure; scroll-spy enhances links.
// The design's "related" links block is deliberately omitted: no data source for it. The
// "updated for / edit this page" meta block IS rendered below the link list, aside variant only
// (see toc.note/toc.editLink in docs.config.yaml) — intentionally left off the mobile disclosure,
// which stays a minimal link list.
import type { MarkdownHeading } from "astro";
import { getDocsConfig } from "../lib/config";
import { buildToc } from "../lib/toc";
import TocList from "./TocList.astro";

interface Props {
	headings: MarkdownHeading[];
	variant: "aside" | "disclosure";
	/** Resolved `toc.editLink` URL for this page (aside variant only) — see pages/[...slug].astro. */
	editHref?: string;
}

const { headings, variant, editHref } = Astro.props;
const sections = buildToc(headings);
const firstSlug = sections[0]?.slug ?? "";
const note = getDocsConfig().toc?.note;
---

{
	sections.length > 0 &&
		(variant === "aside" ? (
			<div class="toc-rail">
				<aside class="toc-aside scroll-rail" aria-label="Table of contents">
					<div class="toc-aside__label type-sm">on this page</div>
					<nav class="toc-aside__links" aria-label="On this page" data-toc>
						<TocList sections={sections} firstSlug={firstSlug} />
					</nav>
					{(note || editHref) && (
						<div class="toc-aside__meta type-xs">
							{note && <span class="toc-aside__note">{note}</span>}
							{note && editHref && <br />}
							{editHref && (
								<a
									class="toc-aside__edit-link"
									href={editHref}
									rel="noopener noreferrer"
									target="_blank"
								>
									edit this page ↗
								</a>
							)}
						</div>
					)}
				</aside>
			</div>
		) : (
			<details class="toc-disclosure">
				<summary class="toc-disclosure__summary type-xs">
					on this page
					<span class="toc-disclosure__caret type-micro" aria-hidden="true">
						▾
					</span>
				</summary>
				<nav class="toc-disclosure__links" aria-label="On this page" data-toc>
					<TocList sections={sections} firstSlug={firstSlug} />
				</nav>
			</details>
		))
}

<style>
	/* The rail is the grid cell — it owns the hairline so the border runs the full page height;
	   the aside inside it is what sticks and scrolls. */
	.toc-rail {
		border-inline-start: 1px solid var(--hairline-08);
		min-inline-size: 0;
	}

	.toc-aside {
		padding: var(--content-pad-top) 2.25rem 4rem;
		font-size: 0.78125rem;
	}

	.toc-aside__label {
		color: var(--text-dim);
		margin-block-end: 0.875rem;
	}

	.toc-aside__links {
		border-inline-start: 1px solid var(--hairline-10);
	}

	/* Bottom meta block — aside variant only (see the comment near the top of this file for why
	   the disclosure variant never gets one). Gap-matches the 32px the design puts between the
	   link list and this block. */
	.toc-aside__meta {
		margin-block-start: 2rem;
		padding-block-start: 1.5rem;
		border-block-start: 1px solid var(--hairline-08);
		line-height: var(--leading-loose);
		color: var(--text-dim);
	}

	.toc-aside__note {
		color: var(--accent-2);
	}

	.toc-aside__edit-link {
		color: var(--text-muted);
		transition: color var(--transition-fast);
	}

	.toc-aside__edit-link:hover {
		color: var(--ink);
	}

	/* -- <details> disclosure variant (tablet/mobile) --------------------------------------- */

	.toc-disclosure {
		display: none;
		border: 1px solid var(--hairline-10);
		border-radius: var(--radius-md);
		margin: 0 0 1.5rem;
		background: var(--white-02);
	}

	.toc-disclosure__summary {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		/* WCAG tap-target minimum — stays fixed CSS px, doesn't track text zoom. */
		min-block-size: 44px;
		padding: 0 0.875rem;
		color: var(--text-muted);
		cursor: pointer;
		list-style: none;
	}

	.toc-disclosure__summary::-webkit-details-marker {
		display: none;
	}

	.toc-disclosure__caret {
		margin-inline-start: auto;
		color: var(--text-dim);
	}

	.toc-disclosure__links {
		padding: 0.125rem 0.875rem 0.75rem 0;
		font-size: 0.8125rem;
	}

	/* Tablet/mobile: the persistent aside column drops (see BaseLayout.astro's .page-main grid)
	   and the inline disclosure takes over. Matches BaseLayout's .page-main--toc collapse so the
	   aside never renders in the squeezed 1024-1279px range. */
	@media (max-width: 1279px) {
		.toc-rail {
			display: none;
		}

		.toc-disclosure {
			display: block;
		}
	}
</style>

<script>
	import { setupTocScrollSpy } from "../scripts/toc";

	setupTocScrollSpy();
</script>
