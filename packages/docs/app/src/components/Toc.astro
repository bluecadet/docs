---
// "On this page" — the per-page H2 list. This is the ONLY place headings appear in navigation
// (the sidebar lists pages, not headings).
//
// Two variants, deliberately mounted in different places:
//   `aside`      — the right-hand rail column, desktop/wide only. Mounted by BaseLayout.astro as a
//                  sibling of the content column. Sticky, scrolls independently, scroll-spied.
//   `disclosure` — a native <details> for tablet/mobile. Mounted INSIDE the article content by the
//                  doc page template so it sits in the article flow rather than above the
//                  breadcrumb. No JS: <details>/<summary> is the whole interaction.
// The 1920 "updated for / edit this page" metadata and "related" links blocks are deliberately
// omitted: no data source for either.
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
	variant: "aside" | "disclosure";
}

const { headings, variant } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
---

{
	sections.length > 0 &&
		(variant === "aside" ? (
			<div class="toc-rail">
				<aside class="toc-aside" aria-label="Table of contents">
					<div class="toc-aside__label">on this page</div>
					<nav class="toc-aside__links">
						{sections.map((section, index) => (
							<a
								class="toc-aside__link"
								class:list={{ "is-active": index === 0 }}
								href={`#${section.slug}`}
							>
								{section.text}
							</a>
						))}
					</nav>
				</aside>
			</div>
		) : (
			<details class="toc-disclosure">
				<summary class="toc-disclosure__summary">
					on this page
					<span class="toc-disclosure__caret" aria-hidden="true">
						▾
					</span>
				</summary>
				<div class="toc-disclosure__links">
					{sections.map((section) => (
						<a class="toc-disclosure__link" href={`#${section.slug}`}>
							{section.text}
						</a>
					))}
				</div>
			</details>
		))
}

<style>
	/* The rail is the grid cell — it owns the hairline so the border runs the full page height;
	   the aside inside it is what sticks and scrolls. */
	.toc-rail {
		border-left: 1px solid var(--hairline-08);
		min-width: 0;
	}

	.toc-aside {
		position: sticky;
		top: var(--header-height);
		max-height: calc(100vh - var(--header-height));
		max-height: calc(100dvh - var(--header-height));
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-gutter: stable;
		scrollbar-width: thin;
		scrollbar-color: var(--hairline-14) transparent;
		padding: 32px 22px;
		font-size: 12.5px;
	}

	.toc-aside::-webkit-scrollbar {
		width: 6px;
	}

	.toc-aside::-webkit-scrollbar-thumb {
		background: var(--hairline-12);
		border-radius: var(--radius-sm);
	}

	.toc-aside__label {
		font: 400 12px var(--font-mono);
		color: var(--text-dim);
		margin-bottom: 14px;
	}

	.toc-aside__links {
		display: flex;
		flex-direction: column;
		gap: 10px;
		border-left: 1px solid var(--hairline-10);
	}

	.toc-aside__link {
		padding-left: 14px;
		color: var(--text-muted);
		transition: color 0.15s ease;
	}

	.toc-aside__link:hover {
		color: var(--accent);
	}

	.toc-aside__link.is-active {
		color: var(--accent);
		margin-left: -1px;
		border-left: 1px solid var(--accent);
	}

	/* -- <details> disclosure variant (tablet/mobile) --------------------------------------- */

	.toc-disclosure {
		display: none;
		border: 1px solid var(--hairline-10);
		border-radius: var(--radius-md);
		margin: 0 0 24px;
		background: var(--white-02);
	}

	.toc-disclosure__summary {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		padding: 0 14px;
		font: 400 11.5px var(--font-mono);
		color: var(--text-muted);
		cursor: pointer;
		list-style: none;
	}

	.toc-disclosure__summary::-webkit-details-marker {
		display: none;
	}

	.toc-disclosure__caret {
		margin-left: auto;
		color: var(--text-dim);
		font-size: 10px;
	}

	.toc-disclosure__links {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2px 20px;
		padding: 2px 14px 12px;
		font-size: 13px;
	}

	.toc-disclosure__link {
		display: flex;
		align-items: center;
		min-height: 40px;
		color: var(--text-muted);
	}

	/* Tablet/mobile: the persistent aside column drops (see BaseLayout.astro's .page-main grid)
	   and the inline disclosure takes over. */
	@media (max-width: 1023px) {
		.toc-rail {
			display: none;
		}

		.toc-disclosure {
			display: block;
		}
	}

	@media (max-width: 767px) {
		.toc-disclosure__links {
			grid-template-columns: 1fr;
		}
	}

	@media (min-width: 1920px) {
		.toc-rail {
			border-left: none;
		}

		.toc-aside {
			padding: 66px 0 0;
			font-size: 13px;
		}

		.toc-aside__links {
			gap: 11px;
		}

		.toc-aside__link {
			padding-left: 15px;
		}
	}
</style>

<script>
	// Scroll-spy: highlight the TOC link whose heading is currently nearest the top of the
	// viewport. Runs once per page load (hoisted + bundled by Astro even with two instances).
	function setupTocScrollSpy() {
		const asides = document.querySelectorAll<HTMLElement>(".toc-aside");
		for (const aside of asides) {
			const links = Array.from(aside.querySelectorAll<HTMLAnchorElement>(".toc-aside__link"));
			if (links.length === 0) continue;

			const targets = links
				.map((link) => {
					const id = link.getAttribute("href")?.slice(1);
					const el = id ? document.getElementById(id) : null;
					return el ? { link, el } : null;
				})
				.filter((entry): entry is { link: HTMLAnchorElement; el: HTMLElement } => entry !== null);

			if (targets.length === 0) continue;

			const setActive = (activeLink: HTMLAnchorElement) => {
				for (const link of links) link.classList.toggle("is-active", link === activeLink);
			};

			const observer = new IntersectionObserver(
				(entries) => {
					const visible = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
					if (visible.length === 0) return;
					const match = targets.find((target) => target.el === visible[0].target);
					if (match) setActive(match.link);
				},
				{ rootMargin: "0px 0px -70% 0px", threshold: 0 },
			);

			for (const target of targets) observer.observe(target.el);
		}
	}

	setupTocScrollSpy();
</script>
