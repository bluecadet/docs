---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Pagination from "../components/Pagination.astro";
import Toc from "../components/Toc.astro";

export async function getStaticPaths() {
	// The `index` entry is the landing route, owned by src/pages/index.astro — exclude it here so
	// this catch-all doesn't also try to generate `/`.
	const entries = await getCollection("docs", ({ id }) => id !== "index");
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	headings={headings}
	currentId={entry.id}
>
	<Breadcrumb id={entry.id} title={entry.data.title} />
	<article class="prose">
		<h1>{entry.data.title}</h1>
		{entry.data.description && <p class="lead">{entry.data.description}</p>}
		{/* Tablet/mobile "on this page" — sits after the lead and before the first H2, matching
		    the design's breadcrumb -> H1 -> lead -> disclosure -> body order. Desktop/wide keep the
		    aside variant, mounted separately by BaseLayout. */}
		<Toc variant="disclosure" headings={headings} />
		<Content />
	</article>
	<Pagination currentId={entry.id} />
</BaseLayout>
