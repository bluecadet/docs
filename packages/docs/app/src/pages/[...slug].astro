---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Pagination from "../components/Pagination.astro";

export async function getStaticPaths() {
	// The `index` entry is the landing route, owned by src/pages/index.astro — exclude it here so
	// this catch-all doesn't also try to generate `/`.
	const entries = await getCollection("docs", ({ id }) => id !== "index");
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	headings={headings}
	currentId={entry.id}
>
	<Breadcrumb id={entry.id} title={entry.data.title} />
	<article class="prose">
		<Content />
	</article>
	<Pagination currentId={entry.id} />
</BaseLayout>
