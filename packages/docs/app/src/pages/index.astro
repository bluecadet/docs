---
// Landing page — route "/". Optional: `docs.config.yaml`'s `landing:` key names the file published
// here, and when it's absent there is no landing content at all, so this route renders a redirect to
// the first sidebar page instead (see LandingRedirect.astro). Everything below describes the
// landing-page case.
//
// Uses the shared page shell (BaseLayout) so its header and footer
// columns are identical to every doc page, but opts out of the left nav rail (`sidebar={false}`)
// in favor of a single full-bleed main column with its own wider gutters (see the .landing-body
// override below) — only the header/footer variants and the full-bleed main differ otherwise.
//
// The page title / Open Graph description still come from the landing entry's frontmatter (`title`/
// `description`), since BaseLayout needs them before the MDX body renders. Everything else —
// the hero, stat strip, terminal demo, feature pillars, the CTA cards, the "will not do" list, the
// closing CTA — is MDX components the author drops into their own index.mdx, Hero included, so the
// shape of the page is entirely theirs. With none of it beyond a bare `title`, this route still
// renders — BaseLayout just gets a page title and no body content.
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingHeader from "../components/landing/LandingHeader.astro";
import LandingRedirect from "../components/landing/LandingRedirect.astro";
import { docsEntryHref } from "../lib/nav";
import { getDocsConfig } from "../lib/config";
import "../styles/landing.css";

const { title: siteTitle, hasLanding } = getDocsConfig();

const entries = await getCollection("docs");
const indexEntry = hasLanding ? entries.find((entry) => entry.id === "index") : undefined;
const { Content } = indexEntry ? await render(indexEntry) : { Content: undefined };

const docsHref = await docsEntryHref();

const data = indexEntry?.data;
const pageTitle = data?.title ?? siteTitle;
const pageDescription = data?.description;
---

{
	indexEntry ? (
		<BaseLayout
			title={pageTitle}
			description={pageDescription}
			main="full"
			appendSiteTitle={false}
			sidebar={false}
			ogType="website"
		>
			<LandingHeader slot="header" />

			{/* Reveal gate: sets an attribute on <html> before the landing content below parses, so
			    every hiding/animation rule in landing.css can scope itself under `[data-landing-reveal]`.
			    Content is never hidden unless this attribute is present, and it's only set when JS
			    actually ran and the visitor hasn't asked for reduced motion — the no-JS/no-IO/
			    reduced-motion cases all fall through to a fully visible, motionless page. Must be
			    `is:inline` (unbundled, unhoisted) so it runs synchronously at this exact point in the
			    document, ahead of `.landing-content`. */}
			<script is:inline>
				if (
					!matchMedia("(prefers-reduced-motion: reduce)").matches &&
					"IntersectionObserver" in window
				)
					document.documentElement.setAttribute("data-landing-reveal", "");
			</script>

			{/* data-pagefind-body scopes the search index to the landing page's own content — see the
			    pagefindIndex() comment in astro.config.mjs for why this also determines which pages are
			    indexed at all. Everything the landing route renders into BaseLayout's default slot lives
			    here, so it's all wrapped together rather than piecemeal. */}
			<div class="landing-body" data-pagefind-body data-pagefind-meta={`title:${pageTitle}`}>
				{Content && (
					<article class="landing-content">
						<Content />
					</article>
				)}
			</div>
		</BaseLayout>
	) : (
		<LandingRedirect href={docsHref} />
	)
}

<script>
	// Fire-once enter animation trigger — see landing.css's "Enter motion" section for the CSS side.
	// Does nothing unless the inline gate script above set the reveal attribute (no JS, ancient
	// browser, or reduced motion all skip this entirely, leaving content statically visible).
	if (document.documentElement.hasAttribute("data-landing-reveal")) {
		const content = document.querySelector(".landing-content");

		if (content) {
			// Per-child stagger contract: any container — a band's own root or a nested wrapper,
			// authored here or by an MDX consumer — marked `data-reveal-stagger` gets each of its
			// DIRECT children an inline `--reveal-index` (0-based, capped at 8 so a long list doesn't
			// crawl) before it's ever observed. Components read the index back in their own colocated
			// motion CSS via `calc(var(--reveal-stagger) * var(--reveal-index, 0))`; this script only
			// assigns the index, never the delay math.
			for (const container of content.querySelectorAll("[data-reveal-stagger]")) {
				Array.from(container.children).forEach((child, i) => {
					child.style.setProperty("--reveal-index", String(Math.min(i, 8)));
				});
			}

			// When several elements enter in the same observer batch — which in practice only happens
			// for everything above the fold at load — ramp them one BATCH_STEP_MS apart so the page
			// reveals as a single wave downward instead of every band cascading at once. Normal
			// scrolling delivers one element per batch, so this is a no-op there.
			const BATCH_STEP_MS = 200;

			const observer = new IntersectionObserver(
				(entries) => {
					entries
						.filter((entry) => entry.isIntersecting)
						.forEach((entry, i) => {
							// Unobserve immediately (not in the timeout) so a re-fire can't queue a duplicate.
							observer.unobserve(entry.target);
							if (i === 0) entry.target.classList.add("is-revealed");
							else setTimeout(() => entry.target.classList.add("is-revealed"), i * BATCH_STEP_MS);
						});
				},
				// Reveals start once ~12% of the viewport bottom is cleared; threshold 0 so a band taller
				// than the viewport still triggers as soon as its top edge crosses that line.
				{ rootMargin: "0px 0px -12% 0px", threshold: 0 },
			);

			// Every direct child of .landing-content — bands and prose paragraphs alike — plus any
			// band an author nested deeper (e.g. inside a wrapper <div> in their MDX): the CSS keys
			// band reveals off `.landing-band`-level classes, so a band that never got observed would
			// keep its content hidden forever. Elements already above the fold at load intersect
			// immediately, giving a load-time cascade for free.
			for (const el of new Set([...content.children, ...content.querySelectorAll(".landing-band")])) {
				observer.observe(el);
			}
		}
	}
</script>

<style>
	/* Without the sidebar rail (see BaseLayout's `sidebar={false}`), the landing page is one full-
	   width column instead of a rail + reduced content column — so at desktop it needs a much
	   wider gutter than a doc page's --content-pad-x (56px) to read as intentional rather than
	   under-padded. Every landing band already keys its own edge padding off --content-pad-x, so
	   overriding it once is the whole fix. Set on `:global(.page)` — BaseLayout's shell root,
	   outside this component — rather than `.landing-body`, so the header and footer wordmark cells
	   (which key their own gutter off --content-pad-x too — see BaseLayout's --brand-pad-start) pick
	   up the same 88px, not just the body content. This only ships in index.astro's own stylesheet,
	   so doc pages, which still have the rail, are untouched. Below 1024px this rule stops applying
	   and --content-pad-x falls back to its :root default (global.css), which already suits a
	   single column at those widths. */
	@media (min-width: 1024px) {
		:global(.page) {
			--content-pad-x: 5.5rem; /* 88px */
		}
	}

	/* The MDX body mixes two kinds of block: ordinary prose, which wants the same measure and
	   gutter as any doc page, and full-bleed landing bands (StatStrip, TerminalBand, Features,
	   CtaCards, GlyphList, ClosingCta), which run edge to edge and carry their own padding. A
	   named-column grid gives both without the bands having to break out with negative margins. */
	.landing-content {
		/* Drives both this padding and the first/last band's cancelling negative margins below, so
		   the two can never drift out of sync — see the margin rules' comment. */
		--landing-rhythm: 4.125rem; /* 66px */

		display: grid;
		grid-template-columns:
			[full-start] var(--content-pad-x)
			[content-start] minmax(0, 62.75rem)
			[content-end] 1fr
			[full-end];
		padding: var(--landing-rhythm) 0;
		font-size: 0.96875rem; /* 15.5px */
		line-height: 1.75;
	}

	/* `:global` because `<Content />` output carries no scope attribute of this component's. */
	.landing-content > :global(*) {
		grid-column: content;
	}

	.landing-content > :global(.landing-band) {
		grid-column: full;
	}

	/* Bands supply their own vertical rhythm and hairlines. A band that opens or closes the body
	   cancels the article's padding on that edge so it butts straight against the header above, or
	   the page's own bottom edge below, instead of sitting the article's rhythm further in — this
	   is what lets <Hero>, itself just the first `.landing-band` in the MDX body now, start flush
	   under the header the way the design's bands do. Deriving these from --landing-rhythm rather
	   than repeating the padding value keeps the two enforced by construction instead of
	   hand-kept equal. */
	.landing-content > :global(.landing-band:first-child) {
		margin-block-start: calc(-1 * var(--landing-rhythm));
	}

	.landing-content > :global(.landing-band:last-child) {
		margin-block-end: calc(-1 * var(--landing-rhythm));
	}

	@media (max-width: 1023px) {
		.landing-content {
			--landing-rhythm: 3.375rem; /* 54px */

			grid-template-columns:
				[full-start] var(--content-pad-x)
				[content-start] minmax(0, 1fr)
				[content-end] var(--content-pad-x)
				[full-end];
		}
	}

	@media (max-width: 767px) {
		.landing-content {
			--landing-rhythm: 2.625rem; /* 42px */

			grid-template-columns:
				[full-start] var(--content-pad-x)
				[content-start] minmax(0, 1fr)
				[content-end] var(--content-pad-x)
				[full-end];
		}
	}
</style>
