---
// Landing page — route "/". Uses the shared page shell (BaseLayout) so its header, sidebar rail
// and footer columns are identical to every doc page; only the header/footer variants and the
// full-bleed main differ. All landing copy is derived from real synced content + frontmatter +
// env, not the design canvas's fictional "lathe" CLI copy.
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaCards from "../components/landing/CtaCards.astro";
import ClosingCta from "../components/landing/ClosingCta.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";
import LandingHeader from "../components/landing/LandingHeader.astro";
import LandingHero from "../components/landing/LandingHero.astro";
import { firstPageOf, getNavTree } from "../lib/nav";

const base = import.meta.env.BASE_URL;
const siteTitle = process.env.DOCS_TITLE ?? "Docs";
const repoUrl = process.env.DOCS_REPO_URL;

const entries = await getCollection("docs");
const indexEntry = entries.find((entry) => entry.id === "index");
const { Content } = indexEntry ? await render(indexEntry) : { Content: undefined };

const { nodes } = await getNavTree();
const firstSection = nodes[0];
const docsHref = (firstSection && firstPageOf(firstSection)?.href) ?? base;

const pageTitle = indexEntry?.data.title ?? siteTitle;
const pageDescription = indexEntry?.data.description;
---

<BaseLayout title={pageTitle} description={pageDescription} main="full" appendSiteTitle={false}>
	<LandingHeader slot="header" title={siteTitle} docsHref={docsHref} repoUrl={repoUrl} />
	<LandingFooter slot="footer" title={siteTitle} docsHref={docsHref} repoUrl={repoUrl} />

	<LandingHero title={pageTitle} lead={pageDescription} />
	{
		Content && (
			<article class="prose landing-content">
				<Content />
			</article>
		)
	}
	{
		nodes.length > 0 && (
			<section class="landing-section">
				<CtaCards nodes={nodes} />
			</section>
		)
	}
	{
		firstSection && (
			<ClosingCta firstSectionTitle={firstSection.label} firstHref={docsHref} repoUrl={repoUrl} />
		)
	}
</BaseLayout>

<style>
	.landing-content {
		padding: 44px 56px;
		max-width: 880px;
	}

	.landing-section {
		padding: 0 56px 56px;
	}

	@media (min-width: 1920px) {
		.landing-content {
			padding: 48px 80px;
		}

		.landing-section {
			padding: 0 80px 64px;
		}
	}

	@media (max-width: 1023px) {
		.landing-content {
			padding: 36px 40px;
		}

		.landing-section {
			padding: 0 40px 44px;
		}
	}

	@media (max-width: 767px) {
		.landing-content {
			padding: 28px 18px;
		}

		.landing-section {
			padding: 0 18px 36px;
		}
	}
</style>
