---
// 404 page — route "/404". Astro emits this as /404.html, which GitHub Pages serves automatically
// for any unmatched path (no extra astro.config.mjs wiring needed). Uses the shared page shell
// (BaseLayout) with the landing's header/footer variants and a full-bleed main.
//
// The "did you mean" suggestions are computed client-side: the server has no idea what URL 404'd
// (GitHub Pages serves this same static file for every miss), so we serialize every real doc route
// into an inline JSON payload and let not-found-client.ts fuzzy-match against `location.pathname`.
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import LandingHeader from "../components/landing/LandingHeader.astro";
import { getNavTree } from "../lib/nav";
import { getDocsConfig } from "../lib/config";

const base = import.meta.env.BASE_URL;
const { title: siteTitle, repoUrl } = getDocsConfig();

const { flat } = await getNavTree();

const routesPayload = {
	base,
	routes: flat.map((page) => ({ id: page.id, href: page.href, title: page.label })),
};
---

<BaseLayout title={`404 — ${siteTitle}`} main="full" appendSiteTitle={false} robots="noindex">
	<LandingHeader slot="header" />

	<div class="notfound-main">
		<div class="notfound-eyebrow type-eyebrow">404 — no page here</div>
		<h1 class="notfound-h1 type-display">
			This page moved,<br />
			<span class="notfound-h1-accent">or never existed.</span>
		</h1>
		<p class="notfound-lead">
			The page you were looking for could not be found. Try one of the suggestions below, or search
			from scratch.
		</p>

		<div class="notfound-grid">
			<div class="notfound-col">
				<div class="requested-panel">
					<div class="requested-panel-header type-2xs">requested</div>
					<pre class="requested-panel-body"><span class="requested-line" data-requested-path>…</span><span class="requested-line"><span class="dim">status  </span>404</span><span class="requested-line requested-closest" data-requested-closest hidden><span class="dim">closest </span><span data-closest-path></span> <span class="state" data-closest-pct></span></span></pre>
				</div>

				<div class="dym-label type-xs" data-dym-label hidden>DID YOU MEAN</div>
				<div class="dym-list" data-dym-list hidden></div>

				<div class="notfound-cta">
					<Button href={base}>back to docs →</Button>
					<Button variant="ghost" data-search-trigger>
						search everything <kbd class="kbd">/</kbd>
					</Button>
				</div>
			</div>

			{
				repoUrl && (
					<div class="margin-note">
						↖ if you followed a link from our own docs, that is our bug —{" "}
						<a href={`${repoUrl}/issues`} rel="noopener noreferrer" target="_blank">
							report it ↗
						</a>{" "}
						and we will add the redirect.
					</div>
				)
			}
		</div>
	</div>

	<script type="application/json" id="notfound-routes-data" set:html={JSON.stringify(routesPayload)} />
	<script>
		import { initNotFound } from "../components/notfound/not-found-client";
		initNotFound();
	</script>
</BaseLayout>

<style>
	.notfound-main {
		min-inline-size: 0;
		padding: 5.5rem var(--content-pad-x) 6rem; /* 88px, 96px */
	}

	.notfound-eyebrow {
		color: var(--accent-2);
		margin-block-end: 1.375rem; /* 22px */
	}

	.notfound-h1 {
		margin: 0;
		/* family/weight/tracking come from .type-display; this size/line-height is unique to this
		   page's display heading, so it stays local as longhand-only (never a `font:` shorthand,
		   which would reset the properties .type-display sets). */
		font-size: 3.5rem; /* 56px */
		line-height: 1.05;
		max-inline-size: 47.5rem; /* 760px */
		color: var(--ink);
	}

	.notfound-h1-accent {
		font-style: italic;
		color: var(--accent-2);
	}

	.notfound-lead {
		margin: 1.375rem 0 0; /* 22px */
		max-inline-size: 35rem; /* 560px */
		color: var(--text-muted);
		font-size: 1rem; /* 16px */
		text-wrap: balance;
	}

	.notfound-grid {
		display: grid;
		grid-template-columns: minmax(0, 38.75rem) 18.75rem; /* 620px, 300px */
		gap: 3.5rem; /* 56px */
		margin-block-start: 2.375rem; /* 38px */
		align-items: start;
	}

	.notfound-col {
		min-inline-size: 0;
	}

	/* -- Requested panel (code-block-style container) -- */
	.requested-panel {
		border: 1px solid var(--hairline-10);
		border-radius: var(--radius-md);
		background: var(--surface-code);
		overflow: hidden;
	}

	.requested-panel-header {
		display: flex;
		align-items: center;
		padding: 0.5rem 0.875rem; /* 8px 14px */
		border-block-end: 1px solid var(--hairline-08);
		color: var(--text-dim);
	}

	.requested-panel-body {
		white-space: pre-wrap;
		margin: 0;
		padding: 0.875rem 1rem; /* 14px 16px */
		font: 400 0.8125rem/1.8 var(--font-mono); /* 13px */
		color: var(--text-code);
	}

	.requested-panel-body .requested-line {
		display: block;
	}

	.requested-panel-body .dim {
		color: var(--text-dim);
	}

	.requested-panel-body .state {
		color: var(--accent);
	}

	:global(.requested-highlight) {
		color: var(--accent-2);
	}

	/* -- DID YOU MEAN -- */
	/* family/weight/size come from .type-xs (exact match: 400 11.5px mono); letter-spacing/margin
	   are this page's own, kept local. */
	.dym-label {
		color: var(--text-dim);
		letter-spacing: 0.08em;
		margin: 2rem 0 0.625rem; /* 32px 0 10px */
	}

	.dym-list {
		border: 1px solid var(--hairline-10);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	:global(.dym-row) {
		text-decoration: none;
		display: grid;
		grid-template-columns: 1.375rem 1fr auto; /* 22px */
		gap: 0.875rem; /* 14px */
		padding: 0.8125rem 1rem; /* 13px 16px */
		color: inherit;
	}

	:global(.dym-row + .dym-row) {
		border-block-start: 1px solid var(--hairline-06);
	}

	:global(.dym-row .dym-bullet) {
		color: var(--text-faint);
		font: 400 0.75rem var(--font-mono); /* 12px */
	}

	:global(.dym-row .dym-title) {
		display: block;
		color: var(--text-body);
		margin-block-end: 0.1875rem; /* 3px */
	}

	:global(.dym-row .dym-path) {
		display: block;
		font-size: 0.78125rem; /* 12.5px */
		color: var(--text-muted);
	}

	:global(.dym-row .dym-enter) {
		font: 400 0.6875rem var(--font-mono); /* 11px */
		color: var(--text-dim);
	}

	/* .active-row (global.css) supplies the background/box-shadow — see not-found-client.ts, which
	   adds it alongside .dym-row--active on the current row. */
	:global(.dym-row--active .dym-bullet) {
		color: var(--accent);
	}

	:global(.dym-row--active .dym-title) {
		color: var(--ink);
	}

	/* -- CTA row -- */
	.notfound-cta {
		display: flex;
		gap: 0.875rem; /* 14px */
		margin-block-start: 1.875rem; /* 30px */
	}

	.kbd {
		margin-inline-start: 0.375rem; /* 6px */
		font-size: 0.6875rem; /* 11px */
	}

	/* -- Margin note -- */
	.margin-note {
		border-inline-start: 2px solid var(--accent-2);
		padding-block: 0.125rem 0.125rem; /* 2px */
		padding-inline: 0.875rem 0; /* 14px */
		font: 400 0.75rem/1.8 var(--font-mono); /* 12px */
		color: var(--accent-2-annotation);
	}

	.margin-note a {
		color: var(--accent-2);
	}

	@media (min-width: 1920px) {
		.notfound-main {
			padding: 6rem 5rem 6.5rem; /* 96px 80px 104px */
		}

		.notfound-h1 {
			font-size: 3.875rem; /* 62px */
		}
	}

	@media (max-width: 1023px) {
		.notfound-main {
			padding: 2.5rem var(--content-pad-x) 3rem; /* 40px, 48px */
		}

		.notfound-h1 {
			font-size: 2.5rem; /* 40px */
		}

		.notfound-grid {
			grid-template-columns: 1fr;
			gap: 2rem; /* 32px */
		}

		/* Stacks a breakpoint earlier than buttons.css's mobile touch-target rule, so the tablet
		   column repeats the centering/height here. */
		.notfound-cta {
			flex-direction: column;
		}

		.notfound-cta > :is(a, button) {
			justify-content: center;
			min-block-size: 48px;
		}
	}
</style>
