---
// 404 page — route "/404". Astro emits this as /404.html, which GitHub Pages serves automatically
// for any unmatched path (no extra astro.config.mjs wiring needed). Uses the shared page shell
// (BaseLayout) with the landing's header/footer variants and a full-bleed main.
//
// The "did you mean" suggestions are computed client-side: the server has no idea what URL 404'd
// (GitHub Pages serves this same static file for every miss), so we serialize every real doc route
// into an inline JSON payload and let not-found-client.ts fuzzy-match against `location.pathname`.
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingHeader from "../components/landing/LandingHeader.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";
import { getNavTree } from "../lib/nav";

const base = import.meta.env.BASE_URL;
const siteTitle = process.env.DOCS_TITLE ?? "Docs";
const repoUrl = process.env.DOCS_REPO_URL;

const { flat } = await getNavTree();

const routesPayload = {
	base,
	routes: flat.map((page) => ({ id: page.id, href: page.href, title: page.label })),
};
---

<BaseLayout title={`404 — ${siteTitle}`} main="full" appendSiteTitle={false} robots="noindex">
	<LandingHeader slot="header" title={siteTitle} docsHref={base} repoUrl={repoUrl} />
	<LandingFooter slot="footer" title={siteTitle} docsHref={base} repoUrl={repoUrl} />

	<div class="notfound-main">
		<div class="notfound-eyebrow">404 — no page here</div>
		<h1 class="notfound-h1">
			This page moved,<br />
			<span class="notfound-h1-accent">or never existed.</span>
		</h1>
		<p class="notfound-lead">
			The page you were looking for could not be found. Try one of the suggestions below, or search
			from scratch.
		</p>

		<div class="notfound-grid">
			<div class="notfound-col">
				<div class="requested-panel">
					<div class="requested-panel-header">requested</div>
					<pre class="requested-panel-body"><span class="requested-line" data-requested-path>…</span><span class="requested-line"><span class="dim">status  </span>404</span><span class="requested-line requested-closest" data-requested-closest hidden><span class="dim">closest </span><span data-closest-path></span> <span class="sage" data-closest-pct></span></span></pre>
				</div>

				<div class="dym-label" data-dym-label hidden>DID YOU MEAN</div>
				<div class="dym-list" data-dym-list hidden></div>

				<div class="notfound-cta">
					<a class="btn btn-primary" href={base}>back to docs →</a>
					<button type="button" class="btn btn-ghost" data-search-trigger>
						search everything <span class="kbd">/</span>
					</button>
				</div>
			</div>

			{
				repoUrl && (
					<div class="margin-note">
						↖ if you followed a link from our own docs, that is our bug —{" "}
						<a href={`${repoUrl}/issues`} rel="noopener noreferrer" target="_blank">
							report it ↗
						</a>{" "}
						and we will add the redirect.
					</div>
				)
			}
		</div>
	</div>

	<script type="application/json" id="notfound-routes-data" set:html={JSON.stringify(routesPayload)} />
	<script>
		import { initNotFound } from "../components/notfound/not-found-client";
		initNotFound();
	</script>
</BaseLayout>

<style>
	.notfound-main {
		min-width: 0;
		padding: 88px 56px 96px;
	}

	.notfound-eyebrow {
		font: 400 11.5px var(--font-mono);
		color: var(--accent-2);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		margin-bottom: 22px;
	}

	.notfound-h1 {
		margin: 0;
		font: 300 56px/1.05 var(--font-serif);
		letter-spacing: -0.02em;
		max-width: 760px;
		color: var(--ink);
	}

	.notfound-h1-accent {
		font-style: italic;
		color: var(--accent-2);
	}

	.notfound-lead {
		margin: 22px 0 0;
		max-width: 560px;
		color: var(--text-muted);
		font-size: 16px;
		text-wrap: pretty;
	}

	.notfound-grid {
		display: grid;
		grid-template-columns: minmax(0, 620px) 300px;
		gap: 56px;
		margin-top: 38px;
		align-items: start;
	}

	.notfound-col {
		min-width: 0;
	}

	/* -- Requested panel (code-block-style container) -- */
	.requested-panel {
		border: 1px solid var(--hairline-10);
		border-radius: var(--radius-md);
		background: var(--surface-code);
		overflow: hidden;
	}

	.requested-panel-header {
		display: flex;
		align-items: center;
		padding: 8px 14px;
		border-bottom: 1px solid var(--hairline-08);
		font: 400 11px var(--font-mono);
		color: var(--text-dim);
	}

	.requested-panel-body {
		white-space: pre-wrap;
		margin: 0;
		padding: 14px 16px;
		font: 400 13px/1.8 var(--font-mono);
		color: var(--text-code);
	}

	.requested-panel-body .requested-line {
		display: block;
	}

	.requested-panel-body .dim {
		color: var(--text-dim);
	}

	.requested-panel-body .sage {
		color: var(--accent);
	}

	:global(.requested-highlight) {
		color: var(--accent-2);
	}

	/* -- DID YOU MEAN -- */
	.dym-label {
		font: 400 11.5px var(--font-mono);
		color: var(--text-dim);
		letter-spacing: 0.08em;
		margin: 32px 0 10px;
	}

	.dym-list {
		border: 1px solid var(--hairline-10);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	:global(.dym-row) {
		text-decoration: none;
		display: grid;
		grid-template-columns: 22px 1fr auto;
		gap: 14px;
		padding: 13px 16px;
		color: inherit;
	}

	:global(.dym-row + .dym-row) {
		border-top: 1px solid var(--hairline-06);
	}

	:global(.dym-row .dym-bullet) {
		color: var(--text-faint);
		font: 400 12px var(--font-mono);
	}

	:global(.dym-row .dym-title) {
		display: block;
		color: var(--text-body);
		margin-bottom: 3px;
	}

	:global(.dym-row .dym-path) {
		display: block;
		font-size: 12.5px;
		color: var(--text-muted);
	}

	:global(.dym-row .dym-enter) {
		font: 400 11px var(--font-mono);
		color: var(--text-dim);
	}

	:global(.dym-row--active) {
		background: var(--sage-tint-08);
		box-shadow: inset 2px 0 var(--accent);
	}

	:global(.dym-row--active .dym-bullet) {
		color: var(--accent);
	}

	:global(.dym-row--active .dym-title) {
		color: var(--ink);
	}

	/* -- CTA row -- */
	.notfound-cta {
		display: flex;
		gap: 14px;
		margin-top: 30px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font: 400 13px var(--font-mono);
		padding: 11px 18px;
		border-radius: var(--radius-md);
		cursor: pointer;
	}

	.btn-primary {
		color: var(--bg);
		background: var(--accent);
	}

	.btn-ghost {
		color: var(--text-muted);
		border: 1px solid var(--hairline-14);
		background: transparent;
	}

	.kbd {
		border: 1px solid var(--hairline-14);
		border-radius: var(--radius-sm);
		padding: 0 5px;
		margin-left: 6px;
		font-size: 11px;
	}

	/* -- Margin note -- */
	.margin-note {
		border-left: 2px solid var(--accent-2);
		padding: 2px 0 2px 14px;
		font: 400 12px/1.8 var(--font-mono);
		color: var(--amber-annotation);
	}

	.margin-note a {
		color: var(--accent-2);
	}

	@media (min-width: 1920px) {
		.notfound-main {
			padding: 96px 80px 104px;
		}

		.notfound-h1 {
			font-size: 62px;
		}
	}

	@media (max-width: 1023px) {
		.notfound-main {
			padding: 40px 20px 48px;
		}

		.notfound-h1 {
			font-size: 40px;
		}

		.notfound-grid {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.notfound-cta {
			flex-direction: column;
		}

		.btn {
			justify-content: center;
			min-height: 48px;
		}
	}
</style>
