{
  "name": "@bluecadet/docs",
  "version": "1.1.0",
  "description": "Turn any repo's colocated markdown docs into a branded static Astro site with near-zero config.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluecadet/docs.git",
    "directory": "packages/docs"
  },
  "author": {
    "name": "Bluecadet",
    "url": "https://bluecadet.com"
  },
  "bugs": {
    "url": "https://github.com/bluecadet/docs/issues"
  },
  "homepage": "https://github.com/bluecadet/docs#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bin": {
    "docs": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./package.json": "./package.json",
    "./components": "./app/src/components/index.ts"
  },
  "files": [
    "dist",
    "netlify",
    "app/astro.config.mjs",
    "app/src/content.config.ts",
    "app/src/pages",
    "app/src/layouts",
    "app/src/components",
    "app/src/lib",
    "app/src/styles",
    "app/src/scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "astro check --root app",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "prepack": "rm -rf dist && npm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@shikijs/transformers": "^4.4.2",
    "asciinema-player": "^3.17.0",
    "astro": "^7.1.6",
    "gray-matter": "^4.0.3",
    "hast-util-select": "^6.0.4",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^8.0.13",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=23"
  }
}
